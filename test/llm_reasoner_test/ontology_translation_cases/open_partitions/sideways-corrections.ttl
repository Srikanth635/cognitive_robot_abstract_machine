@prefix :     <http://www.ease-crc.org/ont/llm_reasoner/test/open-partitions/sideways-corrections#> .
@prefix hub:  <http://www.ease-crc.org/ont/llm_reasoner/test/open-partitions/hub#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# A module adding a direction to the hub's open value partition, without importing the other
# module that adds to it.

<http://www.ease-crc.org/ont/llm_reasoner/test/open-partitions/sideways-corrections> a owl:Ontology ;
    owl:imports <http://www.ease-crc.org/ont/llm_reasoner/test/open-partitions/hub> ;
    rdfs:comment "Corrections that move a choice to one side."@en .

:SidewaysCorrection a owl:Class ;
    rdfs:subClassOf hub:Correction ;
    rdfs:label "sideways correction"@en ;
    rdfs:comment "A correction that moves a choice to one side."@en .

:Sideways a owl:NamedIndividual , hub:Direction ; hub:changesAlong hub:Place ;
    rdfs:label "sideways"@en ;
    rdfs:comment "The choice moves to one side."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( hub:Increases hub:Decreases :Sideways ) ] .
