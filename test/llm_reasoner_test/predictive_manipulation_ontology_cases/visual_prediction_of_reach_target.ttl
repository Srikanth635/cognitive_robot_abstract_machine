@prefix case:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/case#> .
@prefix core:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/core#> .
@prefix pre:   <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/prehension#> .
@prefix pour:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/pouring#> .

# Vision is predicted to show the hand reaching its target pose, a sensory goal without a mechanical event.

case:prediction a core:SensoryEventPrediction ;
    core:hasModality core:Visual ;
    core:predictsEvent case:reach_done ;
    core:causedByEvent case:reach_done ;
    core:signalsSubgoal case:positioned .

case:reach_done a pre:ReachTargetReached .

case:positioned a core:Subgoal .
