@prefix case:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/case#> .
@prefix core:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/core#> .
@prefix pre:   <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/prehension#> .

# A grip force, which is a quantity, is also given a categorical value.

case:grip_force a pre:GripForceSetpoint ;
    core:hasParameterRange case:range ;
    core:hasCategoricalValue case:category .

case:range a core:MagnitudeRange .

case:category a core:CategoricalValue .
