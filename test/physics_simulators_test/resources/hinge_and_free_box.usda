#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "anchor" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
    }

    def Xform "arm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "box" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        float physics:mass = 1
        double3 xformOp:translate = (2, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "joints"
    {
        def PhysicsFixedJoint "anchor" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI"]
        )
        {
            rel physics:body1 = </World/anchor>
        }

        def PhysicsRevoluteJoint "hinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </World/anchor>
            rel physics:body1 = </World/arm>
            uniform token physics:axis = "Z"
            point3f physics:localPos0 = (0, 0, 1)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:damping = 1
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 10
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
        }
    }
}
