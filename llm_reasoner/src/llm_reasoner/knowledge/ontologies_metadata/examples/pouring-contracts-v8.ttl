    rdfs:label "Expected and supplied sensory evidence disagree under a separately specified comparison rule"@en .

ex:pourEffectConditionV8 a ac:ConditionSpecification ;
    rdfs:label "Source contents decrease while delivered and spilled amounts increase"@en .

ex:pourGeometryV8 a ns11:GeometrySpecification ;
    rdfs:label "Geometry unspecified"@en .

