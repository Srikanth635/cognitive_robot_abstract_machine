    <owl:onProperty rdf:resource="http://aicor.knowledge/l2-ontology.owl#isWhiteBox"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://aicor.knowledge/l2-ontology.owl#isShareableResearchObject">
