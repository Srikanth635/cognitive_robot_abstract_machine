  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#farFrom">
    <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#farFrom"/>
