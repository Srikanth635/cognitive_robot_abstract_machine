    <rdfs:subClassOf rdf:resource="http://aicor.knowledge/l2-ontology.owl#SpatialRelation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AlignedWith</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
