demo:spillAmount a ac:ParameterSpecification ;
    ac:numericValue 0.000001 ;
    ac:parameterKey "spill-amount" ;
    ac:unitIRI "http://qudt.org/vocab/unit/M3"^^xsd:anyURI .

demo:sourceBottle a ac:EntitySpecification ;
    rdfs:label "source container specification",
        "Example bottle"@en .

