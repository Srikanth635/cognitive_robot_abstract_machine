    ac:numericValue 0.000005 ;
    ac:parameterKey "spill-tolerance" ;
    ac:unitIRI "http://qudt.org/vocab/unit/M3"^^xsd:anyURI .

demo:targetAmount a ac:ParameterSpecification ;
    ac:numericValue 0.000250 ;
    ac:parameterKey "target-amount" ;
    ac:unitIRI "http://qudt.org/vocab/unit/M3"^^xsd:anyURI .

demo:pouringV2 a ac:ActionDescription ;
    ac:hasActionKind mt:Pouring ;
    ac:hasFailureCriterion demo:pourSpillFailure ;
    ac:hasGoal demo:pourAmountGoal ;
    ac:hasParameter demo:deliveredAmount,
        demo:spillAmount,
        demo:spillTolerance,
        demo:targetAmount ;
    ac:hasPrecondition demo:pourPrecondition ;
    ac:hasRoleSpecification demo:destinationRoleSpec,
        demo:sourceRoleSpec,
        demo:substanceRoleSpec ;
    ac:hasSuccessCriterion demo:pourAmountSuccess ;
    ns4:hasOutcome demo:pourOutcome ;
    ns2:hasRelationPattern demo:destinationAccessiblePattern,
        demo:sourceContainmentPattern .

demo:water a ac:EntitySpecification ;
    rdfs:label "transferable substance specification",
        "Example water portion"@en .

demo:pourTransfer a ac:PhaseSpecification ;
    rdfs:label "Transfer material"@en ;
    ns7:hasMonitoringRequirement demo:pourReadinessMonitor,
        demo:pourSpillMonitor ;
    ns5:exitCondition demo:pourReadyToVerify ;
    ns5:expectedOutcome demo:pourOutcome ;
    ns5:invariantCondition demo:pourSpillInvariant .

demo:destinationGlass a ac:EntitySpecification ;
    rdfs:label "receiving container specification",
        "Example drinking glass"@en .

demo:deliveredAmount a ac:ParameterSpecification ;
    rdfs:label "Amount delivered to destination"@en ;
