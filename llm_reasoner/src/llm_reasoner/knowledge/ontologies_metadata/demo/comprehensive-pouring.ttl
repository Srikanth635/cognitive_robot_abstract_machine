demo:pourAmountGoal a ac:GoalSpecification ;
    ns4:hasExpression demo:pourAmountExpression .

demo:pourCurrentSpillExpression a ns4:Comparison ;
    ns4:leftOperand demo:pourSpillCurrent ;
    ns4:operator ns4:GreaterThan ;
    ns4:rightOperand demo:toleranceContext .

demo:pourForcePattern a ns16:ForceDynamicDescription ;
    rdfs:label "Candidate qualitative opposition pattern"@en ;
    ns16:agonist demo:pourAgonist ;
    ns16:antagonist demo:pourAntagonist ;
    ns16:applicability demo:pourModelScope ;
    ns16:describedResult ns16:UnknownResult ;
    ns16:relativeStrength ns16:UnknownStrength .

demo:pourNoExcessSpillExpression a ns4:Negation ;
    ns4:hasOperand demo:pourCurrentSpillExpression .

demo:pourSuccessExpression a ns4:Conjunction ;
    ns4:hasOperand demo:acceptableSpillageExpression,
        demo:destinationPostCondition,
        demo:pourAmountExpression .

demo:spillFailureExpression a ns4:Comparison ;
    ns4:leftOperand demo:spillPost ;
    ns4:operator ns4:GreaterThan ;
    ns4:rightOperand demo:toleranceContext .

demo:spillHypothesisLink a ns14:CausalLink ;
    ns14:antecedent demo:pourSuspectedCause ;
    ns14:consequent demo:pourSpillFailure ;
    ns14:mechanism demo:spillMechanism .

demo:toolUseEffectPattern a ns2:RelationPattern ;
    ns2:hasArgumentBinding demo:toolUseEffectBinding1,
        demo:toolUseEffectBinding2 ;
    ns2:usesRelation ti:EffectObserved .

demo:toolUseFaultPattern a ns2:RelationPattern ;
    ns2:hasArgumentBinding demo:toolUseFaultBinding1,
        demo:toolUseFaultBinding2 ;
    ns2:usesRelation ti:ToolFault .

demo:toolUseHeldPattern a ns2:RelationPattern ;
    ns2:hasArgumentBinding demo:toolUseHeldBinding1,
        demo:toolUseHeldBinding2 ;
    ns2:usesRelation ti:ToolHeld .

demo:toolUseSuccessExpression a ns4:Conjunction ;
    ns4:hasOperand demo:toolUseEffectExpression,
        demo:toolUseFunctionalExpression,
        demo:toolUseHeldExpression .

demo:destinationAccessiblePattern a ns2:RelationPattern ;
    ns2:hasArgumentBinding demo:destinationAccessiblePatternBinding1 ;
    ns2:usesRelation ns2:Accessible .

demo:pourController a ns10:ControllerSpecification ;
    rdfs:label "Proposed controller specification; numerical settings unresolved"@en ;
    ns10:controllerKind ns10:FeedbackControl ;
    ns10:controlsModel demo:pourDynamics ;
    ns10:hasAdaptation demo:pourAdaptation ;
    ns10:objectiveSet demo:pourObjectives ;
    ns10:samplingPeriod demo:pourSamplingPeriod ;
    ns10:stateConstraint demo:pourSpillConstraint .

demo:pourFailureDescription a ns3:FailureSpecification ;
    ns3:detectedBy demo:pourSpillFailure ;
    ns3:failureKind ns3:Spillage .

demo:pourManipulationCapability a ac:CapabilityRequirement ;
    rdfs:label "Abstract material-transfer capability"@en .

demo:pourObjectives a ns13:ObjectiveSet ;
    ns13:aggregationPolicy ns13:Lexicographic ;
    ns13:hardConstraint demo:pourSpillConstraint ;
    ns13:hasTerm demo:pourObjective_spill,
        demo:pourObjective_time .

demo:pourOutcome a ns4:OutcomeSpecification ;
    ns4:afterCondition demo:pourAmountGoal ;
    ns4:beforeCondition demo:pourPrecondition .

demo:pourVerificationCapability a ac:CapabilityRequirement ;
    rdfs:label "Abstract outcome-verification capability"@en .

demo:robotEndEffector a ac:EntitySpecification .

demo:volumeAccountingContract a ns6:AdditiveEquationContract ;
    ns6:equation demo:pourVolumeEquation ;
    ns6:hasTerm demo:accountingTerm0,
        demo:accountingTerm1,
        demo:accountingTerm2 ;
    ns6:resultParameter demo:sourceAfter ;
    ns6:scope demo:pourModelScope .

demo:observe_quantity_spillAmount_CurrentState a ns7:QuantityObservation ;
    ns7:inScope ns4:CurrentState ;
    ns7:observesParameter demo:spillAmount ;
    ns7:requiresCapability demo:quantityEstimationCapability .

demo:observe_quantity_targetAmount_TaskContext a ns7:QuantityObservation ;
    ns7:inScope ns4:TaskContext ;
    ns7:observesParameter demo:targetAmount ;
    ns7:requiresCapability demo:quantityEstimationCapability .

demo:pourPropertyParameter a ac:ParameterSpecification ;
    ac:numericValue 998.0 ;
    ac:parameterKey "density" ;
    ac:unitIRI "http://qudt.org/vocab/unit/KiloGM-PER-M3"^^xsd:anyURI .

demo:pourSpillFailure a ac:FailureCriterion ;
    ns4:hasExpression demo:spillFailureExpression .

demo:pourSpillMonitor a ns7:MonitoringRequirement ;
    ns7:atPoint ns7:DuringPhase ;
    ns7:monitorsCondition demo:pourSpillInvariant ;
    ns7:requiresObservation demo:observe_quantity_spillAmount_CurrentState,
        demo:observe_quantity_spillTolerance_TaskContext ;
    ns7:whenFalse ns7:RequestSuspension ;
    ns7:whenTrue ns7:ReportSatisfied ;
    ns7:whenUnknown ns7:RequestEvidence .

demo:sourceAfter a ac:ParameterSpecification ;
    ac:numericValue 0.000347 ;
    ac:parameterKey "source-volume-after" ;
    ac:unitIRI "http://qudt.org/vocab/unit/M3"^^xsd:anyURI .

demo:sourceBefore a ac:ParameterSpecification ;
    ac:numericValue 0.000600 ;
    ac:parameterKey "source-volume-before" ;
    ac:unitIRI "http://qudt.org/vocab/unit/M3"^^xsd:anyURI .

demo:sourceContainmentPattern a ns2:RelationPattern ;
    ns2:hasArgumentBinding demo:sourceContainmentPatternBinding1,
        demo:sourceContainmentPatternBinding2 ;
    ns2:usesRelation ns2:ContainedIn .

demo:pourAbort a ns5:FailedTerminalPhase ;
    rdfs:label "Failed completion"@en .

demo:pourModelAssumption a ac:ConditionSpecification ;
    rdfs:label "Incompressible material; all source losses accounted as delivered or spilled volume."@en .

demo:pourRecoveryOption a ns3:RecoveryOption ;
    ns3:addressesFailure demo:pourFailureDescription ;
    ns3:guardedBy demo:pourRecoveryGuard ;
    ns3:requiresCapability demo:pourManipulationCapability ;
    ns3:restoresCondition demo:pourRecoveryGoal ;
    ns3:retryBudget demo:pourRetryBudget ;
    ns3:usesStrategy demo:pourRecoveryStrategy .

demo:pourVolumeEquation a ns1:ModelEquation ;
    ns1:expressionLanguage "mathematical-text" ;
    ns1:expressionText "V_after = V_before - V_delivered - V_spilled" ;
    ns1:usesVariable demo:pourVariable_V_after,
        demo:pourVariable_V_before,
        demo:pourVariable_V_delivered,
        demo:pourVariable_V_spilled .

demo:observe_quantity_spillTolerance_TaskContext a ns7:QuantityObservation ;
    ns7:inScope ns4:TaskContext ;
    ns7:observesParameter demo:spillTolerance ;
    ns7:requiresCapability demo:quantityEstimationCapability .

demo:pourPrepare a ac:PhaseSpecification ;
    rdfs:label "Prepare transfer"@en ;
    ns5:entryCondition demo:pourPrecondition .

demo:pourReadinessMonitor a ns7:MonitoringRequirement ;
    ns7:atPoint ns7:DuringPhase ;
    ns7:monitorsCondition demo:pourReadyToVerify ;
    ns7:requiresObservation demo:observe_quantity_deliveredAmount_CurrentState,
        demo:observe_quantity_spillAmount_CurrentState,
        demo:observe_quantity_spillTolerance_TaskContext,
        demo:observe_quantity_targetAmount_TaskContext ;
    ns7:whenFalse ns7:ReportUnsatisfied ;
    ns7:whenTrue ns7:ReportSatisfied ;
    ns7:whenUnknown ns7:RequestEvidence .

demo:pourTransitionMonitor a ns7:MonitoringRequirement ;
    ns7:atPoint ns7:TransitionCheck ;
    ns7:monitorsCondition demo:pourReadyToVerify ;
    ns7:requiresObservation demo:observe_quantity_deliveredAmount_CurrentState,
        demo:observe_quantity_spillAmount_CurrentState,
        demo:observe_quantity_spillTolerance_TaskContext,
        demo:observe_quantity_targetAmount_TaskContext ;
    ns7:whenFalse ns7:RequestEvidence ;
    ns7:whenTrue ns7:ReportSatisfied ;
    ns7:whenUnknown ns7:RequestEvidence .

demo:pourDynamics a ns10:DynamicalModelSpecification ;
    rdfs:label "Partial sampled-state description; evolution equation unspecified"@en ;
    ns10:describesPlant demo:pourPhysicalModel ;
    ns10:hasAssignment demo:pourInputAssignment,
        demo:pourOutputAssignment,
        demo:pourStateAssignment ;
    ns1:applicability demo:pourModelScope ;
    ns1:assumption demo:pourModelAssumption ;
    ns1:hasVariable demo:pourInputVariable,
        demo:pourVariable_V_delivered .

demo:pourTransferContract a ns18:TransferContract ;
    ns18:deliveredAmount demo:deliveredAmount ;
    ns18:destination demo:destinationGlass ;
    ns18:source demo:sourceBottle ;
    ns18:spillAmount demo:spillAmount ;
    ns18:spillTolerance demo:spillTolerance ;
    ns18:substance demo:water ;
    ns18:successCriterion demo:pourAmountSuccess ;
    ns18:targetAmount demo:targetAmount ;
    ns18:transferMode "partial"^^xsd:string ;
    ns18:transferredPortion demo:transferredWater .

demo:pourVariable_V_delivered a ns1:ModelVariable ;
    ns1:parameter demo:deliveredAmount ;
    ns1:symbol "V_delivered" .

demo:pourVerificationMonitor a ns7:MonitoringRequirement ;
    ns7:atPoint ns7:PhaseExit ;
    ns7:monitorsCondition demo:pourAmountSuccess ;
    ns7:requiresObservation demo:destinationObservation,
        demo:observe_quantity_deliveredAmount_PostState,
        demo:observe_quantity_spillAmount_PostState,
        demo:observe_quantity_spillTolerance_TaskContext,
        demo:observe_quantity_targetAmount_TaskContext ;
    ns7:whenFalse ns7:RequestSuspension ;
    ns7:whenTrue ns7:ReportSatisfied ;
    ns7:whenUnknown ns7:RequestEvidence .

demo:quantityEstimationCapability a ac:CapabilityRequirement .

demo:pourAmountSuccess a ac:SuccessCriterion ;
    ns4:hasExpression demo:pourSuccessExpression .

demo:pourPhysicalModel a ns1:PhysicalModelSpecification ;
    rdfs:label "Volume accounting model"@en ;
    ns1:applicability demo:pourModelScope ;
    ns1:assumption demo:pourModelAssumption ;
    ns1:hasEquation demo:pourVolumeEquation ;
    ns1:hasVariable demo:pourVariable_V_after,
        demo:pourVariable_V_before,
        demo:pourVariable_V_delivered,
        demo:pourVariable_V_spilled,
        demo:pourVariable_rho ;
    ns1:realizesMechanism demo:pourMechanism .

demo:pourPrecondition a ac:PreconditionSpecification ;
    ns4:hasExpression demo:pourPreExpression .

demo:pourReadyToVerify a ac:ConditionSpecification ;
    ns4:hasExpression demo:pourReadyExpression .

demo:pourModelScope a ac:ApplicabilitySpecification ;
    rdfs:label "Accounting boundary of the source, receiving container and spill; no evaporation, foam expansion or other streams."@en .

demo:pourPhaseStructure a ns5:PhaseStructure ;
    ns5:hasMemberPhase demo:pourAbort,
        demo:pourComplete,
        demo:pourPrepare,
        demo:pourTransfer,
        demo:pourVerify ;
    ns5:hasTransition demo:pourAdvanceToVerify,
        demo:pourBegin,
        demo:pourCannotBegin,
        demo:pourSpillAbort,
        demo:pourVerificationFailed,
        demo:pourVerified ;
    ns5:initialPhase demo:pourPrepare .

demo:pourVerify a ac:PhaseSpecification ;
    rdfs:label "Verify outcome"@en ;
    ns7:hasMonitoringRequirement demo:pourVerificationMonitor ;
    ns5:exitCondition demo:pourAmountSuccess .

