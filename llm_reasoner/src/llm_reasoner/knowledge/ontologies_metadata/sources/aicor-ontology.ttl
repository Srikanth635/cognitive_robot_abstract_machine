            owl:onProperty :hasStateEstimate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasLifecycleEvents ;
            owl:someValuesFrom :LifecycleEvent ],
        [ a owl:Restriction ;
            owl:onProperty :hasVerdictComponent ;
            owl:someValuesFrom :VerdictComponent ],
        [ a owl:Restriction ;
            owl:onClass :TaskRequest ;
            owl:onProperty :hasRequest ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :CommitmentRecord ;
            owl:onProperty :hasCommitmentRecord ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :TaskEnvironmentEmbodimentClass ;
            owl:onProperty :conformsToScope ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_Situation,
        owl:Thing ;
    owl:disjointWith :EvidenceBearingTrace,
        :ForceDynamicSchema,
        :Recording .

:ManipulationProblemClass a owl:Class ;
    rdfs:label "ManipulationProblemClass"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :MasteryCriterion ;
            owl:onProperty :hasMasteryCriterion ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasCriticSet ;
            owl:someValuesFrom :Critic ],
        [ a owl:Restriction ;
            owl:onProperty :specifiedBy ;
            owl:someValuesFrom :ProblemClassSpecificationTemplate ],
        [ a owl:Restriction ;
            owl:onClass :NuisanceModel ;
            owl:onProperty :hasNuisanceModel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :RWMSFamily ;
            owl:onProperty :hasRWMSFamily ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isRWMSComponent ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :ProblemDomain ],
        [ a owl:Restriction ;
            owl:onClass :TaskScope ;
            owl:onProperty :hasTaskScope ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isGenerator ],
        [ a owl:Restriction ;
            owl:onProperty :constrainsRung ;
            owl:someValuesFrom :SubstrateRung ],
        :AbstractEntity,
        :MetaLevelEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ProblemDomain .

:BodyWorldSystem a owl:Class ;
    rdfs:label "BodyWorldSystem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDeclaredBoundary ;
            owl:someValuesFrom :DeclaredBoundary ],
        [ a owl:Restriction ;
            owl:onProperty :hasProperPart ;
            owl:someValuesFrom :WorldPhysicalEntity ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :boundaryTaskRelative ],
        [ a owl:Restriction ;
            owl:onProperty :hasProperPart ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:onProperty :hasCoupling ;
            owl:someValuesFrom :ForceInteraction ],
        :CaseLevelEntity,
        :PhysicalEntity,
        :dul_PhysicalObject,
        owl:Thing .

:MetaLevelEntity a owl:Class ;
    rdfs:label "MetaLevelEntity"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :atCaseLevel ],
        :dul_Entity,
        owl:Thing .

:ManipulationExecutive a owl:Class ;
    rdfs:label "ManipulationExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :ActionToken ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isAccountable ],
        [ a owl:Restriction ;
            owl:onProperty :issues ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :WarrantedExecutiveCommitment :Abstention ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :controls ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :discharges ;
            owl:someValuesFrom :RepresentationalObligation ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_Agent,
        owl:Thing ;
    owl:disjointWith :ProposalMechanism .

:dul_InformationObject a owl:Class ;
    rdfs:label "dul:InformationObject"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:dul_Description a owl:Class ;
    rdfs:label "dul:Description"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:AbstractEntity a owl:Class ;
    rdfs:subClassOf :Entity .

[] a owl:AllDisjointClasses ;
    owl:members ( :UniqueReferent :CandidateSet :ReferentDistribution :Unresolved ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Descriptive :Deictic :Relational ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Structural :Generative :Coupling :Grounding :ProposalCommitment :Realization :CausalEffectiveness :PhysicalCausal :Recording :Evaluation :Support ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ForceClosure :Constraint :Process ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SceneNode :LocationRef :ActionRef :MotionRef :GraspRef :TrajectoryRef :ObservationRef :RepairCandidateRef ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Outcome :TerminalDisposition :ExecutiveAdequacy :Robustness :Recoverability :EvidentialSufficiency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SourceAndFamily :System :Executive :Task :EpisodeAndTrace :AssessmentAndClaim ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Revolute :Prismatic :Spherical :Continuous :Fixed ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :RoleSlot :ObjectRef :LocationRef :ActionRef :MotionRef :GraspRef :TrajectoryRef :ObservationRef :RepairCandidateRef ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :InitNuisance :ObjectNuisance :PhysicalNuisance :SensingNuisance :ActuationNuisance :LayoutNuisance :HumanNuisance :TaskNuisance :DisturbanceNuisance ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :solution :repaired :prohibited :nonachieving ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ForceClosure :Constraint :Process ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ControlCounterpart :MonitorCounterpart :DiagnosisCounterpart :RevisionCounterpart :EvidenceCounterpart ) .

