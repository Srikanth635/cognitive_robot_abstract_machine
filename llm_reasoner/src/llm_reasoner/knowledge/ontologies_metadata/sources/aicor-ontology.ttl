    rdfs:label "RepairOption"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Reparameterize a owl:Class ;
    rdfs:label "Reparameterize"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:RepresentationProcessCapabilityTriad a owl:Class ;
    rdfs:label "RepresentationProcessCapabilityTriad"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasRepresentation ;
            owl:someValuesFrom :ComputationalMedium ],
        [ a owl:Restriction ;
            owl:onProperty :yieldsCapability ;
            owl:someValuesFrom :ExecutiveCapability ],
        [ a owl:Restriction ;
            owl:onProperty :hasProcess ;
            owl:someValuesFrom :ComputationalProcess ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:RepresentationalObligation a owl:Class ;
    rdfs:label "RepresentationalObligation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :derivedFrom ;
            owl:someValuesFrom :ForceDynamicSchema ],
        [ a owl:Restriction ;
            owl:onProperty :scopedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :TaskScope :BodyWorldSystem ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :obligates ;
            owl:someValuesFrom :ManipulationExecutive ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ForceDynamicSchema,
        :dul_InformationObject .

:Represents a owl:Class ;
    rdfs:label "Represents"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ResearchInfrastructureLayer a owl:Class ;
    rdfs:label "ResearchInfrastructureLayer"^^xsd:string ;
    rdfs:subClassOf :dul_InformationObject,
        owl:Thing .

:ResolutionMode a owl:Class ;
    rdfs:label "ResolutionMode"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :Descriptive :Deictic :Relational ) ] .

:ResponsePolicy a owl:Class ;
    rdfs:label "ResponsePolicy"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

