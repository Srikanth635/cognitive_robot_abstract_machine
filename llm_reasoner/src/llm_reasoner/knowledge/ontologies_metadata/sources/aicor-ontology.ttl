@prefix : <http://aicor.knowledge/l2-ontology.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://aicor.knowledge/l2-ontology.owl> a owl:Ontology .

:AICORReferenceManipulationExecutive a owl:Class ;
    rdfs:label "AICORReferenceManipulationExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ManipulationExecutiveOperatingSystem ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationControlProgram ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isArchitectureNeutral ],
        :ManipulationExecutive,
        owl:Thing .

:AbstentionSignal a owl:Class ;
    rdfs:label "AbstentionSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:AccountabilityClaim a owl:Class ;
    rdfs:label "AccountabilityClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "accountable"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :AccountableImplementationStructure ],
        :CompetenceProperty,
        owl:Thing .

:Accounting a owl:Class ;
    rdfs:label "Accounting"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrecondition ;
            owl:someValuesFrom :Diagnosis ],
        :CognitiveCapability,
        owl:Thing .

:AchievementMiss a owl:Class ;
    rdfs:label "AchievementMiss"^^xsd:string ;
    rdfs:subClassOf :FailureReason,
        owl:Thing .

:ActionEventType a owl:Class ;
    rdfs:label "ActionEventType"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :EventType,
        owl:Thing .

:ActionReferent a owl:Class ;
    rdfs:label "ActionReferent"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:ActionRelatedForceCorridor a owl:Class ;
    rdfs:label "ActionRelatedForceCorridor"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedGrasp a owl:Class ;
    rdfs:label "ActionRelatedGrasp"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedMotion a owl:Class ;
    rdfs:label "ActionRelatedMotion"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedPlace a owl:Class ;
    rdfs:label "ActionRelatedPlace"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedPour a owl:Class ;
    rdfs:label "ActionRelatedPour"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionSufficiency a owl:Class ;
    rdfs:label "ActionSufficiency"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "action"^^xsd:string ;
            owl:onProperty :sufficiencyKind ],
        :SubstrateSufficiency,
        owl:Thing .

:ActiveStatus a owl:Class ;
    rdfs:label "ActiveStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "active"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TaskStatus,
        owl:Thing .

:Actuating a owl:Class ;
    rdfs:label "Actuating"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :ActionToken ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :ManipulationControlProgram ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :BodyMotion ],
        :ActingMechanism,
        owl:Thing .

:AdmissibleAction a owl:Class ;
    rdfs:label "AdmissibleAction"^^xsd:string ;
    rdfs:subClassOf :CandidateAction,
        owl:Thing .

:AnswerSubstitution a owl:Class ;
    rdfs:label "AnswerSubstitution"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasBinding ;
            owl:someValuesFrom :Binding ],
        [ a owl:Restriction ;
            owl:onProperty :answersQuery ;
            owl:someValuesFrom :EntityQuery ],
        :dul_InformationObject,
        owl:Thing .

:ApplicationCentricMicrotheory a owl:Class ;
    rdfs:label "ApplicationCentricMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "application"^^xsd:string ;
            owl:onProperty :microtheoryFocus ],
        [ a owl:Restriction ;
            owl:onProperty :focusesOn ;
            owl:someValuesFrom :ApplicationContext ],
        :BodyWorldProcessMicrotheory,
        owl:Thing .

:ArtifactCertification a owl:Class ;
    rdfs:label "ArtifactCertification"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasCertificationKind ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :certifiesArtifact ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :overProblemClass ;
            owl:someValuesFrom :ManipulationProblemClass ],
        :AbstractEntity,
        :Theorem,
        owl:Thing .

:Assessing a owl:Class ;
    rdfs:label "Assessing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :Verdict ],
        :EvidentialMechanism,
        owl:Thing .

:AssessmentEvent a owl:Class ;
    rdfs:label "AssessmentEvent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ManipulationCase ;
            owl:onProperty :assessesCase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :AssessmentRegime ;
            owl:onProperty :usesRegime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Verdict ;
            owl:onProperty :hasVerdict ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :MetaLevelEntity,
        owl:Thing .

:AttributeConstraint a owl:Class ;
    rdfs:label "AttributeConstraint"^^xsd:string ;
    rdfs:subClassOf :dul_InformationObject,
        owl:Thing .

:AuthoredStateChange a owl:Class ;
    rdfs:label "AuthoredStateChange"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :causedByPerform ;
            owl:someValuesFrom :PerformOccurrence ],
        :TaskRelevantStateChange,
        owl:Thing ;
    owl:disjointWith :DisturbanceStateChange .

:AwarenessClaim a owl:Class ;
    rdfs:label "AwarenessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "aware"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :ObservationFunction ],
        :CompetenceProperty,
        owl:Thing .

:BeliefStateSemanticDigitalTwin a owl:Class ;
    rdfs:label "BeliefStateSemanticDigitalTwin"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :representsForExecutive ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :representsSelectedAspectsOf ;
            owl:someValuesFrom :BodyWorldSystem ],
        :SemanticDigitalTwin,
        owl:Thing .

:BindingConfirmationFunction a owl:Class ;
    rdfs:label "BindingConfirmationFunction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "binding-confirmation"^^xsd:string ;
            owl:onProperty :functionCode ],
        [ a owl:Restriction ;
            owl:onProperty :confirms ;
            owl:someValuesFrom :RoleSlot ],
        [ a owl:Restriction ;
            owl:onProperty :surfaces ;
            owl:someValuesFrom :BindingLevelFailure ],
        :ObservationFunction,
        owl:Thing .

:BodyCentricMicrotheory a owl:Class ;
    rdfs:label "BodyCentricMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "body"^^xsd:string ;
            owl:onProperty :microtheoryFocus ],
        [ a owl:Restriction ;
            owl:onProperty :focusesOn ;
            owl:someValuesFrom :RobotBody ],
        :BodyWorldProcessMicrotheory,
        owl:Thing .

:BoundVariable a owl:Class ;
    rdfs:label "BoundVariable"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isBound ],
        :QueryVariable,
        owl:Thing ;
    owl:disjointWith :UnboundVariable .

:CapabilityAssertion a owl:Class ;
    rdfs:label "CapabilityAssertion"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :BodyWorldConstraint,
        owl:Thing .

:CapabilityClaim a owl:Class ;
    rdfs:label "CapabilityClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isUniversallyQuantified ],
        [ a owl:Restriction ;
            owl:onProperty :establishedBy ;
            owl:someValuesFrom :ObservedConditionsWarrant ],
        :ScopedClaim,
        owl:Thing .

:CausalAdmissibility a owl:Class ;
    rdfs:label "CausalAdmissibility"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :dul_Description,
        owl:Thing .

:CommitmentQuestion a owl:Class ;
    rdfs:label "CommitmentQuestion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "commitment"^^xsd:string ;
            owl:onProperty :principleTag ],
        :CompetenceQuestion,
        owl:Thing .

:CompetenceStandard a owl:Class ;
    rdfs:label "CompetenceStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "competence"^^xsd:string ;
            owl:onProperty :standardCode ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        :GlobalStandard,
        owl:Thing .

:CompletenessClaim a owl:Class ;
    rdfs:label "CompletenessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "complete"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :ManipulationProblemClass ],
        :CompetenceProperty,
        owl:Thing .

:CompletenessStandard a owl:Class ;
    rdfs:label "CompletenessStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "completeness"^^xsd:string ;
            owl:onProperty :standardCode ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        :GlobalStandard,
        owl:Thing .

:CompletionSignal a owl:Class ;
    rdfs:label "CompletionSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:ComponentCompetenceClaim a owl:Class ;
    rdfs:label "ComponentCompetenceClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :heldByComponent ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :ManipulationExecutive :ManipulationControlProgram ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :requiresDeclaredScope ;
            owl:someValuesFrom :ResponsibleClaimScope ],
        :CompetenceClaim,
        owl:Thing .

:ConceptFamilyEnum a owl:Class ;
    rdfs:label "ConceptFamilyEnum"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :SourceAndFamily :System :Executive :Task :EpisodeAndTrace :AssessmentAndClaim ) ] .

:ConstraintBasedControl a owl:Class ;
    rdfs:label "ConstraintBasedControl"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :solvesFor ;
            owl:someValuesFrom :ActuatorInput ],
        [ a owl:Restriction ;
            owl:onProperty :expressesTaskAs ;
            owl:someValuesFrom :ConstraintSet ],
        :AbstractEntity,
        :RobotControlLaw,
        owl:Thing .

:ConstraintExploitationPrinciple a owl:Class ;
    rdfs:label "ConstraintExploitationPrinciple"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :characterizesMethod ;
            owl:someValuesFrom :SolutionMethod ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:ControlRealizability a owl:Class ;
    rdfs:label "ControlRealizability"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :groundedInLayer ;
            owl:someValuesFrom :RealizationChain ],
        [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :rungLevel ],
        [ a owl:Restriction ;
            owl:onProperty :hasRungFailureMode ;
            owl:someValuesFrom :ControlBasisTooWeak ],
        :SubstrateRung,
        owl:Thing .

:CorrectnessClaim a owl:Class ;
    rdfs:label "CorrectnessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "correct"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        :CompetenceProperty,
        owl:Thing .

:CorrectnessStandard a owl:Class ;
    rdfs:label "CorrectnessStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "correctness"^^xsd:string ;
            owl:onProperty :standardCode ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        :GlobalStandard,
        owl:Thing .

:CouplingTerm a owl:Class ;
    rdfs:label "CouplingTerm"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasCouplingType ;
            owl:someValuesFrom :CouplingType ],
        :dul_Description,
        owl:Thing .

:CreatedStatus a owl:Class ;
    rdfs:label "CreatedStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "created"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TaskStatus,
        owl:Thing .

:CriterionRelative a owl:Class ;
    rdfs:label "CriterionRelative"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:DerivedCaseReconstruction a owl:Class ;
    rdfs:label "DerivedCaseReconstruction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :reconstructedByModel ;
            owl:someValuesFrom :DigitalBodyWorldSystem ],
        :EvidenceBearingTrace,
        owl:Thing .

:Disambiguating a owl:Class ;
    rdfs:label "Disambiguating"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :TaskRequest ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :TaskGrounding ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :ManipulationProblem ],
        :ActingMechanism,
        owl:Thing .

:Disjunction a owl:Class ;
    rdfs:label "Disjunction"^^xsd:string ;
    rdfs:subClassOf :QueryConnective,
        owl:Thing ;
    owl:disjointWith :Conjunction .

:Distribution a owl:Class ;
    rdfs:label "Distribution"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasSupport ;
            owl:someValuesFrom :CaseFamily ],
        :MetaLevelEntity,
        owl:Thing .

:DownstreamModel a owl:Class ;
    rdfs:label "DownstreamModel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :integratedInto ;
            owl:someValuesFrom :CommitmentRelevantStructure ],
        [ a owl:Restriction ;
            owl:onProperty :outputSupports ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Perception :Prediction :AffordanceEstimation :RiskEstimation :Monitoring :Diagnosis :Repair ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :carriesMetadata ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Type :Uncertainty :Source :Scope :CommitmentRelevance ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:EnvisionedTimeline a owl:Class ;
    rdfs:label "EnvisionedTimeline"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :translatedFrom ;
            owl:someValuesFrom :SimulationLog ],
        [ a owl:Restriction ;
            owl:onProperty :relativeToScenario ;
            owl:someValuesFrom :Scenario ],
        [ a owl:Restriction ;
            owl:onProperty :groundsPredicate ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :FluentType :EventType ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :producedByEnvisioning ;
            owl:someValuesFrom :Envisioning ],
        [ a owl:Restriction ;
            owl:onProperty :projectionOfBranch ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isGroundedInSimulation ],
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :SimulationLog .

:EpisodeClaim a owl:Class ;
    rdfs:label "EpisodeClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :claimsAboutEpisode ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :establishedBy ;
            owl:someValuesFrom :SingleCaseWarrant ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isUniversallyQuantified ],
        :ScopedClaim,
        owl:Thing .

:EvaporatedStatus a owl:Class ;
    rdfs:label "EvaporatedStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "evaporated"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TerminalStatus,
        owl:Thing .

:EvidenceQuestion a owl:Class ;
    rdfs:label "EvidenceQuestion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "evidence"^^xsd:string ;
            owl:onProperty :principleTag ],
        :CompetenceQuestion,
        owl:Thing .

:ExecutiveEstimate a owl:Class ;
    rdfs:label "ExecutiveEstimate"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Experiment a owl:Class ;
    rdfs:label "Experiment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :testsHypothesis ;
            owl:someValuesFrom :Hypothesis ],
        :AbstractEntity,
        :EpistemicObject,
        owl:Thing .

:FailedRequest a owl:Class ;
    rdfs:label "FailedRequest"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasFailureReason ;
            owl:someValuesFrom :FailureReason ],
        :RequestOutcome,
        owl:Thing ;
    owl:disjointWith :SolvedRequest .

:FailedStatus a owl:Class ;
    rdfs:label "FailedStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "failed"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TerminalStatus,
        owl:Thing .

:FailureSignal a owl:Class ;
    rdfs:label "FailureSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:FederationWarrantedCompetenceClaim a owl:Class ;
    rdfs:label "FederationWarrantedCompetenceClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :warrantedByPortableResult ;
            owl:someValuesFrom :PortableResult ],
        :CompetenceClaim,
        owl:Thing .

:FederationWideAssessment a owl:Class ;
    rdfs:label "FederationWideAssessment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :comparableUnder ;
            owl:someValuesFrom :ComparisonFrame ],
        :AssessmentRegime,
        owl:Thing .

:Force a owl:Class ;
    rdfs:label "Force"^^xsd:string ;
    rdfs:subClassOf :PhysicalEntity,
        owl:Thing .

:ForceCorridor a owl:Class ;
    rdfs:label "ForceCorridor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :lowerEdge ;
            owl:someValuesFrom :SlipEventType ],
        [ a owl:Restriction ;
            owl:onProperty :corridorOf ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :upperEdge ;
            owl:someValuesFrom :RuptureEventType ],
        :dul_Region,
        owl:Thing .

:FoundationModel a owl:Class ;
    rdfs:label "FoundationModel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :contributesAt ;
            owl:someValuesFrom :FoundationModelInsertionPoint ],
        [ a owl:Restriction ;
            owl:onProperty :emitsHypothesis ;
            owl:someValuesFrom :FoundationModelOutput ],
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :ManipulationExecutive .

:GrammarOfAction a owl:Class ;
    rdfs:label "GrammarOfAction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :composesSchema ;
            owl:someValuesFrom :ForceDynamicSchema ],
        [ a owl:Restriction ;
            owl:onProperty :constituentBoundedBy ;
            owl:someValuesFrom :ForceDynamicEvent ],
        [ a owl:Restriction ;
            owl:onProperty :hasDependency ;
            owl:someValuesFrom :ForceDynamicDependency ],
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ForceDynamicEvent .

:GroundedSchema a owl:Class ;
    rdfs:label "GroundedSchema"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:GroundingCommitment a owl:Class ;
    rdfs:label "GroundingCommitment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :constructedBy ;
            owl:someValuesFrom :TaskGrounding ],
        [ a owl:Restriction ;
            owl:onProperty :constrains ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Action :Evaluation ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :commitsThat ;
            owl:someValuesFrom :TaskComponent ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isRevisable ],
        [ a owl:Restriction ;
            owl:onProperty :collectedInto ;
            owl:someValuesFrom :GroundingRecord ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:HonestyProperty a owl:Class ;
    rdfs:label "HonestyProperty"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :ExecutiveProperty,
        owl:Thing .

:HumanReadableAndMachineInterpretable a owl:Class ;
    rdfs:label "HumanReadableAndMachineInterpretable"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:IncapabilityAssertion a owl:Class ;
    rdfs:label "IncapabilityAssertion"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :BodyWorldConstraint,
        owl:Thing .

:InformationalAvailability a owl:Class ;
    rdfs:label "InformationalAvailability"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 3 ;
            owl:onProperty :rungLevel ],
        [ a owl:Restriction ;
            owl:onProperty :groundedInLayer ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :hasRungFailureMode ;
            owl:someValuesFrom :SignalUnavailable ],
        :SubstrateRung,
        owl:Thing .

:InformationalSufficiency a owl:Class ;
    rdfs:label "InformationalSufficiency"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "informational"^^xsd:string ;
            owl:onProperty :sufficiencyKind ],
        :SubstrateSufficiency,
        owl:Thing .

:IntervalTemporalLogic a owl:Class ;
    rdfs:label "IntervalTemporalLogic"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :reifies ;
            owl:someValuesFrom :ReifiedTemporalEntity ],
        [ a owl:Restriction ;
            owl:onProperty :hasPredicate ;
            owl:someValuesFrom :TemporalPredicate ],
        [ a owl:Restriction ;
            owl:onProperty :reasonsOver ;
            owl:someValuesFrom :Chronicle ],
        :AbstractEntity,
        :dul_InformationObject,
