    rdfs:label "RiskEstimation"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:RobotSimulator a owl:Class ;
    rdfs:label "RobotSimulator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :realizes ;
            owl:someValuesFrom :DigitalBodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :functionsAs ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :SemanticDigitalTwin :DigitalResearchLaboratory :DataGenerationEngine ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :hasPart ;
            owl:someValuesFrom :PhysicsEngine ],
        [ a owl:Restriction ;
            owl:onProperty :hasScopeCard ;
            owl:someValuesFrom :ScopeCard ],
        [ a owl:Restriction ;
            owl:onProperty :hasPart ;
            owl:someValuesFrom :Renderer ],
        [ a owl:Restriction ;
            owl:onProperty :loads ;
            owl:someValuesFrom :SceneDescription ],
        :AbstractEntity,
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :ManipulationExecutive .

