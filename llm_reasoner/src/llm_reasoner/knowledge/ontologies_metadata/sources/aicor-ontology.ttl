    rdfs:subClassOf owl:Thing .

:ProposalNotCommitment a owl:Class ;
    rdfs:label "ProposalNotCommitment"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ProposalToCommitmentPipeline a owl:Class ;
    rdfs:label "ProposalToCommitmentPipeline"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :pipelineOf ;
            owl:someValuesFrom :DualProcessManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :operationalizes ;
            owl:someValuesFrom :ProposalNotCommitment ],
        [ a owl:Restriction ;
            owl:onProperty :hasStage ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Generate :Translate :Ground :Check :Commit :Monitor :Repair :Record ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:Prospection a owl:Class ;
    rdfs:label "Prospection"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrecondition ;
            owl:someValuesFrom :CausalPrediction ],
        :CognitiveCapability,
        owl:Thing .

:QualityFunctional a owl:Class ;
    rdfs:label "QualityFunctional"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:QueryInterfaceOperation a owl:Class ;
    rdfs:label "QueryInterfaceOperation"^^xsd:string ;
    rdfs:subClassOf :dul_Action,
        owl:Thing .

:RealizationForm a owl:Class ;
    rdfs:label "RealizationForm"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:RealizationInterface a owl:Class ;
    rdfs:label "RealizationInterface"^^xsd:string ;
    rdfs:subClassOf :dul_Description,
        owl:Thing .

:Reasoner a owl:Class ;
    rdfs:label "Reasoner"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:RecedingHorizon a owl:Class ;
    rdfs:label "RecedingHorizon"^^xsd:string ;
    rdfs:subClassOf :dul_Region,
        owl:Thing ;
    owl:disjointWith :InstantaneousHorizon .

:Record a owl:Class ;
    rdfs:label "Record"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Recoverable a owl:Class ;
    rdfs:label "Recoverable"^^xsd:string ;
    rdfs:subClassOf :EdgeReversibility,
        owl:Thing ;
    owl:disjointWith :Irreversible .

:ReflectiveRequirement a owl:Class ;
    rdfs:label "ReflectiveRequirement"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :halfOf ;
            owl:someValuesFrom :BWSRelativeTaskSpecification ],
        [ a owl:Restriction ;
            owl:onProperty :constrains ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :ResponsibleNonAccomplishment ],
        [ a owl:Restriction ;
            owl:onProperty :requires ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Grounding :FeasibilityAssessment :SafetyAssessment :MonitorAttachment :Diagnosis :Repair :Abstention :HelpRequest :TraceRecording ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ObjectLevelRequirement .

:RelationEdge a owl:Class ;
    rdfs:label "RelationEdge"^^xsd:string ;
    rdfs:subClassOf :dul_Relation,
        owl:Thing .

:RelationFamily a owl:Class ;
    rdfs:label "RelationFamily"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :Structural :Generative :Coupling :Grounding :ProposalCommitment :Realization :CausalEffectiveness :PhysicalCausal :Recording :Evaluation :Support ) ] .

:RelationalGrammar a owl:Class ;
    rdfs:label "RelationalGrammar"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasRelationFamily ;
            owl:someValuesFrom :RelationFamily ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :OperationalGrammar ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:RenderingInterface a owl:Class ;
    rdfs:label "RenderingInterface"^^xsd:string ;
    rdfs:subClassOf :dul_Description,
        owl:Thing .

