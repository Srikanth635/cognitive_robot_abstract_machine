:BehaviorCritic a owl:Class ;
    rdfs:label "BehaviorCritic"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :examines ;
            owl:someValuesFrom :ExecutionScenario ],
        :ComputationalProcess,
        :dul_Description,
        owl:Thing .

