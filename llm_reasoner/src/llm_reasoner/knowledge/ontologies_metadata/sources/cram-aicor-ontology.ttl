:dul_Quality a owl:Class ;
    rdfs:label "dul:Quality"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:hasParticipantRole a owl:ObjectProperty .

:readsAspect a owl:ObjectProperty .

:resolvesTo a owl:ObjectProperty .

:CompetenceProperty a owl:Class ;
    rdfs:label "CompetenceProperty"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :conditionedOn ;
            owl:someValuesFrom :SubstrateSufficiency ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :dul_Entity ],
        :CompetenceClaim,
        owl:Thing ;
    owl:disjointWith :NecessityClaim,
        :SolvabilityClaim .

:ComputationalMedium a owl:Class ;
    rdfs:label "ComputationalMedium"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :realizesVia ;
            owl:someValuesFrom :RepresentationProcessCapabilityTriad ],
        [ a owl:Restriction ;
            owl:onProperty :characterizedBy ;
            owl:someValuesFrom :AccountableImplementationStructure ],
        [ a owl:Restriction ;
            owl:onProperty :makesAvailable ;
            owl:someValuesFrom :ManipulationAspect ],
        :AbstractEntity,
        :dul_InformationObject,
        owl:Thing .

:ExecutiveCapability a owl:Class ;
    rdfs:label "ExecutiveCapability"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :determinedBy ;
            owl:someValuesFrom :CapabilityInteraction ],
        [ a owl:Restriction ;
            owl:onProperty :determinesPerformanceOn ;
            owl:someValuesFrom :ManipulationProblem ],
        [ a owl:Restriction ;
            owl:onProperty :determinedBy ;
            owl:someValuesFrom :ComponentCapability ],
        [ a owl:Restriction ;
            owl:onProperty :determinedBy ;
            owl:someValuesFrom :ExecutiveComponent ],
        :dul_Quality,
        owl:Thing .

:RoleSlot a owl:Class ;
    rdfs:label "RoleSlot"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :physicallyTypedBy ;
            owl:someValuesFrom :MaterialProperty ],
        :dul_Concept,
        owl:Thing .

:SpatialRelation a owl:Class ;
    rdfs:label "SpatialRelation"^^xsd:string ;
    rdfs:subClassOf :Representation,
        owl:Thing .

:hasPrecondition a owl:ObjectProperty,
        owl:TransitiveProperty .

:mechanismRealizedBy a owl:ObjectProperty .

:CognitiveCapability a owl:Class ;
    rdfs:label "CognitiveCapability"^^xsd:string ;
    rdfs:subClassOf :ExecutiveCapability,
        owl:Thing ;
    owl:disjointWith :CompetenceQuestion .

:ManipulationActionCategory a owl:Class ;
    rdfs:label "ManipulationActionCategory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasCausalStructure ;
            owl:someValuesFrom :ForceDynamicTemplate ],
        [ a owl:Restriction ;
            owl:onProperty :hasIntentionalStructure ;
            owl:someValuesFrom :IntentionalStructure ],
        :GeneralizedActionPlan,
        owl:Thing .

:ManipulationControlProgram a owl:Class ;
    rdfs:label "ManipulationControlProgram"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :consumes ;
            owl:someValuesFrom :Percept ],
        [ a owl:Restriction ;
            owl:onProperty :emits ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :ActionToken :ObservationRequest :Repair ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :realizedAs ;
            owl:someValuesFrom :RealizationForm ],
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ManipulationExecutiveOperatingSystem .

:SemanticDigitalTwin a owl:Class ;
    rdfs:label "SemanticDigitalTwin"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isGroundTruth ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isBeliefState ],
        [ a owl:Restriction ;
            owl:onProperty :supportsOperation ;
            owl:someValuesFrom :QueryInterfaceOperation ],
        [ a owl:Restriction ;
            owl:onProperty :isAbout ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :hasNodeStructure ;
            owl:someValuesFrom :HierarchicalSceneStructure ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :ManipulationEpisode .

:dul_Entity a owl:Class ;
    rdfs:label "dul:Entity"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:mechanismInput a owl:ObjectProperty .

:mechanismOutput a owl:ObjectProperty .

:ActionToken a owl:Class ;
    rdfs:label "ActionToken"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:BodyWorldProcessMicrotheory a owl:Class ;
    rdfs:label "BodyWorldProcessMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :resourceFor ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :hasTemplate ;
            owl:someValuesFrom :MicrotheoryTemplate ],
        [ a owl:Restriction ;
            owl:onProperty :interpretsVia ;
            owl:someValuesFrom :ProcessInterpretation ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isScoped ],
        [ a owl:Restriction ;
            owl:onProperty :hasScopeCondition ;
            owl:someValuesFrom :ScopeCondition ],
        [ a owl:Restriction ;
            owl:onProperty :formalizedBy ;
            owl:someValuesFrom :ProbabilisticHybridProcessModel ],
        [ a owl:Restriction ;
            owl:onProperty :meets ;
            owl:someValuesFrom :OperationalizationCriterion ],
        :AbstractEntity,
        :WorldStructureModel,
        :dul_Description,
        owl:Thing .

:Critic a owl:Class ;
    rdfs:label "Critic"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :yieldsVerdict ;
            owl:someValuesFrom :Verdict ],
        :ComputationalProcess,
        owl:Thing .

:FluentType a owl:Class ;
    rdfs:label "FluentType"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :holdsOver ;
            owl:someValuesFrom :TimeInterval ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :homogeneous ],
        :AbstractEntity,
        :ReifiedTemporalEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :Chronicle,
        :EventType,
        :Occurrence,
        :TimeInterval .

:ForceDynamicSchema a owl:Class ;
    rdfs:label "ForceDynamicSchema"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :appliesTo ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :definesConditionOn ;
            owl:someValuesFrom :ForceDynamicEvent ],
        [ a owl:Restriction ;
            owl:onProperty :hasRoleSlot ;
            owl:someValuesFrom :RoleSlot ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isEventDescription ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ManipulationEpisode .

:Repair a owl:Class ;
    rdfs:label "Repair"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :transforms ;
            owl:someValuesFrom :WarrantedExecutiveCommitment ],
        [ a owl:Restriction ;
            owl:onProperty :accountableVia ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:onProperty :respondsTo ;
            owl:someValuesFrom :FailureSignature ],
        [ a owl:Restriction ;
            owl:onProperty :hasForm ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Reparameterize :AddSupport :InstantiateMonitor :SwitchMode :RequestHelp :WithdrawAndAbstain ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:Task a owl:Class ;
    rdfs:label "Task"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasStatus ;
            owl:someValuesFrom :Fluent ],
        :Representation,
        :dul_Description,
        owl:Thing .

:constrains a owl:ObjectProperty .

:RobotBody a owl:Class ;
    rdfs:label "RobotBody"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasLink ;
            owl:someValuesFrom :Link ],
        [ a owl:Restriction ;
            owl:onProperty :hasEndEffector ;
            owl:someValuesFrom :EndEffector ],
        [ a owl:Restriction ;
            owl:onProperty :hasJoint ;
            owl:someValuesFrom :Joint ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :BodyMotion ],
        [ a owl:Restriction ;
            owl:onProperty :hasSensor ;
            owl:someValuesFrom :Sensor ],
        :ArticulatedObject,
        :PhysicalEntity,
        owl:Thing ;
    owl:disjointWith :WorldPhysicalEntity .

:ScientificObject a owl:Class ;
    rdfs:label "ScientificObject"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :studiedBy ;
            owl:someValuesFrom :ScienceDiscipline ],
        [ a owl:Restriction ;
            owl:onProperty :aboutReferent ;
            owl:someValuesFrom :dul_Entity ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:dul_Region a owl:Class ;
    rdfs:label "dul:Region"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:statusCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

:CaseLevelEntity a owl:Class ;
    rdfs:label "CaseLevelEntity"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :atCaseLevel ],
        :dul_Entity,
        owl:Thing ;
    owl:disjointWith :MetaLevelEntity .

:CompetenceClaim a owl:Class ;
    rdfs:label "CompetenceClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "competence"^^xsd:string ;
            owl:onProperty :claimScope ],
        [ a owl:Restriction ;
            owl:onProperty :hasScope ;
            owl:someValuesFrom :CaseFamily ],
        [ a owl:Restriction ;
            owl:onProperty :warrantedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :EvidenceBearingTrace :VerdictComponent ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :isRateBearing ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty :atDegree ;
            owl:someValuesFrom :CompetenceDegree ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isUniversallyQuantified ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isDispositional ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationProblemClass ;
            owl:onProperty :claimsOver ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :establishedBy ;
            owl:someValuesFrom :FamilyRangingWarrant ],
        [ a owl:Restriction ;
            owl:onProperty :heldBy ;
            owl:someValuesFrom :RobotWorldManipulationSystem ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :licensedBySingleEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :assertsStandard ;
            owl:someValuesFrom :GlobalStandard ],
        :MetaLevelEntity,
        :ScopedClaim,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :VerdictComponent .

:GenerativeModel a owl:Class ;
    rdfs:label "GenerativeModel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mapsOutcomeTo ;
            owl:someValuesFrom :MotionPlan ],
        [ a owl:Restriction ;
            owl:onProperty :hasVariant ;
            owl:someValuesFrom :ProbabilisticHybridActionModel ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :realizedByKRR ],
        [ a owl:Restriction ;
            owl:onProperty :hasVariant ;
            owl:someValuesFrom :ActionRelatedPlaceModel ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isJointDistribution ],
        [ a owl:Restriction ;
            owl:onProperty :hasVariant ;
            owl:someValuesFrom :LearningLoop ],
        [ a owl:Restriction ;
            owl:onProperty :maximizes ;
            owl:someValuesFrom :SuccessSignal ],
        [ a owl:Restriction ;
            owl:onProperty :hasVariant ;
            owl:someValuesFrom :Projection ],
        :GenerativeDependencyStructure,
        :Representation,
        owl:Thing .

:CRAMDesignator a owl:Class ;
    rdfs:label "CRAMDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isImmutable ],
        [ a owl:Restriction ;
            owl:onProperty :hasResolution ;
            owl:someValuesFrom :DesignatorResolution ],
        [ a owl:Restriction ;
            owl:onClass :DesignatorTarget ;
            owl:onProperty :references ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasPart ;
            owl:someValuesFrom :DesignatorConstraintSet ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :DesignatorReferent ;
            owl:onProperty :boundTo ],
        :Designator,
        :Representation,
        owl:Thing .

:ForceDynamicEvent a owl:Class ;
    rdfs:label "ForceDynamicEvent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :betweenRoleFillers ;
            owl:someValuesFrom :RoleSlot ],
        [ a owl:Restriction ;
            owl:onProperty :involvesContact ;
            owl:someValuesFrom :PhysicalContact ],
        [ a owl:Restriction ;
            owl:onProperty :isTransitionOf ;
            owl:someValuesFrom :HybridBodyWorldState ],
        [ a owl:Restriction ;
            owl:onProperty :hasForceProfile ;
            owl:someValuesFrom :ForceProfile ],
        :Representation,
        :dul_Event,
        owl:Thing ;
    owl:disjointWith :ForceDynamicSchema .

:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEnd ;
            owl:someValuesFrom :TimeInstant ],
        [ a owl:Restriction ;
            owl:onProperty :hasStart ;
            owl:someValuesFrom :TimeInstant ],
        :AbstractEntity,
        :dul_Region,
        owl:Thing ;
    owl:disjointWith :Chronicle,
        :EventType,
        :FluentType,
        :Occasion,
        :Occurrence .

:PlanTransformation a owl:Class ;
    rdfs:label "PlanTransformation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :firedBy ;
            owl:someValuesFrom :Bug ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isInterruptible ],
        [ a owl:Restriction ;
            owl:onProperty :transforms ;
            owl:someValuesFrom :StructuredReactivePlan ],
        [ a owl:Restriction ;
            owl:onProperty :edits ;
            owl:someValuesFrom :CodeTree ],
        :ComputationalProcess,
        :dul_Description,
        owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :CodeReplace ) ] .

:produces a owl:ObjectProperty .

:EvidenceBearingTrace a owl:Class ;
    rdfs:label "EvidenceBearingTrace"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isRawLog ],
        [ a owl:Restriction ;
            owl:onProperty :interprets ;
            owl:someValuesFrom :Recording ],
        [ a owl:Restriction ;
            owl:onProperty :partOfScientificObject ;
            owl:someValuesFrom :ScientificObject ],
        [ a owl:Restriction ;
            owl:onProperty :records ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isCriticRelative ],
        [ a owl:Restriction ;
            owl:onProperty :relativeTo ;
            owl:someValuesFrom :AssessmentRegime ],
        :CaseLevelEntity,
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :ManipulationEpisode,
        :Recording .

:PhysicalEntity a owl:Class ;
    rdfs:subClassOf :Entity ;
    owl:disjointWith :AbstractEntity .

:dul_PhysicalObject a owl:Class ;
    rdfs:label "dul:PhysicalObject"^^xsd:string ;
    rdfs:subClassOf :PhysicalEntity,
        owl:Thing .

:partOf a owl:ObjectProperty,
        owl:TransitiveProperty .

:EventType a owl:Class ;
    rdfs:label "EventType"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :occursOver ;
            owl:someValuesFrom :TimeInterval ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :homogeneous ],
        :AbstractEntity,
        :ReifiedTemporalEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :Chronicle,
        :FluentType,
        :Occasion,
        :TimeInterval .

:ManipulationProblemClass a owl:Class ;
    rdfs:label "ManipulationProblemClass"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :RWMSFamily ;
            owl:onProperty :hasRWMSFamily ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasCriticSet ;
            owl:someValuesFrom :Critic ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isGenerator ],
        [ a owl:Restriction ;
            owl:onClass :MasteryCriterion ;
            owl:onProperty :hasMasteryCriterion ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :constrainsRung ;
            owl:someValuesFrom :SubstrateRung ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :ProblemDomain ],
        [ a owl:Restriction ;
            owl:onProperty :specifiedBy ;
            owl:someValuesFrom :ProblemClassSpecificationTemplate ],
        [ a owl:Restriction ;
            owl:onClass :NuisanceModel ;
            owl:onProperty :hasNuisanceModel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :TaskScope ;
            owl:onProperty :hasTaskScope ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isRWMSComponent ],
        :AbstractEntity,
        :MetaLevelEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ProblemDomain .

:hasPart a owl:ObjectProperty .

:MetaLevelEntity a owl:Class ;
    rdfs:label "MetaLevelEntity"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :atCaseLevel ],
        :dul_Entity,
        owl:Thing .

:ManipulationProblem a owl:Class ;
    rdfs:label "ManipulationProblem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :BodyWorldSystem ;
            owl:onProperty :relativeTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isGrounded ],
        [ a owl:Restriction ;
            owl:onProperty :assignsClass ;
            owl:someValuesFrom :TaskRelativeClass ],
        [ a owl:Restriction ;
            owl:onProperty :classifies ;
            owl:someValuesFrom :BodyWorldTrajectory ],
        [ a owl:Restriction ;
            owl:onProperty :hasGoal ;
            owl:someValuesFrom :Goal ],
        :CaseLevelEntity,
        :dul_Description,
        owl:Thing .

:ManipulationEpisode a owl:Class ;
    rdfs:label "ManipulationEpisode"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :CommitmentRecord ;
            owl:onProperty :hasCommitmentRecord ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isBounded ],
        [ a owl:Restriction ;
            owl:onProperty :hasTrace ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isHierarchical ],
        [ a owl:Restriction ;
            owl:onClass :BodyWorldTrajectory ;
            owl:onProperty :hasPhysicalCore ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasVerdictComponent ;
            owl:someValuesFrom :VerdictComponent ],
        [ a owl:Restriction ;
            owl:onProperty :isRunOf ;
            owl:someValuesFrom :RobotWorldManipulationSystem ],
        [ a owl:Restriction ;
            owl:onClass :Recording ;
            owl:onProperty :hasRecording ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ForceDynamicSchema ;
            owl:onProperty :satisfies ;
            owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :TaskReading ;
            owl:onProperty :hasTaskReading ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :TerminalDisposition ;
            owl:onProperty :hasTerminalDisposition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :StateEstimate ;
            owl:onProperty :hasStateEstimate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :TaskRequest ;
            owl:onProperty :hasRequest ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :TaskEnvironmentEmbodimentClass ;
            owl:onProperty :conformsToScope ],
        [ a owl:Restriction ;
            owl:onProperty :hasLifecycleEvents ;
            owl:someValuesFrom :LifecycleEvent ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_Situation,
        owl:Thing ;
    owl:disjointWith :EvidenceBearingTrace,
        :ForceDynamicSchema,
        :Recording .

:BodyWorldSystem a owl:Class ;
    rdfs:label "BodyWorldSystem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :boundaryTaskRelative ],
        [ a owl:Restriction ;
            owl:onProperty :hasProperPart ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:onProperty :hasCoupling ;
            owl:someValuesFrom :ForceInteraction ],
        [ a owl:Restriction ;
            owl:onProperty :hasProperPart ;
            owl:someValuesFrom :WorldPhysicalEntity ],
        [ a owl:Restriction ;
            owl:onProperty :hasDeclaredBoundary ;
            owl:someValuesFrom :DeclaredBoundary ],
        :CaseLevelEntity,
        :PhysicalEntity,
        :dul_PhysicalObject,
        owl:Thing .

:ManipulationExecutive a owl:Class ;
    rdfs:label "ManipulationExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :issues ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :WarrantedExecutiveCommitment :Abstention ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :controls ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isAccountable ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :ActionToken ],
        [ a owl:Restriction ;
            owl:onProperty :discharges ;
            owl:someValuesFrom :RepresentationalObligation ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_Agent,
        owl:Thing ;
    owl:disjointWith :ProposalMechanism .

:ComputationalProcess a owl:Class ;
    rdfs:label "ComputationalProcess"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :operatesOn ;
            owl:someValuesFrom :Representation ],
        :dul_Process,
        owl:Thing .

:dul_InformationObject a owl:Class ;
    rdfs:label "dul:InformationObject"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:Representation a owl:Class ;
    rdfs:label "Representation"^^xsd:string ;
    rdfs:subClassOf :ComputationalMedium,
        owl:Thing ;
    owl:disjointWith :ComputationalProcess .

:AbstractEntity a owl:Class ;
    rdfs:subClassOf :Entity .

:dul_Description a owl:Class ;
    rdfs:label "dul:Description"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
