:AccountabilityQuestion a owl:Class ;
    rdfs:label "AccountabilityQuestion"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:AccountableImplementationStructure a owl:Class ;
    rdfs:label "AccountableImplementationStructure"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :characterizes ;
            owl:someValuesFrom :ComputationalMedium ],
        [ a owl:Restriction ;
            owl:onProperty :answersQuestion ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Represents :GroundedBy :SupportsReasoning :AffectsExecution :ContributesTraceEvidence ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:AccumulatedState a owl:Class ;
    rdfs:label "AccumulatedState"^^xsd:string ;
    rdfs:subClassOf :ForceDynamicState,
        owl:Thing .

:ActionEventType a owl:Class ;
    rdfs:label "ActionEventType"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :EventType,
        owl:Thing .

:ActionManifold a owl:Class ;
    rdfs:label "ActionManifold"^^xsd:string ;
    rdfs:subClassOf :Representation,
        owl:Thing .

:ActionRelatedPlace a owl:Class ;
    rdfs:label "ActionRelatedPlace"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedPlaceModel a owl:Class ;
    rdfs:label "ActionRelatedPlaceModel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :predictsSuccess ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :GenerativeModel ],
        [ a owl:Restriction ;
            owl:onProperty :computedFrom ;
            owl:someValuesFrom :GeneralizedSuccessModel ],
        :ActionRelatedPlace,
        :Representation,
        owl:Thing .

:ActivityUnderstanding a owl:Class ;
    rdfs:label "ActivityUnderstanding"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :yieldsDesignator ;
            owl:someValuesFrom :Designator ],
        [ a owl:Restriction ;
            owl:onProperty :producesEpisode ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :validatedBy ;
            owl:someValuesFrom :PhysicsEngine ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :physicsValidated ],
        [ a owl:Restriction ;
            owl:onProperty :perceives ;
            owl:someValuesFrom :HumanActivityObservation ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :fromVideo ],
        [ a owl:Restriction ;
            owl:onProperty :reconstructsPhase ;
            owl:someValuesFrom :ManipulationPhase ],
        :ComputationalProcess,
        :dul_Description,
        owl:Thing .

:ActuationNuisance a owl:Class ;
    rdfs:label "ActuationNuisance"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:AgentRole a owl:Class ;
    rdfs:label "AgentRole"^^xsd:string ;
    rdfs:subClassOf :ParticipantRole,
        owl:Thing .

:Arrangement a owl:Class ;
    rdfs:label "Arrangement"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :servesActivity ;
            owl:someValuesFrom :HouseholdActivity ],
        [ a owl:Restriction ;
            owl:onProperty :requiresRelation ;
            owl:someValuesFrom :SpatialRelation ],
        [ a owl:Restriction ;
            owl:onProperty :hasArrangementRole ;
            owl:someValuesFrom :ArrangementRole ],
        :Representation,
        owl:Thing .

:AssessmentAndClaim a owl:Class ;
    rdfs:label "AssessmentAndClaim"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

