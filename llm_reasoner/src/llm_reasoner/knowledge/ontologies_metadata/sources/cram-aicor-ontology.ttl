@prefix : <http://aicor.knowledge/l2-ontology.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://aicor.knowledge/l2-ontology.owl> a owl:Ontology .

:AICORReferenceManipulationExecutive a owl:Class ;
    rdfs:label "AICORReferenceManipulationExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ManipulationExecutiveOperatingSystem ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationControlProgram ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isArchitectureNeutral ],
        :ManipulationExecutive,
        owl:Thing .

:AbstentionSignal a owl:Class ;
    rdfs:label "AbstentionSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:AccessibilityCritic a owl:Class ;
    rdfs:label "AccessibilityCritic"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "accessibility"^^xsd:string ;
            owl:onProperty :criticDimension ],
        :Critic,
        owl:Thing .

:AccessibleFrom a owl:Class ;
    rdfs:label "AccessibleFrom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "accessible_from"^^xsd:string ;
            owl:onProperty :relationKind ],
        :SpatialRelation,
        owl:Thing .

:AccountabilityClaim a owl:Class ;
    rdfs:label "AccountabilityClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "accountable"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :AccountableImplementationStructure ],
        :CompetenceProperty,
        owl:Thing .

:Accounting a owl:Class ;
    rdfs:label "Accounting"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrecondition ;
            owl:someValuesFrom :Diagnosis ],
        :CognitiveCapability,
        owl:Thing .

:AchievementMiss a owl:Class ;
    rdfs:label "AchievementMiss"^^xsd:string ;
    rdfs:subClassOf :FailureReason,
        owl:Thing .

:ActionPlanning a owl:Class ;
    rdfs:label "ActionPlanning"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :produces ;
            owl:someValuesFrom :GeneralizedActionPlan ],
        :Prospection,
        owl:Thing .

:ActionReferent a owl:Class ;
    rdfs:label "ActionReferent"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:ActionRelatedForceCorridor a owl:Class ;
    rdfs:label "ActionRelatedForceCorridor"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedGrasp a owl:Class ;
    rdfs:label "ActionRelatedGrasp"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedMotion a owl:Class ;
    rdfs:label "ActionRelatedMotion"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedPour a owl:Class ;
    rdfs:label "ActionRelatedPour"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionSufficiency a owl:Class ;
    rdfs:label "ActionSufficiency"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "action"^^xsd:string ;
            owl:onProperty :sufficiencyKind ],
        :SubstrateSufficiency,
        owl:Thing .

:ActiveStatus a owl:Class ;
    rdfs:label "ActiveStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "active"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TaskStatus,
        owl:Thing .

:ActivityBoundScope a owl:Class ;
    rdfs:label "ActivityBoundScope"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "until_activity_ends"^^xsd:string ;
            owl:onProperty :scopeKind ],
        :RequestScope,
        owl:Thing .

:ActivityCommitment a owl:Class ;
    rdfs:label "ActivityCommitment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "activity"^^xsd:string ;
            owl:onProperty :commitmentKind ],
        :CommitmentTarget,
        owl:Thing .

:Actuating a owl:Class ;
    rdfs:label "Actuating"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :BodyMotion ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :ManipulationControlProgram ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :ActionToken ],
        :ActingMechanism,
        owl:Thing .

:AdmissibleAction a owl:Class ;
    rdfs:label "AdmissibleAction"^^xsd:string ;
    rdfs:subClassOf :CandidateAction,
        owl:Thing .

:AgentCommitment a owl:Class ;
    rdfs:label "AgentCommitment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "agent"^^xsd:string ;
            owl:onProperty :commitmentKind ],
        :CommitmentTarget,
        owl:Thing .

:AlignedWith a owl:Class ;
    rdfs:label "AlignedWith"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "aligned_with"^^xsd:string ;
            owl:onProperty :relationKind ],
        :SpatialRelation,
        owl:Thing .

:AnswerSubstitution a owl:Class ;
    rdfs:label "AnswerSubstitution"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :answersQuery ;
            owl:someValuesFrom :EntityQuery ],
        [ a owl:Restriction ;
            owl:onProperty :hasBinding ;
            owl:someValuesFrom :Binding ],
        :dul_InformationObject,
        owl:Thing .

:ApplicationCentricMicrotheory a owl:Class ;
    rdfs:label "ApplicationCentricMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :focusesOn ;
            owl:someValuesFrom :ApplicationContext ],
        [ a owl:Restriction ;
            owl:hasValue "application"^^xsd:string ;
            owl:onProperty :microtheoryFocus ],
        :BodyWorldProcessMicrotheory,
        owl:Thing .

:ArrangementCommitment a owl:Class ;
    rdfs:label "ArrangementCommitment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "arrangement"^^xsd:string ;
            owl:onProperty :commitmentKind ],
        :CommitmentTarget,
        owl:Thing .

:ArrangementCompetence a owl:Class ;
    rdfs:label "ArrangementCompetence"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :determinesPerformanceOn ;
            owl:someValuesFrom :ArrangementProblem ],
        :ExecutiveCapability,
        owl:Thing .

:ArrangementTemplate a owl:Class ;
    rdfs:label "ArrangementTemplate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :schemaOf ;
            owl:someValuesFrom :Arrangement ],
        :GeneralizedActionPlan,
        owl:Thing .

:ArtifactCertification a owl:Class ;
    rdfs:label "ArtifactCertification"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :certifiesArtifact ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :hasCertificationKind ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :overProblemClass ;
            owl:someValuesFrom :ManipulationProblemClass ],
        :AbstractEntity,
        :Theorem,
        owl:Thing .

:Assessing a owl:Class ;
    rdfs:label "Assessing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :Verdict ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        :EvidentialMechanism,
        owl:Thing .

:AssessmentEvent a owl:Class ;
    rdfs:label "AssessmentEvent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :AssessmentRegime ;
            owl:onProperty :usesRegime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Verdict ;
            owl:onProperty :hasVerdict ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationCase ;
            owl:onProperty :assessesCase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :MetaLevelEntity,
        owl:Thing .

:AttachedTo a owl:Class ;
    rdfs:label "AttachedTo"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "attached_to"^^xsd:string ;
            owl:onProperty :relationKind ],
        :SpatialRelation,
        owl:Thing .

:AttributeConstraint a owl:Class ;
    rdfs:label "AttributeConstraint"^^xsd:string ;
    rdfs:subClassOf :dul_InformationObject,
        owl:Thing .

:AuthoredStateChange a owl:Class ;
    rdfs:label "AuthoredStateChange"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :causedByPerform ;
            owl:someValuesFrom :PerformOccurrence ],
        :TaskRelevantStateChange,
        owl:Thing ;
    owl:disjointWith :DisturbanceStateChange .

:AwarenessClaim a owl:Class ;
    rdfs:label "AwarenessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :ObservationFunction ],
        [ a owl:Restriction ;
            owl:hasValue "aware"^^xsd:string ;
            owl:onProperty :propertyKind ],
        :CompetenceProperty,
        owl:Thing .

:BeginTask a owl:Class ;
    rdfs:label "BeginTask"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :marksTransitionTo ;
            owl:someValuesFrom :Active ],
        :EventType,
        :PlanInterpretationEvent,
        owl:Thing .

:BehaviorFlaw a owl:Class ;
    rdfs:label "BehaviorFlaw"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :matchedOver ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :drives ;
            owl:someValuesFrom :PlanTransformation ],
        [ a owl:Restriction ;
            owl:onProperty :escalatesTo ;
            owl:someValuesFrom :PlanFailure ],
        [ a owl:Restriction ;
            owl:onProperty :drivesRevision ;
            owl:someValuesFrom :PlanTransformation ],
        [ a owl:Restriction ;
            owl:onProperty :hasSeverity ;
            owl:someValuesFrom :FailureSignature ],
        :Representation,
        :VerdictComponent,
        owl:Thing .

:BeliefStateSemanticDigitalTwin a owl:Class ;
    rdfs:label "BeliefStateSemanticDigitalTwin"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :representsSelectedAspectsOf ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :representsForExecutive ;
            owl:someValuesFrom :ManipulationExecutive ],
        :SemanticDigitalTwin,
        owl:Thing .

:BindingConfirmationFunction a owl:Class ;
    rdfs:label "BindingConfirmationFunction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "binding-confirmation"^^xsd:string ;
            owl:onProperty :functionCode ],
        [ a owl:Restriction ;
            owl:onProperty :confirms ;
            owl:someValuesFrom :RoleSlot ],
        [ a owl:Restriction ;
            owl:onProperty :surfaces ;
            owl:someValuesFrom :BindingLevelFailure ],
        :ObservationFunction,
        owl:Thing .

:BodyCentricMicrotheory a owl:Class ;
    rdfs:label "BodyCentricMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :focusesOn ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:hasValue "body"^^xsd:string ;
            owl:onProperty :microtheoryFocus ],
        :BodyWorldProcessMicrotheory,
        owl:Thing .

:BoundVariable a owl:Class ;
    rdfs:label "BoundVariable"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isBound ],
        :QueryVariable,
        owl:Thing ;
    owl:disjointWith :UnboundVariable .

:Bowl a owl:Class ;
    rdfs:label "Bowl"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "bowl"^^xsd:string ;
            owl:onProperty :vesselKind ],
        :Vessel,
        owl:Thing .

:CRAMArchitecture a owl:Class ;
    rdfs:label "CRAMArchitecture"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :adoptsPrinciple ;
            owl:someValuesFrom :ImplicitToExplicitManipulation ],
        [ a owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :ActionExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :hasElement ;
            owl:someValuesFrom :Contextualization ],
        [ a owl:Restriction ;
            owl:onProperty :hasElement ;
            owl:someValuesFrom :GenerativeModel ],
        [ a owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :KnowledgeExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :hasCapability ;
            owl:someValuesFrom :ExecutiveCapability ],
        [ a owl:Restriction ;
            owl:onProperty :specifies ;
            owl:someValuesFrom :CRAMControlProgram ],
        [ a owl:Restriction ;
            owl:onProperty :hasBeliefState ;
            owl:someValuesFrom :BeliefState ],
        [ a owl:Restriction ;
            owl:onProperty :hasElement ;
            owl:someValuesFrom :GeneralizedActionPlan ],
        [ a owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :MetaReasoningExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :hasElement ;
            owl:someValuesFrom :MotionPlan ],
        [ a owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :PlanExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :PerceptionExecutive ],
        :StructuredReactivePlan,
        :dul_Description,
        owl:Thing .

:CRAMPartialDescription a owl:Class ;
    rdfs:label "CRAMPartialDescription"^^xsd:string ;
    rdfs:subClassOf :PartialDescription,
        :Representation,
        owl:Thing .

:CapabilityAssertion a owl:Class ;
    rdfs:label "CapabilityAssertion"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :BodyWorldConstraint,
        owl:Thing .

:CapabilityClaim a owl:Class ;
    rdfs:label "CapabilityClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :establishedBy ;
            owl:someValuesFrom :ObservedConditionsWarrant ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isUniversallyQuantified ],
        :ScopedClaim,
        owl:Thing .

:CausalAdmissibility a owl:Class ;
    rdfs:label "CausalAdmissibility"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :dul_Description,
        owl:Thing .

:CoReference a owl:Class ;
    rdfs:label "CoReference"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :NEEM ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :assertsSameEntity ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :CRAMDesignator ],
        [ a owl:Restriction ;
            owl:onProperty :equatesWith ;
            owl:someValuesFrom :CRAMDesignator ],
        :ComputationalProcess,
        :dul_Description,
        owl:Thing .

:Commitment a owl:Class ;
    rdfs:label "Commitment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :bindsInstance ;
            owl:someValuesFrom :ManipulableInstance ],
        [ a owl:Restriction ;
            owl:onProperty :reservedFor ;
            owl:someValuesFrom :CommitmentTarget ],
        :Representation,
        owl:Thing .

:CommitmentQuestion a owl:Class ;
    rdfs:label "CommitmentQuestion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "commitment"^^xsd:string ;
            owl:onProperty :principleTag ],
        :CompetenceQuestion,
        owl:Thing .

:CompetenceStandard a owl:Class ;
    rdfs:label "CompetenceStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        [ a owl:Restriction ;
            owl:hasValue "competence"^^xsd:string ;
            owl:onProperty :standardCode ],
        :GlobalStandard,
        owl:Thing .

:CompletenessClaim a owl:Class ;
    rdfs:label "CompletenessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :ManipulationProblemClass ],
        [ a owl:Restriction ;
            owl:hasValue "complete"^^xsd:string ;
            owl:onProperty :propertyKind ],
        :CompetenceProperty,
        owl:Thing .

:CompletenessCritic a owl:Class ;
    rdfs:label "CompletenessCritic"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "completeness"^^xsd:string ;
            owl:onProperty :criticDimension ],
        :Critic,
        owl:Thing .

:CompletenessStandard a owl:Class ;
    rdfs:label "CompletenessStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        [ a owl:Restriction ;
            owl:hasValue "completeness"^^xsd:string ;
            owl:onProperty :standardCode ],
        :GlobalStandard,
        owl:Thing .

:CompletionSignal a owl:Class ;
    rdfs:label "CompletionSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:ComponentCompetenceClaim a owl:Class ;
    rdfs:label "ComponentCompetenceClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :requiresDeclaredScope ;
            owl:someValuesFrom :ResponsibleClaimScope ],
        [ a owl:Restriction ;
            owl:onProperty :heldByComponent ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :ManipulationExecutive :ManipulationControlProgram ) ] ],
        :CompetenceClaim,
        owl:Thing .

:CompositeFailure a owl:Class ;
    rdfs:label "CompositeFailure"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :FailureDescription ],
        :FailureDescription,
        owl:Thing .

:ConceptFamilyEnum a owl:Class ;
    rdfs:label "ConceptFamilyEnum"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :SourceAndFamily :System :Executive :Task :EpisodeAndTrace :AssessmentAndClaim ) ] .

:ConceptPattern a owl:Class ;
    rdfs:label "ConceptPattern"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :patternIn ;
            owl:someValuesFrom :Narrative ],
        :Representation,
        owl:Thing .

:ConcurrentProcessInterference a owl:Class ;
    rdfs:label "ConcurrentProcessInterference"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :composesFlowIn ;
            owl:someValuesFrom :ProbabilisticHybridActionModel ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isSymbolic ],
        :Representation,
        :dul_Description,
        owl:Thing .

:ConfigurationChange a owl:Class ;
    rdfs:label "ConfigurationChange"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "configuration"^^xsd:string ;
            owl:onProperty :effectDimension ],
        :ManipulationActionCategory,
        owl:Thing .

:ConfigurationRestoration a owl:Class ;
    rdfs:label "ConfigurationRestoration"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "configuration"^^xsd:string ;
            owl:onProperty :restorationKind ],
        :RestorationType,
        owl:Thing .

:ConnectingAction a owl:Class ;
    rdfs:label "ConnectingAction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "connection"^^xsd:string ;
            owl:onProperty :effectDimension ],
        :ManipulationActionCategory,
        owl:Thing .

:Consolidation a owl:Class ;
    rdfs:label "Consolidation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :partitionsInto ;
            owl:someValuesFrom :Load ],
        :ComputationalProcess,
        owl:Thing .

:ConstraintExploitationPrinciple a owl:Class ;
    rdfs:label "ConstraintExploitationPrinciple"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :characterizesMethod ;
            owl:someValuesFrom :SolutionMethod ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:ContainedState a owl:Class ;
    rdfs:label "ContainedState"^^xsd:string ;
    rdfs:subClassOf :ForceDynamicState,
        owl:Thing .

:ControlRealizability a owl:Class ;
    rdfs:label "ControlRealizability"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :groundedInLayer ;
            owl:someValuesFrom :RealizationChain ],
        [ a owl:Restriction ;
            owl:onProperty :hasRungFailureMode ;
            owl:someValuesFrom :ControlBasisTooWeak ],
        [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :rungLevel ],
        :SubstrateRung,
        owl:Thing .

:ConventionCritic a owl:Class ;
    rdfs:label "ConventionCritic"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "convention"^^xsd:string ;
            owl:onProperty :criticDimension ],
        :Critic,
        owl:Thing .

:CorrectnessClaim a owl:Class ;
    rdfs:label "CorrectnessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:hasValue "correct"^^xsd:string ;
            owl:onProperty :propertyKind ],
        :CompetenceProperty,
        owl:Thing .

:CorrectnessStandard a owl:Class ;
    rdfs:label "CorrectnessStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "correctness"^^xsd:string ;
            owl:onProperty :standardCode ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        :GlobalStandard,
        owl:Thing .

:CouplingTerm a owl:Class ;
    rdfs:label "CouplingTerm"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasCouplingType ;
            owl:someValuesFrom :CouplingType ],
        :dul_Description,
        owl:Thing .

:Created a owl:Class ;
    rdfs:label "Created"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "created"^^xsd:string ;
            owl:onProperty :statusCode ],
        :NonterminalStatus,
        owl:Thing .

:CreatedStatus a owl:Class ;
    rdfs:label "CreatedStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "created"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TaskStatus,
        owl:Thing .

:CriterionRelative a owl:Class ;
    rdfs:label "CriterionRelative"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:CriticizeReviseCycle a owl:Class ;
    rdfs:label "CriticizeReviseCycle"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :criticizesWith ;
            owl:someValuesFrom :BehaviorCritic ],
        [ a owl:Restriction ;
            owl:onProperty :revisesVia ;
            owl:someValuesFrom :PlanTransformation ],
        [ a owl:Restriction ;
            owl:onProperty :projects ;
            owl:someValuesFrom :ExecutionScenario ],
        :ComputationalProcess,
