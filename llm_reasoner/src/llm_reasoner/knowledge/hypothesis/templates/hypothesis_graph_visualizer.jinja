<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<script src="https://unpkg.com/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script>
<style>
  html, body {
    margin: 0;
    height: 100%;
    background: {{ canvas_background_color }};
    color: #202124;
    font-family: Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    text-shadow: none;
  }

  #container {
    display: flex;
    height: 100vh;
  }

  #network {
    flex: 3;
    background: {{ canvas_background_color }};
  }

  #details {
    flex: 1;
    padding: 1rem;
    overflow: auto;
    background: {{ canvas_background_color }};
    border-left: 1px solid #dadce0;
  }

  #details h3 {
    margin-top: 0;
    font-size: 14px;
    font-weight: 400;
  }

  #details p {
    margin: 0.5rem 0;
  }
</style>
</head>
<body>
<div id="container">
  <div id="network"></div>
  <div id="details">
    <i>Click a node to expand it. Double-click it to collapse its branch.</i>
  </div>
</div>
<script>
(() => {
  const networkOptions = {{ network_options_json | safe }};
  const nodes = new vis.DataSet([]);
  const edges = new vis.DataSet([]);
  const detailsPanel = document.getElementById("details");
  const network = new vis.Network(
    document.getElementById("network"),
    { nodes: nodes, edges: edges },
    networkOptions
  );
  let pendingClick;

  function escapeHtml(text) {
    const holder = document.createElement("div");
    holder.textContent = text;
    return holder.innerHTML;
  }

  function synchronize(dataSet, incomingItems) {
    const incomingIds = new Set(incomingItems.map((item) => item.id));
    const newItems = incomingItems.filter((item) => dataSet.get(item.id) === null);
    if (newItems.length > 0) {
      dataSet.add(newItems);
    }
    dataSet.getIds().forEach((identifier) => {
      if (!incomingIds.has(identifier)) {
        dataSet.remove(identifier);
      }
    });
  }

  async function refreshGraph() {
    const response = await fetch("graph");
    const payload = await response.json();
    synchronize(nodes, payload.nodes);
    synchronize(edges, payload.edges);
  }

  async function expandNode(nodeId) {
    const response = await fetch("node/" + nodeId);
    const payload = await response.json();
    const lines = payload.details
      .map((line) => "<p>" + escapeHtml(line) + "</p>")
      .join("");
    detailsPanel.innerHTML =
      "<h3>" + escapeHtml(nodes.get(nodeId).label) + "</h3>" + lines;
    await refreshGraph();
  }

  network.on("click", (params) => {
    if (params.nodes.length === 0) {
      return;
    }
    window.clearTimeout(pendingClick);
    const nodeId = params.nodes[0];
    pendingClick = window.setTimeout(() => expandNode(nodeId), 300);
  });

  network.on("doubleClick", async (params) => {
    window.clearTimeout(pendingClick);
    if (params.nodes.length === 0) {
      return;
    }
    const nodeId = params.nodes[0];
    await fetch("collapse/" + nodeId, { method: "POST" });
    detailsPanel.innerHTML =
      "<h3>" + escapeHtml(nodes.get(nodeId).label) + "</h3><p>Branch collapsed.</p>";
    await refreshGraph();
  });

  refreshGraph();
  window.setInterval(refreshGraph, {{ interval_milliseconds }});
})();
</script>
</body>
</html>
