    rdfs:range code:semantic_digital_twin.semantic_annotations.mixins.HasRootBody .

code:coraplex.robot_plans.actions.core.pick_up.PickUpAction.object_friction a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "object_friction" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "typing.Optional[float]" ;
    rdfs:comment """Sliding friction coefficient to apply to the target object's geom before this pick,
overriding the world's default. Not consumed by this action itself -- applying it is
the caller's responsibility (see
:meth:`~physics_simulators.mujoco_simulator.MujocoSimulator.set_geom_friction`);
recorded here for persistence. ``None`` leaves the friction untouched.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.PickUpAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.pick_up.PickUpAction.orientation_threshold a owl:DatatypeProperty,
