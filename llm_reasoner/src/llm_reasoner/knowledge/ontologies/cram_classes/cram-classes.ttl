code:semantic_digital_twin.robots.ur10e_arm.UR10eArm a owl:Class ;
    rdfs:label "UR10eArm" ;
    code:pythonName "semantic_digital_twin.robots.ur10e_arm.UR10eArm" ;
    rdfs:comment """A Universal Robots UR10e arm.

The robot description the arm is parsed from is a URDF, which carries the joints but
nothing about what drives them, and there is no MuJoCo description of this arm in
this repository to read that from either. The arm therefore declares its own drives,
the way :class:`~semantic_digital_twin.robots.robotiq_85_gripper.Robotiq85Gripper`
declares the gripper's, as MuJoCo Menagerie tunes them in
``universal_robots_ur10e/ur10e.xml``.""" ;
    rdfs:subClassOf code:semantic_digital_twin.robots.robot_parts.Arm,
        code:semantic_digital_twin.robots.robot_parts.ServoedRobotPart .

code:semantic_digital_twin.semantic_annotations.mixins.HasApertures a owl:Class ;
    rdfs:label "HasApertures" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasApertures" ;
    rdfs:comment """A mixin class for semantic annotations that have apertures.

An aperture is an opening through this annotation's material, so mounting one
removes its volume from the annotation's collision and visual geometry.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasRootBody,
        code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

code:semantic_digital_twin.semantic_annotations.mixins.HasCabinets a owl:Class ;
    rdfs:label "HasCabinets" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasCabinets" ;
    rdfs:comment "A mixin class for semantic annotations built from cabinets." ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

code:semantic_digital_twin.semantic_annotations.mixins.HasCounterTop a owl:Class ;
    rdfs:label "HasCounterTop" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasCounterTop" ;
    rdfs:comment """A mixin class for semantic annotations that carry a counter top.

Distinct from :class:`HasSupportingSurface`, which is the bare region something can
be put on: this is the worktop as a thing in its own right, which is what a scan
sees and what in turn carries the sink.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

code:semantic_digital_twin.semantic_annotations.mixins.HasDrawnGraspsByDefault a owl:Class ;
    rdfs:label "HasDrawnGraspsByDefault" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasDrawnGraspsByDefault" ;
    rdfs:comment """A mixin class for semantic annotations whose shape is known well enough that, while
no model is given, their grasps are drawn uniformly from where their
:attr:`grasp_strategy` allows instead of taken at their origin.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasGraspCandidates .

code:semantic_digital_twin.semantic_annotations.mixins.HasHandles a owl:Class ;
    rdfs:label "HasHandles" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasHandles" ;
    rdfs:comment "A mixin class for semantic annotations that may have more than one handle." ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasRootBody,
        code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

code:semantic_digital_twin.semantic_annotations.mixins.HasShelfLayers a owl:Class ;
    rdfs:label "HasShelfLayers" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasShelfLayers" ;
    rdfs:comment "A mixin class for semantic annotations that have shelf layers." ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

code:semantic_digital_twin.semantic_annotations.mixins.HasSink a owl:Class ;
    rdfs:label "HasSink" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasSink" ;
    rdfs:comment "A mixin class for semantic annotations that have a sink." ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

