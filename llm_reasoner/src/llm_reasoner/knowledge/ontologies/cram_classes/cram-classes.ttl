code:coraplex.robot_plans.actions.base.Action a owl:Class ;
    rdfs:label "Action" ;
    code:pythonName "coraplex.robot_plans.actions.base.Action" ;
    rdfs:comment """Something a robot does, described by the parameters it is given and run as a node of
a statechart.

It ends itself once it did what it does, so an action can be a step of another one.
What it does takes one of a few shapes: a :class:`GoalAction` reaches a single goal,
while a :class:`SequentialAction`, :class:`ParallelAction` or :class:`TryAllAction`
is the control structure node of the steps it creates.

A parameter may also be given as an underspecified statement of its value, such as
``a(...)``, which is grounded when the action runs.""" ;
    rdfs:subClassOf code:cramph.node.StatechartNode .

code:coraplex.robot_plans.actions.composite.tool_based.PouringAction a owl:Class ;
    rdfs:label "PouringAction" ;
    code:pythonName "coraplex.robot_plans.actions.composite.tool_based.PouringAction" ;
    rdfs:comment """Pour from a held source container into a target container by tilting the source next
to the target's rim.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.SequentialAction,
        code:coraplex.robot_plans.actions.composite.tool_based.FullBodyControlledAction,
        code:coraplex.robot_plans.mixins.MovesToolCenterPoint .

code:coraplex.robot_plans.actions.core.misc.DetectAction a owl:Class ;
