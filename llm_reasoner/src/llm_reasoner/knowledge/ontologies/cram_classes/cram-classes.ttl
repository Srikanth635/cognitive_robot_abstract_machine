    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "typing.Optional[float]" ;
    rdfs:comment """Maximum linear speed (in m/s) for lifting the object clear of the table after
grasping, enforced via
:class:`~giskardpy.motion_statechart.tasks.cartesian_tasks.CartesianPositionVelocityLimit`.
``None`` leaves the speed unconstrained.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.PickUpAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.pick_up.PickUpAction.object_designator a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "object_designator" ;
    code:pythonType "HasRootBody" ;
    rdfs:comment "The annotation of the object that should be picked up." ;
