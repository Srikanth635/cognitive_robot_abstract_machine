code:semantic_digital_twin.semantic_annotations.semantic_annotations.ShapeSortingPiece.grasp_height a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "grasp_height" ;
    code:pythonType "float" ;
    rdfs:comment """How far above its bottom face the piece is gripped.

Gripped low, the piece hangs as little as possible below the fingers when it is let
go of over its hole; how low depends on how far the closing fingers reach past the
point they are brought to.""" ;
    rdfs:domain code:semantic_digital_twin.semantic_annotations.semantic_annotations.ShapeSortingPiece ;
    rdfs:range xsd:double .

