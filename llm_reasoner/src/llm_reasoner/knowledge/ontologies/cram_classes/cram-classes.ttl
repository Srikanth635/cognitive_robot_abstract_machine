code:coraplex.robot_plans.actions.core.robot_body.MoveFingersToWidthAction.squeeze a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "squeeze" ;
    code:defaultValue "0.0" ;
    code:pythonType "float" ;
    rdfs:comment """How far past that width each fingertip is sent, in metres, so the fingers press into
an object rather than merely touching it. The object stops them short of that, so
fingers squeezing it count as done once they stopped approaching it.

Keep it small, since it is commanded penetration into a body that does not yield.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.robot_body.MoveFingersToWidthAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.robot_body.MoveFingersToWidthAction.threshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "threshold" ;
    code:defaultValue "0.0005" ;
    code:pythonType "float" ;
    rdfs:comment """How close, in metres, the fingertips have to come to the goal for the action to
count as done: well under a squeeze, so the squeeze is not lost to the tolerance.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.robot_body.MoveFingersToWidthAction ;
    rdfs:range xsd:double .

