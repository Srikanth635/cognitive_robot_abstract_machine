code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction.arm a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "arm" ;
    code:pythonType "Arm" ;
    rdfs:comment "The arm holding the tool." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction ;
    rdfs:range code:semantic_digital_twin.robots.robot_parts.Arm .

code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction.maximum_skip_ahead a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maximum_skip_ahead" ;
    code:defaultValue "2" ;
    code:pythonType "int" ;
    rdfs:comment """How many waypoints ahead the tool may already be heading for, so a path is followed
as a continuous stroke rather than stopping at every point.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction ;
    rdfs:range xsd:integer .

code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction.pointer_stride a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pointer_stride" ;
    code:defaultValue "1" ;
    code:pythonType "int" ;
    rdfs:comment "Keep every Nth sampled waypoint for execution." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction ;
    rdfs:range xsd:integer .

code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction.tool a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "tool" ;
    code:pythonType "Tool" ;
    rdfs:comment "The tool that performs the motion." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.ToolMotionAction ;
    rdfs:range code:semantic_digital_twin.semantic_annotations.semantic_annotations.Tool .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.cycles a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cycles" ;
    code:defaultValue "1.0" ;
    code:pythonType "float" ;
    rdfs:comment "Number of sweep cycles for the spreading motion." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.final_waypoint_success_tolerance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "final_waypoint_success_tolerance" ;
    code:defaultValue "0.08" ;
    code:pythonType "float" ;
    rdfs:comment """Accept a stalled motion as successful if the tool ended up within this distance in
meters of the final waypoint.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.length a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "length" ;
    code:defaultValue "0.2" ;
    code:pythonType "float" ;
    rdfs:comment "Sweep length in meters for the spreading motion." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.stall_timeout a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "stall_timeout" ;
    code:pythonType "timedelta" ;
    rdfs:comment """How long the tool may make no progress along its path before the wipe is checked for
having reached the final waypoint.

.. note:: Has to be shorter than the stall timeout of the executor, which otherwise
    aborts the plan first.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.surface a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "surface" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "Body | None" ;
    rdfs:comment """The surface body to wipe.

If None, ``target_pose`` is used instead.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction ;
    rdfs:range code:semantic_digital_twin.world_description.world_entity.Body .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.target_pose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "target_pose" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "Pose | None" ;
    rdfs:comment """Center pose of the wiping patch.

Only used if ``surface`` is None.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction ;
    rdfs:range code:krrood_spatial_math.spatial_types.Pose .

code:coraplex.robot_plans.actions.composite.tool_based.WipingAction.technique a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "technique" ;
    code:defaultValue "<WipingTechnique.WIPE: 1>" ;
    code:pythonType "WipingTechnique" ;
    rdfs:comment "The wiping technique to use." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.WipingAction ;
    rdfs:range code:coraplex.datastructures.enums.WipingTechnique .

