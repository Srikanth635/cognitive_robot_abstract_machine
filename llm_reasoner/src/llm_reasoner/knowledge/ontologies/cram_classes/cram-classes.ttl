code:coraplex.robot_plans.actions.composite.tool_based.PouringAction.pour_height a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pour_height" ;
    code:defaultValue "0.13" ;
    code:pythonType "float" ;
