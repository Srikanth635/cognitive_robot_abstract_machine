code:semantic_digital_twin.semantic_annotations.semantic_annotations.Agent a owl:Class ;
    rdfs:label "Agent" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.semantic_annotations.Agent" ;
    rdfs:comment """Represents an entity in the world that can act, move, or be controlled.

Agents are dynamic bodies with semantic meaning — they may have intent, behavior, or
be controlled by external or internal logic. Examples include robots, humans, or
other autonomous actors.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasRootBody .

