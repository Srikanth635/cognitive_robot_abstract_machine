        owl:ObjectProperty ;
    rdfs:label "target_container" ;
    code:pythonType "Body" ;
    rdfs:comment "The container that is poured into." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.PouringAction ;
    rdfs:range code:semantic_digital_twin.world_description.world_entity.Body .

