    rdfs:label "perceive_before_grasp" ;
    code:defaultValue "False" ;
    code:pythonType "bool" ;
    rdfs:comment """Whether to look at the object and detect it before the final approach.

Passed on to the reach this pick-up is built from; see
:attr:`ReachAction.perceive_before_grasp`.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.PickUpAction ;
    rdfs:range xsd:boolean .

