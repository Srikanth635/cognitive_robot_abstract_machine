code:semantic_digital_twin.semantic_annotations.semantic_annotations.EntryWay a owl:Class ;
    rdfs:label "EntryWay" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.semantic_annotations.EntryWay" ;
    rdfs:comment """The passage a door covers.

It is coextensive with the door leaf, so mounting it on its door leaves the door's
geometry intact; mounting it on a :class:`Wall` cuts the doorway out of the wall.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.semantic_annotations.Aperture .

