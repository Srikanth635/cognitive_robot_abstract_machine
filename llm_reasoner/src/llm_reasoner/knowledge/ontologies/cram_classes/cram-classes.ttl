code:coraplex.robot_plans.actions.core.navigation.ElevatorNavigation a owl:Class ;
    rdfs:label "ElevatorNavigation" ;
    code:pythonName "coraplex.robot_plans.actions.core.navigation.ElevatorNavigation" ;
    rdfs:comment """Navigates a robot to another level of a building using an elevator, the robot drives
in the elevator and waits there until the doors open again and the elevator is at
the right level.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.SequentialAction,
        code:coraplex.robot_plans.mixins.ReattachesBranches .

code:coraplex.robot_plans.actions.core.navigation.LookAtAction a owl:Class ;
    rdfs:label "LookAtAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.navigation.LookAtAction" ;
    rdfs:comment """Lets the robot look at a position, following it while the look runs when it is given
relative to a body that moves.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.ParallelAction .

code:coraplex.robot_plans.actions.core.robot_body.MoveFingersToWidthAction a owl:Class ;
    rdfs:label "MoveFingersToWidthAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.robot_body.MoveFingersToWidthAction" ;
    rdfs:comment """Closes a two-finger gripper until its fingertips stand a given distance apart,
rather than driving it to a gripper state of its own.

Closing a gripper all the way onto an object that is not centred between the
fingers wedges it sideways instead of holding it, so an object held by contact alone
is better met at its own width. Giskard is given the distance between the fingertips
as the goal and finds the joint positions that realise it.

.. note:: This only means anything where something pushes back, see
    :class:`~coraplex.robot_plans.plan_transformations.CloseFingersToObjectWidth`.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.GoalAction .

code:coraplex.robot_plans.mixins.ReattachesBranches a owl:Class ;
    rdfs:label "ReattachesBranches" ;
    code:pythonName "coraplex.robot_plans.mixins.ReattachesBranches" ;
    rdfs:comment """An action that moves a branch of the kinematic structure under a new parent in the
world model, such as an object it picks up or a robot it carries along.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.Action .

code:semantic_digital_twin.datastructures.definitions.TorsoState a owl:Class ;
    rdfs:label "TorsoState" ;
    code:pythonName "semantic_digital_twin.datastructures.definitions.TorsoState" .

code:semantic_digital_twin.grasping.grasp_candidates.GraspCandidate a owl:Class ;
    rdfs:label "GraspCandidate" ;
    code:pythonName "semantic_digital_twin.grasping.grasp_candidates.GraspCandidate" ;
    rdfs:comment """A grasp an object offers, together with the object offering it.

A grasp frame has its x-axis pointing the way the gripper travels toward the object,
its y-axis along the axis the fingers close along, and its z-axis completing the
frame. Every end effector states the same two axes in its own tool frame, as
:attr:`~semantic_digital_twin.robots.robot_parts.EndEffector.approach_axis` and
:attr:`~semantic_digital_twin.robots.robot_parts.EndEffector.closing_axis`, which is
how a grasp stays independent of the robot performing it.""" .

code:semantic_digital_twin.semantic_annotations.mixins.HasMovableJoint a owl:Class ;
    rdfs:label "HasMovableJoint" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasMovableJoint" ;
    rdfs:comment """A mixin class for semantic annotations whose root moves relative to its parent, such
as a door on its hinge or a drawer on its rails.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasRootBody .

code:semantic_digital_twin.semantic_annotations.mixins.HasRim a owl:Class ;
    rdfs:label "HasRim" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasRim" ;
    rdfs:comment """A mixin class for open containers that have a rim, and are grasped at it when they
have one.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasDrawnGraspsByDefault,
        code:semantic_digital_twin.semantic_annotations.mixins.PartWholeRelationship .

code:semantic_digital_twin.semantic_annotations.mixins.HasRootKinematicStructureEntity a owl:Class ;
    rdfs:label "HasRootKinematicStructureEntity" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.mixins.HasRootKinematicStructureEntity" ;
    rdfs:comment """Base class for shared method for HasRootBody and HasRootRegion.

Building a specification takes two steps:
:meth:`get_default_root_kinematic_structure_entity_specification` describes the root entity's geometry,
and :meth:`get_annotation_specification` wraps that root into the spawnable
annotation specification.

.. code-block:: python

    Handle.get_annotation_specification(
        "handle",
        Handle.get_default_root_kinematic_structure_entity_specification(
            scale=Scale(0.1, 0.05, 0.05), thickness=0.01
        ),
    )

Every geometry parameter belongs to the first step, so a type's geometry is
described in exactly one place.""" ;
    rdfs:subClassOf code:semantic_digital_twin.world_description.world_entity.SemanticAnnotation .

