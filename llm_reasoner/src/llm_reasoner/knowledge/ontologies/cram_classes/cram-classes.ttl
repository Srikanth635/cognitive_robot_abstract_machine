code:coraplex.robot_plans.actions.core.pick_up.GraspingAction.grasp_closing_velocity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "grasp_closing_velocity" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "float | None" ;
    rdfs:comment """Maximum finger joint velocity (in m/s) used while closing onto the object, enforced
via
:class:`~giskardpy.motion_statechart.tasks.joint_tasks.JointVelocityLimit`. ``None``
leaves the speed unconstrained.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.GraspingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.pick_up.GraspingAction.grasp_detection_threshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "grasp_detection_threshold" ;
    code:defaultValue "0.9" ;
    code:pythonType "float" ;
    rdfs:comment """Minimum fraction of sampled rays between the gripper's fingers that must hit the
target object for it to count as grasped/held (see
:func:`~semantic_digital_twin.reasoning.robot_predicates.is_body_gripped`).""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.GraspingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.pick_up.GraspingAction.grasp_stall_minimum_time a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "grasp_stall_minimum_time" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "float | None" ;
    rdfs:comment """Minimum stall dwell time (in seconds, see
:attr:`~giskardpy.motion_statechart.tasks.gripper.MoveFingers.stall_minimum_time`)
for the CLOSE motion. ``None`` keeps the default.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.GraspingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.pick_up.GraspingAction.lift_linear_velocity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "lift_linear_velocity" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "float | None" ;
    rdfs:comment """Maximum linear speed (in m/s) for lifting the object clear of the table after
grasping, enforced via
:class:`~giskardpy.motion_statechart.tasks.cartesian_tasks.CartesianPositionVelocityLimit`.
``None`` leaves the speed unconstrained.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.pick_up.GraspingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.pick_up.GraspingAction.object_friction a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "object_friction" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "float | None" ;
    rdfs:comment """Sliding friction coefficient to apply to the target object's geom before this pick,
overriding the world's default. Not consumed by this action itself -- applying it is
the caller's responsibility (see
:meth:`~physics_simulators.mujoco_simulator.MujocoSimulator.set_geom_friction`);
recorded here for persistence. ``None`` leaves the friction untouched.""" ;
