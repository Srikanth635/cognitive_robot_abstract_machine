        owl:FunctionalProperty ;
    rdfs:label "mix_duration" ;
    code:defaultValue "0.0" ;
    code:pythonType "float" ;
    rdfs:comment """Total mixing time in seconds for a continuous stir loop.

If not positive, a short spiral pattern is used instead.""" ;
