    rdfs:label "FaceAtAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.navigation.FaceAtAction" ;
    rdfs:comment """Turns the robot's base on the spot until its front faces a target.

The base keeps the position it has when the action starts, so the turn is towards
the target from wherever an earlier action left it.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.ParallelAction .

