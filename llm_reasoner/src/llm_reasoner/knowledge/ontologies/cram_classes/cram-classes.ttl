code:coraplex.robot_plans.motions.gripper.ReachMotion.reverse_pose_sequence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reverse_pose_sequence" ;
    code:defaultValue "False" ;
    code:pythonType "bool" ;
    rdfs:comment """Reverses the sequence of poses, i.e., moves away from the object instead of towards
it.

Used for placing objects.""" ;
    rdfs:domain code:coraplex.robot_plans.motions.gripper.ReachMotion ;
    rdfs:range xsd:boolean .

code:coraplex.robot_plans.motions.misc.DetectingMotion.accept_first_if_multiple a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "accept_first_if_multiple" ;
    code:defaultValue "False" ;
    code:pythonType "bool" ;
    rdfs:comment """Whether several candidates may be resolved by taking the first one.

When False, several candidates raise
:class:`~coraplex.exceptions.UnidentifiedDetections` instead of being chosen between.""" ;
    rdfs:domain code:coraplex.robot_plans.motions.misc.DetectingMotion ;
    rdfs:range xsd:boolean .

