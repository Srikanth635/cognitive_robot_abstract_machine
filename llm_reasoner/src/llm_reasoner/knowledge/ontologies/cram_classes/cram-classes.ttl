code:coraplex.perception.PerceptionQuery a owl:Class ;
    rdfs:label "PerceptionQuery" ;
    code:pythonName "coraplex.perception.PerceptionQuery" ;
    rdfs:comment """What to look for and where.

Travels to whichever process answers it, so the world and the robot are carried by
reference and resolved against the world on the receiving side.""" .

code:coraplex.robot_plans.actions.core.navigation.PathPlanningNavigateAction a owl:Class ;
    rdfs:label "PathPlanningNavigateAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.navigation.PathPlanningNavigateAction" ;
    rdfs:comment """Navigates the robot to a pose along a path through the environment's free space.

The free space is decomposed into a graph of convex sets, so the robot drives around
the furniture and walls between it and the target instead of straight at them.


This works for obstacles which are known in the environment beforehand not such that are added during navigation.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.ActionDescription .

