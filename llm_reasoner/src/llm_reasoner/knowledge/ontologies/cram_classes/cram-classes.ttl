code:semantic_digital_twin.semantic_annotations.semantic_annotations.Elevator a owl:Class ;
    rdfs:label "Elevator" ;
    code:pythonName "semantic_digital_twin.semantic_annotations.semantic_annotations.Elevator" ;
    rdfs:comment """An elevator in the world, consists of three walls a floor, double doors for entering and a prismatic drive that moves
the elevator to other floors.""" ;
    rdfs:subClassOf code:semantic_digital_twin.semantic_annotations.mixins.HasCaseAsRootBody,
        code:semantic_digital_twin.semantic_annotations.mixins.HasDoors,
