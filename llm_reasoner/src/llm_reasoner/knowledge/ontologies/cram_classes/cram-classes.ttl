code:coraplex.robot_plans.motions.gripper.MoveGripperMotion.tolerate_stall a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "tolerate_stall" ;
    code:defaultValue "False" ;
    code:pythonType "bool" ;
    rdfs:comment """Whether this motion is also considered done once the fingers' velocities settle
near zero, even without reaching their nominal target position -- checked via a
separate :class:`~giskardpy.motion_statechart.monitors.monitors.LocalMinimumReached`
monitor alongside the goal, not by the goal's own observation, since stalling does
not mean the goal itself was reached.""" ;
    rdfs:domain code:coraplex.robot_plans.motions.gripper.MoveGripperMotion ;
    rdfs:range xsd:boolean .

