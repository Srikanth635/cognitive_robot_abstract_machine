code:coraplex.robot_plans.actions.base.GoalAction a owl:Class ;
    rdfs:label "GoalAction" ;
    code:pythonName "coraplex.robot_plans.actions.base.GoalAction" ;
    rdfs:comment """An action reaching a single goal, the node :meth:`create_goal` creates, which stays
a node of its own below the action.

The action reaches its goal once that node did, and declares itself failed as soon
as the node failed. A goal whose owner decides its success, such as a single task,
is ended by the action once it observes True.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.Action,
        code:cramph.node.StatechartNode .

