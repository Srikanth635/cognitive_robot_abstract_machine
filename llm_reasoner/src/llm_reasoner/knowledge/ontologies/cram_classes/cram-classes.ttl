    rdfs:domain code:coraplex.robot_plans.actions.core.robot_body.ParkArmsAction ;
    rdfs:range code:semantic_digital_twin.robots.robot_parts.Arm .

code:coraplex.robot_plans.actions.core.robot_body.ParkArmsAction.max_joint_velocity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "max_joint_velocity" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "float | None" ;
    rdfs:comment """Maximum joint velocity (in rad/s or m/s, per joint), enforced via
:class:`~giskardpy.motion_statechart.tasks.joint_tasks.JointVelocityLimit`. ``None``
leaves the speed unconstrained.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.core.robot_body.ParkArmsAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.core.robot_body.SetGripperAction.configuration a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "configuration" ;
    code:pythonType "GripperConfiguration" ;
    rdfs:comment "The configuration the gripper is to reach." ;
    rdfs:domain code:coraplex.robot_plans.actions.core.robot_body.SetGripperAction ;
    rdfs:range code:semantic_digital_twin.datastructures.robots.gripper_configuration.GripperConfiguration .

code:coraplex.robot_plans.mixins.MovesToolCenterPoint.orientation_threshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "orientation_threshold" ;
    code:defaultValue "0.02" ;
    code:pythonType "float" ;
    rdfs:comment "Rotation threshold in rad for goal achievement." ;
    rdfs:domain code:coraplex.robot_plans.mixins.MovesToolCenterPoint ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.mixins.MovesToolCenterPoint.position_threshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "position_threshold" ;
    code:defaultValue "0.005" ;
    code:pythonType "float" ;
    rdfs:comment """Distance threshold in meters for goal achievement, tighter than giskard's own task
default so an approach does not stop short of a small object.""" ;
    rdfs:domain code:coraplex.robot_plans.mixins.MovesToolCenterPoint ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.mixins.OperatesGripper.gripper_goal_type a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "gripper_goal_type" ;
    code:pythonType "type[giskardpy.motion_statechart.tasks.gripper.MovesGripperToConfiguration]" ;
    rdfs:comment """The kind of node bringing the gripper into the configurations this action asks for,
as set by the plan transformations configuring the action.""" ;
    rdfs:domain code:coraplex.robot_plans.mixins.OperatesGripper .

code:coraplex.robot_plans.mixins.ReattachesBranches.reattaches_in_world_model a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reattaches_in_world_model" ;
