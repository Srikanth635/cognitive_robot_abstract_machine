    rdfs:comment "Opens a container like object, driving its mechanism to its upper limit." ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.core.container.MovesContainerByItsHandle .

code:coraplex.robot_plans.actions.core.navigation.PathPlanningNavigateAction a owl:Class ;
    rdfs:label "PathPlanningNavigateAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.navigation.PathPlanningNavigateAction" ;
    rdfs:comment """Navigates the robot to a pose along a path through the environment's free space.

The free space is decomposed into a graph of convex sets, so the robot drives around
the furniture and walls between it and the target instead of straight at them.

This works for obstacles which are known in the environment beforehand, not for
those added during navigation.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.SequentialAction,
        code:coraplex.robot_plans.actions.core.navigation.DrivesBase .

code:coraplex.robot_plans.actions.core.pick_up.FixateObjectAction a owl:Class ;
    rdfs:label "FixateObjectAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.pick_up.FixateObjectAction" ;
    rdfs:comment """Keeps what a gripper holds exactly where it is, by keeping the gripper where it is
when the action starts, whether the object hangs off the gripper or not, such as the
handle of a drawer the gripper holds open.

Like the task it holds, it leaves its end to its owner: beside other nodes in a
parallel it keeps the object in place for as long as the parallel runs, while a
sequence ends it as soon as the gripper holds still.""" ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.ParallelAction .

code:coraplex.robot_plans.actions.core.robot_body.MoveTorsoAction a owl:Class ;
    rdfs:label "MoveTorsoAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.robot_body.MoveTorsoAction" ;
    rdfs:comment "Move the torso of the robot up and down." ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.SequentialAction .

code:coraplex.robot_plans.actions.core.robot_body.SetGripperAction a owl:Class ;
    rdfs:label "SetGripperAction" ;
    code:pythonName "coraplex.robot_plans.actions.core.robot_body.SetGripperAction" ;
    rdfs:comment "Moves a gripper to the given configuration." ;
    rdfs:subClassOf code:coraplex.robot_plans.actions.base.GoalAction,
        code:coraplex.robot_plans.mixins.OperatesGripper .

code:krrood_spatial_math.spatial_types.Pose2D a owl:Class ;
    rdfs:label "Pose2D" ;
    code:pythonName "krrood_spatial_math.spatial_types.Pose2D" ;
    rdfs:comment """Represents a 2D pose consisting of an x coordinate, a y coordinate, and a yaw angle.

Internally stored as a 3×1 symbolic vector ``[x, y, yaw]``. It lies on its reference
frame's x-y plane and has no height or tilt of its own, so it carries no ``z``,
``roll`` or ``pitch``. Whenever 3D calculations are required, use :attr:`pose` to
obtain the equivalent 3D :class:`Pose`.""" .

code:semantic_digital_twin.collision_checking.collision_matrix.CollisionRule a owl:Class ;
    rdfs:label "CollisionRule" ;
    code:pythonName "semantic_digital_twin.collision_checking.collision_matrix.CollisionRule" ;
    rdfs:comment """Base class for collision rules.

They modify collision matrices by adding or removing collision checks.""" .

