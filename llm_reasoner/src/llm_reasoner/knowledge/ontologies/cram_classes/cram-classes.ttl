        owl:ObjectProperty ;
    rdfs:label "goal" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "StatechartNode | None" ;
    rdfs:comment "The child reaching the goal of this action, None until the action was expanded." ;
    rdfs:domain code:coraplex.robot_plans.actions.base.GoalAction ;
    rdfs:range code:cramph.node.StatechartNode .

code:coraplex.robot_plans.actions.base.ParallelAction.minimum_success a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "minimum_success" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "int | None" ;
    rdfs:comment """None, so every step has to be at its goal; how many have to be is up to the action,
not a parameter it is described by.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.base.ParallelAction ;
    rdfs:range xsd:integer .

