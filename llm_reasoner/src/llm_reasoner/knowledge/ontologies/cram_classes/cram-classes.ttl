code:coraplex.robot_plans.actions.composite.tool_based.PouringAction.pour_side a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "pour_side" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "PouringSide | None" ;
    rdfs:comment """Robot-relative side of the target container to pour from.

Defaults to the side of the pouring arm, so one-arm robots can still use either
side's pouring geometry.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.PouringAction ;
    rdfs:range code:coraplex.datastructures.enums.PouringSide .

code:coraplex.robot_plans.actions.composite.tool_based.PouringAction.pour_side_offset a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pour_side_offset" ;
    code:defaultValue "0.0" ;
    code:pythonType "float" ;
    rdfs:comment "Extra lateral offset in meters of the pour point from the target container's center." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.PouringAction ;
    rdfs:range xsd:double .

