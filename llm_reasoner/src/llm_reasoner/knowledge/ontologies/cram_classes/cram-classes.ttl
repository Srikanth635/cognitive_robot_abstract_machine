code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction.number_of_cuts_on_local_x_axis a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number_of_cuts_on_local_x_axis" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "int | None" ;
    rdfs:comment """Number of cut passes along the object's local X axis.

Derived from ``slice_thickness`` and the object size if None.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction ;
    rdfs:range xsd:integer .

code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction.object_to_cut a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "object_to_cut" ;
    code:pythonType "Body" ;
    rdfs:comment "The object to cut." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction ;
    rdfs:range code:semantic_digital_twin.world_description.world_entity.Body .

code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction.slice_thickness a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "slice_thickness" ;
    code:defaultValue "None" ;
    code:isOptional true ;
    code:pythonType "float | None" ;
    rdfs:comment """Target slice thickness in meters, controlling the spacing between cut anchors.

Derived from ``number_of_cuts_on_local_x_axis`` and the object size if None.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction ;
    rdfs:range xsd:double .

code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction.slicing_priority a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "slicing_priority" ;
    code:defaultValue "<SlicingPriority.THICKNESS: 1>" ;
    code:pythonType "SlicingPriority" ;
    rdfs:comment """Parameter that is kept when ``slice_thickness`` and
``number_of_cuts_on_local_x_axis`` do not both fit the object.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction ;
    rdfs:range code:coraplex.datastructures.enums.SlicingPriority .

code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction.technique a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "technique" ;
    code:defaultValue "<CuttingTechnique.SAW: 2>" ;
    code:pythonType "CuttingTechnique" ;
    rdfs:comment "The cutting technique to use." ;
    rdfs:domain code:coraplex.robot_plans.actions.composite.tool_based.CuttingAction ;
    rdfs:range code:coraplex.datastructures.enums.CuttingTechnique .

