code:coraplex.datastructures.trajectory.PoseTrajectory.poses a owl:ObjectProperty ;
    rdfs:label "poses" ;
    code:pythonType "list[Pose]" ;
    rdfs:comment "Ordered waypoint poses." ;
    rdfs:domain code:coraplex.datastructures.trajectory.PoseTrajectory ;
    rdfs:range code:krrood_spatial_math.spatial_types.Pose .

code:coraplex.robot_plans.actions.base.Action.temporary_collision_rules a owl:ObjectProperty ;
    rdfs:label "temporary_collision_rules" ;
    code:pythonType "list[CollisionRule]" ;
    rdfs:comment """The collision rules in force while this action runs, next to the temporary rules of
everything else running at the same time, as created by
:meth:`create_temporary_collision_rules` when the action is expanded.

They belong to the action rather than to a node beside each of its steps, so they
also hold between two steps. Sent along with the action, because a receiver does not
expand it again.""" ;
    rdfs:domain code:coraplex.robot_plans.actions.base.Action ;
    rdfs:range code:semantic_digital_twin.collision_checking.collision_matrix.CollisionRule .

