            sh:path <http://aicor.knowledge/ontologies/image-schemas.owl#secondContactEntity> ],
        [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#EntitySpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/image-schemas.owl#firstContactEntity> ] ;
    sh:targetClass <http://aicor.knowledge/ontologies/image-schemas.owl#ContactSchema> .

