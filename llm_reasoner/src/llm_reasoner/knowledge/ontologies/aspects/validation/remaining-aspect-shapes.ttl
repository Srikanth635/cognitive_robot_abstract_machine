    sh:targetClass <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#AffordanceSpecification> .

[] a sh:NodeShape ;
    sh:property [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#PhaseSpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/sensorimotor-events.owl#beforePhase> ],
        [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#ConditionSpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/sensorimotor-events.owl#boundaryCondition> ],
        [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#PhaseSpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/sensorimotor-events.owl#afterPhase> ] ;
    sh:targetClass <http://aicor.knowledge/ontologies/sensorimotor-events.owl#EventBoundarySpecification> .

[] a sh:NodeShape ;
    sh:property [ sh:class <http://aicor.knowledge/ontologies/force-dynamics.owl#ForceParticipant> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/force-dynamics.owl#agonist> ],
        [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#ApplicabilitySpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/force-dynamics.owl#applicability> ],
        [ sh:class <http://aicor.knowledge/ontologies/force-dynamics.owl#StrengthRelation> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/force-dynamics.owl#relativeStrength> ],
        [ sh:class <http://aicor.knowledge/ontologies/force-dynamics.owl#ForceParticipant> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/force-dynamics.owl#antagonist> ],
        [ sh:class <http://aicor.knowledge/ontologies/force-dynamics.owl#Resultant> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/force-dynamics.owl#describedResult> ] ;
    sh:targetClass <http://aicor.knowledge/ontologies/force-dynamics.owl#ForceDynamicDescription> .

[] a sh:NodeShape ;
    sh:property [ sh:class <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#AffordanceSpecification> ;
            sh:path <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#hasAffordance> ],
        [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#EntitySpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#describesEntity> ],
        [ sh:class <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#GeometrySpecification> ;
            sh:path <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#hasGeometry> ],
        [ sh:class <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#MaterialSpecification> ;
            sh:path <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#hasMaterial> ] ;
    sh:targetClass <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#EntityDescription> .

[] a sh:NodeShape ;
    sh:property [ sh:class <http://aicor.knowledge/ontologies/action-description-core.owl#EntitySpecification> ;
            sh:maxCount 1 ;
