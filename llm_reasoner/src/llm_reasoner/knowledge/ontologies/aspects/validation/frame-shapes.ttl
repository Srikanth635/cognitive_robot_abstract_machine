@prefix fr: <http://aicor.knowledge/ontologies/frame-perspective.owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
fr:FrameShape a sh:NodeShape; sh:targetClass fr:FrameDefinition;
 sh:property [sh:path fr:parentFrame; sh:maxCount 1; sh:class fr:FrameDefinition];
 sh:property [sh:path fr:hasSlot; sh:class fr:SlotDefinition];
 sh:property [sh:path fr:hasOverride; sh:class fr:SlotOverride].
fr:SlotShape a sh:NodeShape; sh:targetClass fr:SlotDefinition;
 sh:property [sh:path fr:slotKey; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string];
 sh:property [sh:path fr:minimumCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:nonNegativeInteger];
 sh:property [sh:path fr:maximumCount; sh:maxCount 1; sh:datatype xsd:nonNegativeInteger];
 sh:property [sh:path fr:hasMapping; sh:maxCount 1; sh:class fr:SlotMapping].
fr:StepShape a sh:NodeShape; sh:targetClass fr:PathStep;
 sh:property [sh:path fr:position; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:positiveInteger];
 sh:property [sh:path fr:predicateIRI; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:anyURI].
fr:ContractShape a sh:NodeShape; sh:targetClass fr:FrameProjectionSpecification;
 sh:property [sh:path fr:frameDefinition; sh:minCount 1; sh:maxCount 1; sh:class fr:FrameDefinition];
 sh:property [sh:path fr:evidencePolicy; sh:minCount 1; sh:maxCount 1; sh:in ("retain-with-status" "require-allowed-claim")].
fr:ValueShape a sh:NodeShape; sh:targetClass fr:FrameSlotValue;
 sh:property [sh:path fr:fillsSlot; sh:minCount 1; sh:maxCount 1; sh:class fr:SlotDefinition];
 sh:property [sh:path fr:valueOrigin; sh:minCount 1; sh:maxCount 1; sh:in ("source" "default")];
 sh:xone ([sh:property [sh:path fr:entityValue; sh:minCount 1; sh:maxCount 1]; sh:property [sh:path fr:literalValue; sh:maxCount 0]] [sh:property [sh:path fr:literalValue; sh:minCount 1; sh:maxCount 1]; sh:property [sh:path fr:entityValue; sh:maxCount 0]]).
