            n22:path n17:expressionLanguage ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n17:expressionText ] ;
    n22:targetClass n17:ModelEquation .

n17:ModelShape a n22:NodeShape ;
