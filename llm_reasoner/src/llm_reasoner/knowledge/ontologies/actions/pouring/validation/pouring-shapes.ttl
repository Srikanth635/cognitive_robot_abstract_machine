        [ n22:class n17:PropertyKind ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n17:propertyKind ] ;
    n22:targetClass n17:PhysicalPropertySpecification .

n17:StudyShape a n22:NodeShape ;
    n22:property [ n22:class n17:PhysicalModelSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n17:studiesModel ],
        [ n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n17:testsOutcome ] ;
