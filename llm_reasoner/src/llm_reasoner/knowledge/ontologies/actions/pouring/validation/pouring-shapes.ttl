            n22:path n13:targetRegion ] ;
    n22:targetClass n13:ReachingDescription .

n14:HardConditionShape a n22:NodeShape ;
    n22:property [ n22:class n2:BooleanExpression ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:hasExpression ] ;
    n22:targetObjectsOf n4:inputConstraint,
        n4:stateConstraint,
        n14:hardConstraint .

n14:NormalizationShape a n22:NodeShape ;
    n22:property [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n14:scaleParameter ] ;
    n22:targetClass n14:NormalizationSpecification .

n14:SetShape a n22:NodeShape ;
    n22:property [ n22:class ac:ConstraintSpecification ;
            n22:path n14:hardConstraint ],
        [ n22:in ( n14:WeightedSum n14:Lexicographic n14:Pareto ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n14:aggregationPolicy ],
        [ n22:class n14:ObjectiveTerm ;
            n22:minCount 1 ;
            n22:path n14:hasTerm ] ;
    n22:targetClass n14:ObjectiveSet .

n14:TermShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:nonNegativeInteger ;
            n22:maxCount 1 ;
            n22:path n14:rank ],
        [ n22:class n14:NormalizationSpecification ;
            n22:maxCount 1 ;
            n22:path n14:normalizedBy ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n14:metricParameter ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:path n14:weightParameter ],
        [ n22:in ( n14:Minimize n14:Maximize ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n14:direction ] ;
    n22:targetClass n14:ObjectiveTerm .

n15:ArgumentShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:positiveInteger ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n15:argumentPosition ] ;
    n22:targetClass n15:ArgumentDefinition .

n15:BindingShape a n22:NodeShape ;
    n22:property [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n15:bindsEntity ],
        [ n22:class n15:ArgumentDefinition ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n15:bindsArgument ] ;
    n22:targetClass n15:ArgumentBinding .

n15:PatternShape a n22:NodeShape ;
    n22:property [ n22:class n15:RelationDefinition ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n15:usesRelation ],
        [ n22:class n15:ArgumentBinding ;
            n22:minCount 1 ;
            n22:path n15:hasArgumentBinding ] ;
    n22:targetClass n15:RelationPattern .

n15:RelationShape a n22:NodeShape ;
    n22:property [ n22:class n15:ArgumentDefinition ;
            n22:minCount 1 ;
            n22:path n15:hasArgumentDefinition ],
        [ n22:datatype xsd:positiveInteger ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n15:arity ] ;
    n22:targetClass n15:RelationDefinition .

n16:ConditionReferenceShape a n22:NodeShape ;
    n22:property [ n22:class n2:BooleanExpression ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:hasExpression ] ;
    n22:targetObjectsOf n12:monitorsCondition,
        n16:entryCondition,
        n16:exitCondition,
        n16:guardCondition,
        n16:invariantCondition .

n16:PhaseShape a n22:NodeShape ;
    n22:property [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:path n16:exitCondition ],
        [ n22:class n2:OutcomeSpecification ;
            n22:path n16:expectedOutcome ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:path n16:entryCondition ],
        [ n22:class ac:ConditionSpecification ;
            n22:path n16:invariantCondition ] ;
    n22:targetClass ac:PhaseSpecification .

n16:StructureShape a n22:NodeShape ;
    n22:property [ n22:class ac:PhaseSpecification ;
            n22:minCount 1 ;
            n22:path n16:hasMemberPhase ],
        [ n22:class ac:PhaseSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n16:initialPhase ],
        [ n22:class n16:PhaseTransition ;
            n22:path n16:hasTransition ] ;
    n22:targetClass n16:PhaseStructure .

n16:SuccessfulTerminalShape a n22:NodeShape ;
    n22:not [ n22:class n16:FailedTerminalPhase ] ;
    n22:targetClass n16:SuccessfulTerminalPhase .

n16:TransitionShape a n22:NodeShape ;
    n22:property [ n22:class ac:PhaseSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n16:fromPhase ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n16:guardCondition ],
        [ n22:class ac:PhaseSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n16:toPhase ] ;
    n22:targetClass n16:PhaseTransition ;
    n22:xone ( [ n22:class n16:OrdinaryTransition ] [ n22:class n16:FailureTransition ] [ n22:class n16:RecoveryTransition ] ) .

n17:ArtifactShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
