            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n17:symbol ] ;
    n22:targetClass n17:ModelVariable .

n18:CartesianMotionDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class n18:PoseTarget ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n18:poseTarget ] ;
    n22:targetClass n18:CartesianMotionDescription .

n18:ConfigurationMotionDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class n18:ConfigurationTarget ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n18:configurationTarget ] ;
