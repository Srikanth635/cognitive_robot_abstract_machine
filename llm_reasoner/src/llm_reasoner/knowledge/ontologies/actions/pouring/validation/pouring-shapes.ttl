        [ n22:class n13:TargetRegionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 0 ;
            n22:path n13:motionTarget ],
        [ n22:class ac:ActionKind ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:motionKind ] ;
    n22:targetClass n13:ManipulationMotionRequirement .

n13:ObjectManipulationDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:manipulator ],
        [ n22:class n13:ManipulationMotionRequirement ;
            n22:minCount 1 ;
            n22:path n13:requiresMotion ],
        [ n22:class ac:FailureCriterion ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasFailureCriterion ],
        [ n22:class ac:GoalSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasGoal ],
        [ n22:class ac:PreconditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasPrecondition ],
        [ n22:class ac:SuccessCriterion ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasSuccessCriterion ],
        [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:object ],
        [ n22:class ac:CapabilityRequirement ;
            n22:minCount 1 ;
            n22:path ac:hasCapabilityRequirement ] ;
    n22:targetClass n13:ObjectManipulationDescription .

n13:PickupDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:initialSupport ] ;
    n22:targetClass n13:PickupDescription .

n13:PlacementDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class n13:TargetRegionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:targetRegion ],
        [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:destinationSupport ] ;
    n22:targetClass n13:PlacementDescription .

n13:PrimaryManipulationConsistencyShape a n22:NodeShape ;
    n22:property [ n22:class n10:KnowledgeContext ;
            n22:maxCount 1 ;
            n22:path n13:evaluationContext ],
        [ n22:disjoint n13:object ;
            n22:path n13:manipulator ] ;
    n22:sparql [ n22:message "A supplied manipulation context must describe this action." ;
            n22:select "SELECT $this WHERE { $this <http://aicor.knowledge/ontologies/object-manipulation.owl#evaluationContext> ?context . FILTER NOT EXISTS { ?context <http://aicor.knowledge/ontologies/knowledge-context.owl#scopedDescription> $this } }" ] ;
    n22:targetClass n13:ObjectManipulationDescription .

n13:PrimaryPickupConsistencyShape a n22:NodeShape ;
    n22:property [ n22:disjoint n13:manipulator,
                n13:object ;
            n22:path n13:initialSupport ] ;
    n22:targetClass n13:PickupDescription .

n13:PrimaryPlacementConsistencyShape a n22:NodeShape ;
    n22:property [ n22:disjoint n13:manipulator,
                n13:object ;
            n22:path n13:destinationSupport ] ;
    n22:targetClass n13:PlacementDescription .

n13:ReachingDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class n13:TargetRegionSpecification ;
            n22:maxCount 1 ;
