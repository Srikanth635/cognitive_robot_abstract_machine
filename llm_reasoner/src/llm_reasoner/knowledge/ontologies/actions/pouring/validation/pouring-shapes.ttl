@prefix ac: <http://aicor.knowledge/ontologies/action-description-core.owl#> .
@prefix mt: <http://aicor.knowledge/ontologies/material-transfer.owl#> .
@prefix n0: <http://aicor.knowledge/ontologies/capabilities-strategies.owl#> .
@prefix n1: <http://aicor.knowledge/ontologies/causal-mechanisms.owl#> .
@prefix n10: <http://aicor.knowledge/ontologies/knowledge-context.owl#> .
@prefix n11: <http://aicor.knowledge/ontologies/model-contracts.owl#> .
@prefix n12: <http://aicor.knowledge/ontologies/monitoring-requirements.owl#> .
@prefix n13: <http://aicor.knowledge/ontologies/object-manipulation.owl#> .
@prefix n14: <http://aicor.knowledge/ontologies/objectives-tradeoffs.owl#> .
@prefix n15: <http://aicor.knowledge/ontologies/participants-relations.owl#> .
@prefix n16: <http://aicor.knowledge/ontologies/phases-transitions.owl#> .
@prefix n17: <http://aicor.knowledge/ontologies/physical-models.owl#> .
@prefix n18: <http://aicor.knowledge/ontologies/robot-motion.owl#> .
@prefix n19: <http://aicor.knowledge/ontologies/sensorimotor-events.owl#> .
@prefix n2: <http://aicor.knowledge/ontologies/conditions-outcomes.owl#> .
@prefix n20: <http://aicor.knowledge/ontologies/tool-interaction.owl#> .
@prefix n21: <http://aicor.knowledge/ontologies/transfer-contracts.owl#> .
@prefix n22: <http://www.w3.org/ns/shacl#> .
@prefix n3: <http://aicor.knowledge/ontologies/diagnostic-causal-bridge.owl#> .
@prefix n4: <http://aicor.knowledge/ontologies/dynamics-control.owl#> .
@prefix n5: <http://aicor.knowledge/ontologies/entities-materials-affordances.owl#> .
@prefix n6: <http://aicor.knowledge/ontologies/failure-diagnosis.owl#> .
@prefix n7: <http://aicor.knowledge/ontologies/force-dynamics.owl#> .
@prefix n8: <http://aicor.knowledge/ontologies/frame-perspective.owl#> .
@prefix n9: <http://aicor.knowledge/ontologies/image-schemas.owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ac:ActionShape a n22:NodeShape ;
    n22:property [ n22:class ac:ActionKind ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasActionKind ],
        [ n22:class ac:ActionComponent ;
            n22:path ac:hasComponent ] ;
    n22:targetClass ac:ActionDescription .

ac:AnnotationShape a n22:NodeShape ;
    n22:property [ n22:class ac:ActionDescription ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:annotatesDescription ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:producerIdentifier ],
        [ n22:class ac:KnowledgeClaim ;
            n22:minCount 1 ;
            n22:path ac:contributesClaim ],
        [ n22:datatype xsd:dateTime ;
            n22:maxCount 1 ;
            n22:path ac:createdAt ] ;
    n22:targetClass ac:AnnotationRecord .

ac:BindingShape a n22:NodeShape ;
    n22:property [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:bindsSpecification ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:bindingTargetIRI ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:bindingContextIRI ] ;
    n22:targetClass ac:BindingRecord .

ac:ClaimShape a n22:NodeShape ;
    n22:or ( [ n22:property [ n22:in ( ac:Proposed ac:Disputed ac:Rejected ac:Unknown ) ;
                        n22:path ac:hasStatus ] ] [ n22:property [ n22:minCount 1 ;
                        n22:path ac:hasEvidence ] ] ) ;
    n22:property [ n22:class ac:Statement ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasStatement ],
        [ n22:in ( ac:Proposed ac:Supported ac:Disputed ac:Rejected ac:Unknown ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasStatus ],
        [ n22:class ac:EvidenceRecord ;
            n22:path ac:hasEvidence ],
        [ n22:class ac:ActionComponent ;
            n22:minCount 1 ;
            n22:path ac:aboutComponent ] ;
    n22:targetClass ac:KnowledgeClaim .

ac:EvidenceShape a n22:NodeShape ;
    n22:or ( [ n22:property [ n22:datatype xsd:anyURI ;
                        n22:minCount 1 ;
                        n22:path ac:sourceIRI ] ] [ n22:property [ n22:datatype xsd:string ;
                        n22:minCount 1 ;
                        n22:path ac:evidenceText ] ] ) ;
    n22:property [ n22:class ac:EvidenceKind ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:evidenceKind ] ;
    n22:targetClass ac:EvidenceRecord .

ac:ParameterShape a n22:NodeShape ;
    n22:or ( [ n22:property [ n22:maxCount 0 ;
                        n22:path ac:upperBound ],
                    [ n22:maxCount 0 ;
                        n22:path ac:lowerBound ],
                    [ n22:maxCount 0 ;
                        n22:path ac:numericValue ] ] [ n22:property [ n22:minCount 1 ;
                        n22:path ac:unitIRI ] ] ) ;
    n22:property [ n22:datatype xsd:decimal ;
            n22:maxCount 1 ;
            n22:path ac:numericValue ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:parameterKey ],
        [ n22:datatype xsd:decimal ;
            n22:maxCount 1 ;
            n22:path ac:upperBound ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:path ac:unitIRI ],
        [ n22:datatype xsd:decimal ;
            n22:lessThanOrEquals ac:upperBound ;
            n22:maxCount 1 ;
            n22:path ac:lowerBound ] ;
    n22:targetClass ac:ParameterSpecification .

ac:ProjectionShape a n22:NodeShape ;
    n22:property [ n22:class ac:KnowledgeClaim ;
            n22:path ac:includesClaim ],
        [ n22:class ac:ProjectionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:conformsToSpecification ],
        [ n22:class ac:KnowledgeRecord ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:derivedFromRecord ] ;
    n22:sparql [ n22:message "A projection may include only claims present in its source record." ;
            n22:select """
 PREFIX ac: <http://aicor.knowledge/ontologies/action-description-core.owl#>
 SELECT $this WHERE { $this ac:derivedFromRecord ?r; ac:includesClaim ?c . FILTER NOT EXISTS { ?r ac:hasClaim ?c } }
 """ ] ;
    n22:targetClass ac:ProjectionArtifact .

ac:ProjectionSpecificationShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:projectionKey ],
        [ n22:in ( "omit-and-report" "reject" "retain-unknown" ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:missingInformationPolicy ] ;
    n22:targetClass ac:ProjectionSpecification .

ac:RecordShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:recordVersion ],
        [ n22:class ac:ActionDescription ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:expressesDescription ],
        [ n22:class ac:AnnotationRecord ;
            n22:path ac:hasAnnotation ],
        [ n22:class ac:KnowledgeClaim ;
            n22:path ac:hasClaim ],
        [ n22:class ac:BindingRecord ;
            n22:path ac:hasBinding ] ;
    n22:sparql [ n22:message "An annotation must target this record's description and contribute claims present in this record." ;
            n22:select """
 PREFIX ac: <http://aicor.knowledge/ontologies/action-description-core.owl#>
 SELECT $this WHERE {
  $this ac:hasAnnotation ?a; ac:expressesDescription ?d .
  { ?a ac:annotatesDescription ?other . FILTER (?other != ?d) }
  UNION { ?a ac:contributesClaim ?c . FILTER NOT EXISTS { $this ac:hasClaim ?c } }
 }
 """ ] ;
    n22:targetClass ac:KnowledgeRecord .

ac:RoleShape a n22:NodeShape ;
    n22:property [ n22:class ac:EntitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasEntitySpecification ],
        [ n22:class ac:ParticipantRole ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:specifiesRole ] ;
    n22:targetClass ac:RoleSpecification .

ac:StatementShape a n22:NodeShape ;
    n22:property [ n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:nodeKind n22:IRI ;
            n22:path ac:statementSubject ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:statementPredicateIRI ;
            n22:pattern "^[A-Za-z][A-Za-z0-9+.-]*:" ] ;
    n22:targetClass ac:Statement ;
    n22:xone ( [ n22:property [ n22:maxCount 1 ;
                        n22:minCount 1 ;
                        n22:nodeKind n22:IRI ;
                        n22:path ac:statementObject ],
                    [ n22:maxCount 0 ;
                        n22:path ac:statementLiteral ] ] [ n22:property [ n22:maxCount 0 ;
                        n22:path ac:statementObject ],
                    [ n22:maxCount 1 ;
                        n22:minCount 1 ;
                        n22:nodeKind n22:Literal ;
                        n22:path ac:statementLiteral ] ] ) .

n0:AssessmentShape a n22:NodeShape ;
    n22:or ( [ n22:property [ n22:hasValue n0:Undetermined ;
                        n22:path n0:assessmentOutcome ] ] [ n22:property [ n22:minCount 1 ;
                        n22:path n0:assessmentEvidence ] ] ) ;
    n22:property [ n22:class ac:EvidenceRecord ;
            n22:path n0:assessmentEvidence ],
        [ n22:class ac:ApplicabilitySpecification ;
            n22:minCount 1 ;
            n22:path n0:assessmentContext ],
        [ n22:in ( n0:Met n0:Unmet n0:Undetermined ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n0:assessmentOutcome ],
        [ n22:class ac:CapabilityRequirement ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n0:assessesRequirement ] ;
    n22:targetClass n0:CapabilityAssessment .

n0:ProcessShape a n22:NodeShape ;
    n22:property [ n22:class ac:ParameterSpecification ;
            n22:path n0:inputParameter ],
        [ n22:class ac:ParameterSpecification ;
            n22:path n0:outputParameter ],
        [ n22:class ac:CapabilityRequirement ;
            n22:minCount 1 ;
            n22:path n0:fulfillsRequirement ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n0:interfaceKey ] ;
    n22:targetClass n0:ProcessModuleRequirement .

n0:ProfileShape a n22:NodeShape ;
    n22:property [ n22:class ac:CapabilityRequirement ;
            n22:minCount 1 ;
            n22:path n0:requiresCapability ] ;
    n22:targetClass n0:CapabilityProfile .

n0:StepShape a n22:NodeShape ;
    n22:property [ n22:class ac:ActionDescription ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n0:describesAction ],
        [ n22:class n0:ProcessModuleRequirement ;
            n22:minCount 1 ;
            n22:path n0:requiresProcess ],
        [ n22:class n0:StrategyStep ;
            n22:path n0:precedesStep ] ;
    n22:targetClass n0:StrategyStep .

n0:StrategyShape a n22:NodeShape ;
    n22:property [ n22:class n0:StrategyStep ;
            n22:minCount 1 ;
            n22:path n0:hasStep ] ;
    n22:targetClass n0:ExecutionStrategy .

n1:InterventionShape a n22:NodeShape ;
    n22:property [ n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n1:intendedOutcome ] ;
    n22:targetClass n1:InterventionSpecification .

n1:LinkShape a n22:NodeShape ;
    n22:property [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n1:antecedent ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n1:consequent ],
        [ n22:class n1:EnablingCondition ;
            n22:path n1:enablingCondition ],
        [ n22:class n1:MechanismSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n1:mechanism ] ;
    n22:targetClass n1:CausalLink .

n1:MechanismShape a n22:NodeShape ;
    n22:property [ n22:class ac:ApplicabilitySpecification ;
            n22:minCount 1 ;
            n22:path n1:applicability ],
        [ n22:class ac:ConditionSpecification ;
            n22:minCount 1 ;
            n22:path n1:assumption ] ;
    n22:targetClass n1:MechanismSpecification .

n1:ModelShape a n22:NodeShape ;
    n22:property [ n22:class n1:CausalLink ;
            n22:minCount 1 ;
            n22:path n1:hasLink ] ;
    n22:targetClass n1:CausalModel .

n1:SuppressionShape a n22:NodeShape ;
    n22:property [ n22:class n1:CausalLink ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n1:suppressedLink ],
        [ n22:class n1:InterventionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n1:intervention ] ;
    n22:targetClass n1:SuppressionSpecification .

n2:AtomicShape a n22:NodeShape ;
    n22:property [ n22:in ( n2:PreState n2:PostState n2:CurrentState n2:TaskContext ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:inScope ],
        [ n22:class n15:RelationPattern ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:hasPattern ] ;
    n22:targetClass n2:AtomicCondition .

n2:BooleanTypeShape a n22:NodeShape ;
    n22:not [ n22:class n2:ValueExpression ] ;
    n22:targetClass n2:BooleanExpression .

n2:ComparisonShape a n22:NodeShape ;
    n22:property [ n22:class n2:ValueExpression ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:leftOperand ],
        [ n22:in ( n2:Equal n2:NotEqual n2:LessThan n2:LessOrEqual n2:GreaterThan n2:GreaterOrEqual ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:operator ],
        [ n22:class n2:ValueExpression ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:rightOperand ] ;
    n22:targetClass n2:Comparison .

n2:ConditionShape a n22:NodeShape ;
    n22:property [ n22:class n2:BooleanExpression ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:hasExpression ] ;
    n22:targetSubjectsOf n2:hasExpression .

n2:ConstantShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:decimal ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:decimalValue ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:unitIRI ;
            n22:pattern "^[A-Za-z][A-Za-z0-9+.-]*:" ] ;
    n22:targetClass n2:QuantityConstant .

n2:ExpressionShape a n22:NodeShape ;
    n22:targetClass n2:Expression ;
    n22:xone ( [ n22:class n2:AtomicCondition ] [ n22:class n2:Conjunction ] [ n22:class n2:Disjunction ] [ n22:class n2:Negation ] [ n22:class n2:Comparison ] [ n22:class n2:ParameterReference ] [ n22:class n2:QuantityConstant ] ) .

n2:NaryShape a n22:NodeShape ;
    n22:property [ n22:class n2:BooleanExpression ;
            n22:minCount 2 ;
            n22:path n2:hasOperand ] ;
    n22:targetClass n2:Conjunction,
        n2:Disjunction .

n2:NegationShape a n22:NodeShape ;
    n22:property [ n22:class n2:BooleanExpression ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:hasOperand ] ;
    n22:targetClass n2:Negation .

n2:OutcomeShape a n22:NodeShape ;
    n22:property [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:afterCondition ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:beforeCondition ] ;
    n22:targetClass n2:OutcomeSpecification .

n2:ParameterShape a n22:NodeShape ;
    n22:property [ n22:in ( n2:PreState n2:PostState n2:CurrentState n2:TaskContext ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:inScope ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n2:parameter ] ;
    n22:targetClass n2:ParameterReference .

n2:ValueTypeShape a n22:NodeShape ;
    n22:not [ n22:class n2:BooleanExpression ] ;
    n22:targetClass n2:ValueExpression .

n3:Shape a n22:NodeShape ;
    n22:property [ n22:class n6:DiagnosticHypothesis ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n3:hypothesis ],
        [ n22:class n1:CausalLink ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n3:causalLink ],
        [ n22:class ac:ApplicabilitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n3:applicability ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n3:causeCondition ] ;
    n22:sparql [ n22:message "Association cause must match both diagnostic candidate and causal antecedent." ;
            n22:select """
 PREFIX db: <http://aicor.knowledge/ontologies/diagnostic-causal-bridge.owl#>
 PREFIX fd: <http://aicor.knowledge/ontologies/failure-diagnosis.owl#>
 PREFIX cm: <http://aicor.knowledge/ontologies/causal-mechanisms.owl#>
 SELECT $this WHERE {$this db:hypothesis ?h; db:causalLink ?l; db:causeCondition ?c .
 FILTER NOT EXISTS {?h fd:candidateCause ?c . ?l cm:antecedent ?c}}
 """ ] ;
    n22:targetClass n3:DiagnosticCausalAssociation .

n4:AdaptationShape a n22:NodeShape ;
    n22:property [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:updatesParameter ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:validWhen ] ;
    n22:targetClass n4:AdaptationSpecification .

n4:AssignmentShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:positiveInteger ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:dimension ],
        [ n22:datatype xsd:positiveInteger ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:position ],
        [ n22:in ( n4:State n4:Input n4:Output n4:Disturbance ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:role ],
        [ n22:class n17:ModelVariable ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:variable ] ;
    n22:targetClass n4:VariableAssignment .

n4:ControllerShape a n22:NodeShape ;
    n22:property [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:samplingPeriod ],
        [ n22:class n4:ControllerKind ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:controllerKind ],
        [ n22:class n14:ObjectiveSet ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:objectiveSet ],
        [ n22:class n4:DynamicalModelSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n4:controlsModel ] ;
    n22:targetClass n4:ControllerSpecification .

n4:ModelShape a n22:NodeShape ;
    n22:property [ n22:class n4:VariableAssignment ;
            n22:minCount 1 ;
            n22:path n4:hasAssignment ] ;
    n22:targetClass n4:DynamicalModelSpecification .

n6:FailureShape a n22:NodeShape ;
    n22:property [ n22:class n6:FailureKind ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n6:failureKind ],
        [ n22:class ac:FailureCriterion ;
            n22:minCount 1 ;
            n22:path n6:detectedBy ] ;
    n22:targetClass n6:FailureSpecification .

n6:HypothesisShape a n22:NodeShape ;
    n22:property [ n22:class ac:EvidenceRecord ;
            n22:path n6:supportingEvidence ],
        [ n22:class ac:EvidenceRecord ;
            n22:path n6:refutingEvidence ],
        [ n22:class n6:FailureSpecification ;
            n22:minCount 1 ;
            n22:path n6:explainsFailure ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n6:candidateCause ] ;
    n22:targetClass n6:DiagnosticHypothesis .

n6:ProfileShape a n22:NodeShape ;
    n22:property [ n22:class n6:DiagnosticHypothesis ;
            n22:path n6:hasHypothesis ],
        [ n22:class n6:FailureSpecification ;
            n22:minCount 1 ;
            n22:path n6:hasFailure ],
        [ n22:class n6:RecoveryOption ;
            n22:path n6:hasRecoveryOption ] ;
    n22:targetClass n6:FailureProfile .

n6:RecoveryShape a n22:NodeShape ;
    n22:property [ n22:class n0:ExecutionStrategy ;
            n22:maxCount 1 ;
            n22:path n6:usesStrategy ],
        [ n22:class ac:CapabilityRequirement ;
            n22:minCount 1 ;
            n22:path n6:requiresCapability ],
        [ n22:class n6:FailureSpecification ;
            n22:minCount 1 ;
            n22:path n6:addressesFailure ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n6:guardedBy ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n6:restoresCondition ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:path n6:retryBudget ] ;
    n22:targetClass n6:RecoveryOption .

n8:ContractShape a n22:NodeShape ;
    n22:property [ n22:class n8:FrameDefinition ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:frameDefinition ],
        [ n22:in ( "retain-with-status" "require-allowed-claim" ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:evidencePolicy ] ;
    n22:targetClass n8:FrameProjectionSpecification .

n8:FrameShape a n22:NodeShape ;
    n22:property [ n22:class n8:FrameDefinition ;
            n22:maxCount 1 ;
            n22:path n8:parentFrame ],
        [ n22:class n8:SlotDefinition ;
            n22:path n8:hasSlot ],
        [ n22:class n8:SlotOverride ;
            n22:path n8:hasOverride ] ;
    n22:targetClass n8:FrameDefinition .

n8:SlotShape a n22:NodeShape ;
    n22:property [ n22:class n8:SlotMapping ;
            n22:maxCount 1 ;
            n22:path n8:hasMapping ],
        [ n22:datatype xsd:nonNegativeInteger ;
            n22:maxCount 1 ;
            n22:path n8:maximumCount ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:slotKey ],
        [ n22:datatype xsd:nonNegativeInteger ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:minimumCount ] ;
    n22:targetClass n8:SlotDefinition .

n8:StepShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:positiveInteger ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:position ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:predicateIRI ] ;
    n22:targetClass n8:PathStep .

n8:ValueShape a n22:NodeShape ;
    n22:property [ n22:in ( "source" "default" ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:valueOrigin ],
        [ n22:class n8:SlotDefinition ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n8:fillsSlot ] ;
    n22:targetClass n8:FrameSlotValue ;
    n22:xone ( [ n22:property [ n22:maxCount 0 ;
                        n22:path n8:literalValue ],
                    [ n22:maxCount 1 ;
                        n22:minCount 1 ;
                        n22:path n8:entityValue ] ] [ n22:property [ n22:maxCount 1 ;
                        n22:minCount 1 ;
                        n22:path n8:literalValue ],
                    [ n22:maxCount 0 ;
                        n22:path n8:entityValue ] ] ) .

n10:AssessmentShape a n22:NodeShape ;
    n22:property [ n22:class ac:EvidenceRecord ;
            n22:path n10:usesEvidence ],
        [ n22:in ( ac:Proposed ac:Supported ac:Disputed ac:Rejected ac:Unknown ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:assessedStatus ],
        [ n22:class ac:KnowledgeRecord ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:inRecord ],
        [ n22:class ac:KnowledgeClaim ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:assessesClaim ],
        [ n22:datatype xsd:dateTime ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:assessedAt ;
            n22:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ],
        [ n22:class n10:KnowledgeContext ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:inContext ],
        [ n22:datatype xsd:dateTime ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:validUntil ;
            n22:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ],
        [ n22:datatype xsd:dateTime ;
            n22:lessThan n10:validUntil ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:validFrom ;
            n22:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
    n22:sparql [ n22:message "Assessment claim must belong to its record and context must describe that record's action." ;
            n22:select """
 PREFIX kc: <http://aicor.knowledge/ontologies/knowledge-context.owl#>
 PREFIX ac: <http://aicor.knowledge/ontologies/action-description-core.owl#>
 SELECT $this WHERE {$this kc:inRecord ?r; kc:assessesClaim ?c; kc:inContext ?ctx .
 {FILTER NOT EXISTS {?r ac:hasClaim ?c}} UNION
 {?ctx kc:scopedDescription ?d . FILTER NOT EXISTS {?r ac:expressesDescription ?d}}}
 """ ],
        [ n22:message "Supported assessment requires explicit evidence." ;
            n22:select """
 PREFIX kc: <http://aicor.knowledge/ontologies/knowledge-context.owl#>
 PREFIX ac: <http://aicor.knowledge/ontologies/action-description-core.owl#>
 SELECT $this WHERE {$this kc:assessedStatus ac:Supported . FILTER NOT EXISTS {$this kc:usesEvidence ?e}}
 """ ] ;
    n22:targetClass n10:ClaimAssessment .

n10:ContextShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:contextKey ],
        [ n22:class ac:ActionDescription ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:scopedDescription ] ;
    n22:targetClass n10:KnowledgeContext .

n10:DigestShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:sha256 ;
            n22:pattern "^[0-9a-f]{64}$" ] ;
    n22:targetSubjectsOf n10:sha256 .

n10:ObservationShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:dateTime ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:observedAt ;
            n22:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
    n22:targetClass n10:ObservationEvidence .

n10:SnapshotShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:serializationProfile ],
        [ n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:sha256 ],
        [ n22:class ac:KnowledgeRecord ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:snapshotOf ] ;
    n22:targetClass n10:RecordSnapshot .

n10:SourceShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:sourceIRI ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:selector ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n10:sourceVersion ] ;
    n22:targetClass n10:SourceSnapshot .

mt:CompleteTransferDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path mt:residualTolerance ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path mt:residualAmount ] ;
    n22:targetClass mt:CompleteTransferDescription .

mt:MaterialTransferDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class ac:PreconditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasPrecondition ],
        [ n22:class ac:SuccessCriterion ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasSuccessCriterion ],
        [ n22:class n10:KnowledgeContext ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path mt:evaluationContext ],
        [ n22:class ac:FailureCriterion ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasFailureCriterion ],
        [ n22:class ac:GoalSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path ac:hasGoal ],
        [ n22:class n21:TransferContract ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n21:hasTransferContract ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path mt:quantityBasis ] ;
    n22:targetClass mt:MaterialTransferDescription .

mt:PrimaryTransferConsistencyShape a n22:NodeShape ;
    n22:property [ n22:in ( "volume" "mass" "volume"^^xsd:string "mass"^^xsd:string ) ;
            n22:path mt:quantityBasis ] ;
    n22:sparql [ n22:message "The transfer context must describe this action." ;
            n22:select "SELECT $this WHERE { $this <http://aicor.knowledge/ontologies/material-transfer.owl#evaluationContext> ?context . FILTER NOT EXISTS { ?context <http://aicor.knowledge/ontologies/knowledge-context.owl#scopedDescription> $this } }" ] ;
    n22:targetClass mt:MaterialTransferDescription .

n11:EquationShape a n22:NodeShape ;
    n22:property [ n22:class ac:ApplicabilitySpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:scope ],
        [ n22:class n11:EquationTerm ;
            n22:minCount 1 ;
            n22:path n11:hasTerm ],
        [ n22:class n17:ModelEquation ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:equation ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:resultParameter ] ;
    n22:targetClass n11:AdditiveEquationContract .

n11:QuantityShape a n22:NodeShape ;
    n22:property [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:parameter ],
        [ n22:datatype xsd:anyURI ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:unitIRI ],
        [ n22:datatype xsd:string ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:dimensionVector ;
            n22:pattern "^-?[0-9]+( -?[0-9]+){6}$" ] ;
    n22:targetClass n11:QuantityContract .

n11:TermShape a n22:NodeShape ;
    n22:property [ n22:datatype xsd:decimal ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:coefficient ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n11:termParameter ] ;
    n22:targetClass n11:EquationTerm .

n12:MonitorShape a n22:NodeShape ;
    n22:property [ n22:class n12:ObservationRequirement ;
            n22:path n12:requiresObservation ],
        [ n22:in ( n12:RequestEvidence n12:RequestSuspension n12:ReportUnknown ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:whenUnknown ],
        [ n22:in ( n12:PhaseEntry n12:DuringPhase n12:PhaseExit n12:TransitionCheck ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:atPoint ],
        [ n22:class n12:MonitoringResponse ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:whenFalse ],
        [ n22:class n12:MonitoringResponse ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:whenTrue ],
        [ n22:class ac:ConditionSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:monitorsCondition ] ;
    n22:targetClass n12:MonitoringRequirement .

n12:ObservationShape a n22:NodeShape ;
    n22:property [ n22:class ac:CapabilityRequirement ;
            n22:path n12:requiresCapability ],
        [ n22:in ( n2:PreState n2:PostState n2:CurrentState n2:TaskContext ) ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:inScope ] ;
    n22:targetClass n12:ObservationRequirement ;
    n22:xone ( [ n22:class n12:RelationObservation ] [ n22:class n12:QuantityObservation ] ) .

n12:QuantityObservationShape a n22:NodeShape ;
    n22:property [ n22:maxCount 0 ;
            n22:path n12:observesPattern ],
        [ n22:class ac:ParameterSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:observesParameter ] ;
    n22:targetClass n12:QuantityObservation .

n12:RelationObservationShape a n22:NodeShape ;
    n22:property [ n22:maxCount 0 ;
            n22:path n12:observesParameter ],
        [ n22:class n15:RelationPattern ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n12:observesPattern ] ;
    n22:targetClass n12:RelationObservation .

n13:FixationDescriptionShape a n22:NodeShape ;
    n22:property [ n22:class n18:FrameSpecification ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:anchorFrame ],
        [ n22:class n10:KnowledgeContext ;
            n22:maxCount 1 ;
            n22:minCount 1 ;
            n22:path n13:evaluationContext ] ;
    n22:targetClass n13:FixationDescription .

n13:HoldingDescriptionShape a n22:NodeShape ;
