        <http://aicor.knowledge/ontologies/perception-attention.owl>,
        <http://aicor.knowledge/ontologies/pouring-tool-bridge.owl>,
        <http://aicor.knowledge/ontologies/robot-motion.owl>,
        <http://aicor.knowledge/ontologies/specialized-tool-interactions.owl>,
        <http://aicor.knowledge/ontologies/tool-interaction.owl>,
        <http://aicor.knowledge/ontologies/transport-carrying.owl> ;
    owl:versionInfo "0.20.0" .

