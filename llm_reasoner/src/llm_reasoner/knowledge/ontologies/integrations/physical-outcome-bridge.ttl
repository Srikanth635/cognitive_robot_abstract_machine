@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://aicor.knowledge/ontologies/physical-models.owl#testsOutcome> a owl:ObjectProperty ;
    rdfs:label "Tests Outcome"@en ;
    rdfs:comment "Outcome to investigate."@en ;
    rdfs:domain <http://aicor.knowledge/ontologies/physical-models.owl#SimulationStudySpecification> ;
    rdfs:range <http://aicor.knowledge/ontologies/conditions-outcomes.owl#OutcomeSpecification> .

<http://aicor.knowledge/ontologies/physical-outcome-bridge.owl> a owl:Ontology ;
    rdfs:label "Physical outcome bridge"@en ;
    owl:imports <http://aicor.knowledge/ontologies/conditions-outcomes.owl>,
        <http://aicor.knowledge/ontologies/physical-models.owl> ;
    owl:versionInfo "0.6.0" .

