@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://aicor.knowledge/ontologies/material-transfer.owl#usesToolInteraction> a owl:ObjectProperty ;
    rdfs:label "Uses tool interaction"@en ;
    rdfs:domain <http://aicor.knowledge/ontologies/material-transfer.owl#PouringDescription> ;
    rdfs:range <http://aicor.knowledge/ontologies/tool-interaction.owl#ToolUseDescription> .

<http://aicor.knowledge/ontologies/pouring-tool-bridge.owl> a owl:Ontology ;
    rdfs:label "Pouring tool bridge"@en ;
    owl:imports <http://aicor.knowledge/ontologies/material-transfer.owl>,
        <http://aicor.knowledge/ontologies/tool-interaction.owl> ;
    owl:versionInfo "0.17.0" .

