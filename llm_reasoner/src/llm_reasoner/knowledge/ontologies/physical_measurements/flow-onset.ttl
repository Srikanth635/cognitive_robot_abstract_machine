@prefix :      <http://www.ease-crc.org/ont/llm_reasoner/physical-measurements/flow-onset#> .
@prefix core:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/core#> .
@prefix ac:    <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core#> .
@prefix pour:  <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/pouring#> .
@prefix pf:    <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/pouring-frame#> .
@prefix aicor: <http://aicor.knowledge/l2-ontology.owl#> .
@prefix dul:   <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://www.ease-crc.org/ont/llm_reasoner/physical-measurements/flow-onset> a owl:Ontology ;
    owl:versionIRI <http://www.ease-crc.org/ont/llm_reasoner/physical-measurements/flow-onset/0.3.0> ;
    owl:versionInfo "0.3.0" ;
    owl:imports <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/core> ,
        <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/pouring-frame> ;
    rdfs:label "Physical measurements: flow onset"@en ;
    rdfs:comment """The tilt at which a substance starts to leave a kind of container, as derived from the container's shape or measured in a physics simulation; never generated by a language model."""@en .

# %% annotations

:measuresQuantityOf a owl:AnnotationProperty ;
    rdfs:label "measures quantity of"@en ;
    rdfs:comment "The class of the knowledge vocabulary whose quantity a measurement gives a value for."@en .

# %% measurements

:FlowOnsetTiltMeasurement a owl:Class ;
    rdfs:subClassOf aicor:dul_Description , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :measuredForContainer ; owl:someValuesFrom :ContainerModel ] ,
        [ a owl:Restriction ; owl:onProperty :atFillFraction ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty pf:hasMaterialRegime ; owl:someValuesFrom pf:MaterialRegime ] ,
        [ a owl:Restriction ; owl:onProperty :gravityAzimuth ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :hasMeasuredRange ; owl:someValuesFrom core:MagnitudeRange ] ,
        [ a owl:Restriction ; owl:onProperty :hasMeasuredRange ; owl:allValuesFrom [ a owl:Restriction ; owl:onProperty core:hasUnit ; owl:allValuesFrom [ a owl:Restriction ; owl:onProperty ac:measuresDimension ; owl:hasValue ac:Angle ] ] ] ,
        [ a owl:Restriction ; owl:onProperty :followsSetup ; owl:someValuesFrom :MeasurementSetup ] ;
    rdfs:label "flow onset tilt measurement"@en ;
    rdfs:comment "The tilt from upright at which a substance filling a kind of container to a fraction starts to leave it, for gravity pulling from one direction in the container's own frame."@en ;
    :measuresQuantityOf pour:FlowOnsetThreshold ;
    core:evidenceStatus core:EngineeringExtension .

:measuredForContainer a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:range :ContainerModel ;
    rdfs:label "measured for container"@en ;
    rdfs:comment "The kind of container the measurement is about."@en .
:atFillFraction a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "at fill fraction"@en ;
    rdfs:comment "The substance's volume over the volume the container holds when upright, filled to its lowest lip; between 0 and 1."@en .
:gravityAzimuth a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "gravity azimuth"@en ;
    rdfs:comment "The direction, in degrees from the container's own x axis about its own up axis, toward which the container is tilted; at least 0 and below 360."@en .
:hasMeasuredRange a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:range core:MagnitudeRange ;
    rdfs:label "has measured range"@en ;
    rdfs:comment "The tilt from upright at which the substance starts to leave the container: one value for a derivation, the lowest and highest over the runs of a simulation."@en .
:followsSetup a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:range :MeasurementSetup ;
    rdfs:label "follows setup"@en ;
    rdfs:comment "How the value was obtained, with every setting that decided it."@en .

# %% containers

:ContainerModel a owl:Class ;
    rdfs:subClassOf aicor:dul_InformationObject , dul:InformationObject ,
        [ a owl:Restriction ; owl:onProperty :meshDigest ; owl:someValuesFrom xsd:string ] ,
        [ a owl:Restriction ; owl:onProperty :meshFileName ; owl:someValuesFrom xsd:string ] ;
    rdfs:label "container model"@en ;
    rdfs:comment "The shape of a kind of container, given by the mesh file every container of that kind is built from."@en ;
    core:evidenceStatus core:EngineeringExtension .

:meshDigest a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "mesh digest"@en ;
    rdfs:comment "The SHA-256 digest of the mesh file's bytes, in hexadecimal, which identifies the shape."@en .
:meshFileName a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "mesh file name"@en ;
    rdfs:comment "The name of the mesh file, for a reader; the digest identifies the shape."@en .

# %% setups

:MeasurementSetup a owl:Class ;
    rdfs:subClassOf aicor:dul_Description , dul:Description ;
    rdfs:label "measurement setup"@en ;
    rdfs:comment "How a measurement's value was obtained."@en ;
    core:evidenceStatus core:EngineeringExtension .

:GeometricDerivationSetup a owl:Class ;
    rdfs:subClassOf :MeasurementSetup ,
        [ a owl:Restriction ; owl:onProperty :voxelPitch ; owl:someValuesFrom xsd:double ] ;
    rdfs:label "geometric derivation setup"@en ;
    rdfs:comment "A value derived from the container's shape alone, for a liquid at rest whose surface stays level as the container tilts."@en ;
    core:evidenceStatus core:EngineeringExtension .

:voxelPitch a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "voxel pitch"@en ;
    rdfs:comment "The edge, in metres, of the cubes the container's shape was divided into."@en .

:PhysicsSimulationSetup a owl:Class ;
    rdfs:subClassOf :MeasurementSetup ,
        [ a owl:Restriction ; owl:onProperty :simulationEngine ; owl:someValuesFrom xsd:string ] ,
        [ a owl:Restriction ; owl:onProperty :simulationEngineVersion ; owl:someValuesFrom xsd:string ] ,
        [ a owl:Restriction ; owl:onProperty :particleSpacing ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :tiltRate ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :timeStep ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :runCount ; owl:someValuesFrom xsd:positiveInteger ] ,
        [ a owl:Restriction ; owl:onProperty :onsetParticleCount ; owl:someValuesFrom xsd:positiveInteger ] ,
        [ a owl:Restriction ; owl:onProperty :fluidViscosity ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :fluidCohesion ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :fluidSurfaceTension ; owl:someValuesFrom xsd:double ] ,
        [ a owl:Restriction ; owl:onProperty :hasSettledFillRange ; owl:someValuesFrom core:MagnitudeRange ] ,
        [ a owl:Restriction ; owl:onProperty :hasSettledFillRange ; owl:allValuesFrom [ a owl:Restriction ; owl:onProperty core:hasUnit ; owl:allValuesFrom [ a owl:Restriction ; owl:onProperty ac:measuresDimension ; owl:hasValue ac:Dimensionless ] ] ] ;
    rdfs:label "physics simulation setup"@en ;
    rdfs:comment "A value measured by tilting the container, filled with simulated particles, at a constant rate until the particles start to leave it."@en ;
    core:evidenceStatus core:EngineeringExtension .

:simulationEngine a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "simulation engine"@en ;
    rdfs:comment "The physics engine that simulated the substance."@en .
:simulationEngineVersion a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "simulation engine version"@en ;
    rdfs:comment "The version of the physics engine."@en .
:particleSpacing a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "particle spacing"@en ;
    rdfs:comment "The distance, in metres, between neighbouring particles of the substance at rest."@en .
:tiltRate a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "tilt rate"@en ;
    rdfs:comment "The constant rate, in degrees per second, at which the container was tilted."@en .
:timeStep a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "time step"@en ;
    rdfs:comment "The simulated time, in seconds, the engine advanced per step."@en .
:runCount a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:positiveInteger ;
    rdfs:label "run count"@en ;
    rdfs:comment "How many times the tilt was simulated from the same start."@en .
:onsetParticleCount a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:positiveInteger ;
    rdfs:label "onset particle count"@en ;
    rdfs:comment "How many particles had to be outside the container for the substance to count as leaving it."@en .
:fluidViscosity a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "fluid viscosity"@en ;
    rdfs:comment "The engine's viscosity setting of the simulated substance."@en .
:fluidCohesion a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "fluid cohesion"@en ;
    rdfs:comment "The engine's cohesion setting of the simulated substance."@en .
:fluidSurfaceTension a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "fluid surface tension"@en ;
    rdfs:comment "The engine's surface tension setting of the simulated substance."@en .
:hasSettledFillRange a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:range core:MagnitudeRange ;
    rdfs:label "has settled fill range"@en ;
    rdfs:comment "The fill fraction the particles took up once they had settled upright, lowest and highest over the runs."@en .
