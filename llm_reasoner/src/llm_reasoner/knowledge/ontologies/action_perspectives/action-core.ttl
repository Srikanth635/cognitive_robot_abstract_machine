@prefix :      <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core#> .
@prefix aicor: <http://aicor.knowledge/l2-ontology.owl#> .
@prefix dul:   <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core> a owl:Ontology ;
    owl:versionIRI <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core/0.16.0> ;
    owl:versionInfo "0.16.0" ;
    owl:imports <http://aicor.knowledge/l2-ontology.owl> , <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:label "Action perspectives: action core"@en ;
    rdfs:comment """The hub every perspective on an action attaches to: the frame of a kind of action, the slots its participants fill, what it is for, what it brings about and the kinds of choice it leaves open.

A perspective, such as the action frame, the image schemas or predictive control, describes the action in terms of the core's slots and parameter dimensions and never in terms of another perspective. The resolver grounds a slot in an individual of the world through a CRAM-AICOR role binding, and maps the slots and parameter dimensions to the fields of an action designator.

Each concept is linked to CRAM-AICOR and to DUL: frames are descriptions, slots are CRAM-AICOR role slots specialising its participant roles, an objective is a CRAM-AICOR telos, a consequence a CRAM-AICOR effect, and a parameter dimension a DUL parameter in CRAM-AICOR's action parameter space. Axioms are read under the open-world assumption."""@en .

# %% annotations

:isOpenValuePartition a owl:AnnotationProperty ;
    rdfs:label "is open value partition"@en ;
    rdfs:comment "States, when true, that a class is an open value partition: its members are the named individuals any module states belong to it, and a module adding members states them distinct from the members of the modules it imports. A class whose members are fixed by its definition lists them with owl:oneOf instead."@en .

# %% frames

:ActionFrame a owl:Class ;
    rdfs:subClassOf aicor:dul_Description , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom :ParticipantSlot ] ,
        [ a owl:Restriction ; owl:onProperty :statesObjective ; owl:someValuesFrom :Objective ] ;
    rdfs:label "action frame"@en ;
    rdfs:comment "The frame of a kind of action: the slots its participants fill, what it is for, what it brings about and the kinds of choice it leaves open. Every perspective on the action refers to the slots its frame defines."@en .

:ManipulationActionFrame a owl:Class ;
    rdfs:subClassOf :ActionFrame , aicor:ManipulationFrame ;
    rdfs:label "manipulation action frame"@en ;
    rdfs:comment "The frame of an action that manipulates objects, which CRAM-AICOR calls a manipulation frame; an action that manipulates nothing, such as moving the robot's base, has a frame that is not one."@en .

:framesAction a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range aicor:ManipulationActionCategory ;
    rdfs:domain :ActionFrame ;
    rdfs:label "frames action"@en ;
    rdfs:comment "The kind of action the frame describes, as the IRI of a CRAM-AICOR action category, such as aicor:Pouring."@en .

:definesSlot a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:defines ;
    rdfs:domain :ActionFrame ;
    rdfs:range :FrameSlot ;
    rdfs:label "defines slot"@en ;
    rdfs:comment "A slot of the frame, which a participant of the action, or a part of one, fills."@en .

:statesObjective a owl:ObjectProperty ;
    rdfs:domain :ActionFrame ;
    rdfs:range :Objective ;
    rdfs:label "states objective"@en ;
    rdfs:comment "What the action is for."@en .

:bringsAbout a owl:ObjectProperty ;
    rdfs:domain :ActionFrame ;
    rdfs:range :Consequence ;
    rdfs:label "brings about"@en ;
    rdfs:comment "A change the action makes to one of its participants."@en .

:leavesOpen a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:defines ;
    rdfs:domain :ActionFrame ;
    rdfs:range :ParameterDimension ;
    rdfs:label "leaves open"@en ;
    rdfs:comment "A kind of choice the frame does not settle, which whoever performs the action makes."@en .

# %% slots

:FrameSlot a owl:Class ;
    rdfs:subClassOf aicor:RoleSlot ;
    rdfs:label "frame slot"@en ;
    rdfs:comment "A place in a frame that something taking part in the action fills; a CRAM-AICOR role binding binds an individual of the world to it."@en .

:ParticipantSlot a owl:Class ;
    rdfs:subClassOf :FrameSlot ;
    rdfs:label "participant slot"@en ;
    rdfs:comment "A slot that a participant of the action fills as a whole, such as the source of a pour."@en .

:PartSlot a owl:Class ;
    rdfs:subClassOf :FrameSlot ,
        [ a owl:Restriction ; owl:onProperty :isPartOfSlot ; owl:someValuesFrom :ParticipantSlot ] ;
    rdfs:label "part slot"@en ;
    rdfs:comment "A slot that a part of a participant fills, which the action involves on its own, such as the lip of the source of a pour or the opening of its goal."@en .

[ a owl:AllDisjointClasses ; owl:members ( :ParticipantSlot :PartSlot ) ] .

:isPartOfSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :PartSlot ;
    rdfs:range :ParticipantSlot ;
    rdfs:label "is part of slot"@en ;
    rdfs:comment "The participant slot whose filler the part belongs to."@en .

:AgentSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:AgentRole ;
    rdfs:label "agent slot"@en ;
    rdfs:comment "The slot of the one who performs the action."@en .

:SourceSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:SourceRole ;
    rdfs:label "source slot"@en ;
    rdfs:comment "The slot of where something the action moves comes from, such as the container poured from."@en .

:SubstanceSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:SubstanceRole ;
    rdfs:label "substance slot"@en ;
    rdfs:comment "The slot of the material the action moves, as distinct from what holds it."@en .

:GoalSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:GoalRole ;
    rdfs:label "goal slot"@en ;
    rdfs:comment "The slot of where what the action moves ends up, such as the container poured into."@en .

:InstrumentSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:InstrumentRole ;
    rdfs:label "instrument slot"@en ;
    rdfs:comment "The slot of a tool the agent acts with on something else."@en .

:PatientSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:PatientRole ;
    rdfs:label "patient slot"@en ;
    rdfs:comment "The slot of what the action acts on and changes."@en .

# %% what the action is for and brings about

:Objective a owl:Class ;
    rdfs:subClassOf aicor:Telos ,
        [ a owl:Restriction ; owl:onProperty :concernsSlot ; owl:someValuesFrom :FrameSlot ] ;
    rdfs:label "objective"@en ;
    rdfs:comment "What an action is for: a state of its participants it aims at, which CRAM-AICOR calls a telos."@en .

:concernsSlot a owl:ObjectProperty ;
    rdfs:domain :Objective ;
    rdfs:range :FrameSlot ;
    rdfs:label "concerns slot"@en ;
    rdfs:comment "A slot whose filler the objective is about."@en .

:aimsAtState a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range aicor:DiscreteMode ;
    rdfs:domain :Objective ;
    rdfs:label "aims at state"@en ;
    rdfs:comment "The state the objective aims at, as the IRI of a CRAM-AICOR state type, such as aicor:AccumulatedState."@en .

:Consequence a owl:Class ;
    rdfs:subClassOf aicor:Effect , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :affectsSlot ; owl:someValuesFrom :FrameSlot ] ;
    rdfs:label "consequence"@en ;
    rdfs:comment "A change an action makes to one of its participants, intended or not, such as the source of a pour holding less, which CRAM-AICOR calls an effect."@en .

:affectsSlot a owl:ObjectProperty ;
    rdfs:domain :Consequence ;
    rdfs:range :FrameSlot ;
    rdfs:label "affects slot"@en ;
    rdfs:comment "A slot whose filler the consequence changes."@en .

:resultsInState a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range aicor:DiscreteMode ;
    rdfs:domain :Consequence ;
    rdfs:label "results in state"@en ;
    rdfs:comment "The state the filler is in afterwards, as the IRI of a CRAM-AICOR state type, such as aicor:ContainedState."@en .

# %% the choices an action leaves open

:SlotQuantity a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ,
        [ a owl:Restriction ; owl:onProperty :aboutSlot ; owl:someValuesFrom :FrameSlot ] ,
        [ a owl:Restriction ; owl:onProperty :hasQuantityKind ; owl:someValuesFrom :QuantityKind ] ;
    rdfs:label "slot quantity"@en ;
    rdfs:comment "A kind of quantity about the filler of a slot, possibly measured from the filler of another slot or acting between it and the fillers of others, such as the tilt of the source, the height of the lip above the goal or the grip force on the source; it carries no value of its own. What it is for is said by its class: a choice the action leaves open, a quantity deciding whether a relation holds, one a failure is noticed by, or a parameter of a phase, which holds a value."@en .

:ParameterDimension a owl:Class ;
    rdfs:subClassOf :SlotQuantity , dul:Parameter , aicor:ActionParameterSpace ;
    rdfs:label "parameter dimension"@en ;
    rdfs:comment "A kind of choice an action leaves open, independent of any designator: how much, how fast, where relative to another participant, which way something faces, how far or how long, or which of several. A designator's field is one way of making the choice."@en .

:aboutSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :SlotQuantity ;
    rdfs:range :FrameSlot ;
    rdfs:label "about slot"@en ;
    rdfs:comment "The slot whose filler the quantity is about, such as the source whose orientation is chosen."@en .

:relativeToSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :SlotQuantity ;
    rdfs:range :FrameSlot ;
    rdfs:label "relative to slot"@en ;
    rdfs:comment "The slot whose filler the quantity is measured from, such as the goal a position above which is chosen, or the opening the lip ends beside; absent for a quantity measured from nothing in particular."@en .

:quantityInvolvesSlot a owl:ObjectProperty ;
    rdfs:domain :SlotQuantity ;
    rdfs:range :FrameSlot ;
    rdfs:label "quantity involves slot"@en ;
    rdfs:comment "Another slot whose filler the quantity acts between the first filler and, such as the effector a grip force on the source is exerted by, or the goal a transferred amount ends up in; unlike relative_to_slot, it is no reference the quantity is measured from."@en .

:hasQuantityKind a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :QuantityKind ;
    rdfs:label "has quantity kind"@en ;
    rdfs:comment "What kind of quantity something about an action is about, such as the quantity a choice sets, a condition constrains or a change changes."@en .

:hasPhysicalDimension a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :SlotQuantity ;
    rdfs:range :PhysicalDimension ;
    rdfs:label "has physical dimension"@en ;
    rdfs:comment "The physical dimension a quantity is measured in, which one of its kind's dimensions is and the unit of its value measures."@en .

# %% conditions on slots

:SlotConditionType a owl:Class ;
    rdfs:subClassOf aicor:dul_Description , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :conditionOnSlot ; owl:someValuesFrom :FrameSlot ] ;
    rdfs:label "slot condition type"@en ;
    rdfs:comment "A kind of condition a world can check about the filler of a slot, possibly in relation to the fillers of other slots, such as having a part, affording something or being in a state, rather than membership of a class. Whether it holds, or must hold, is said by what states or uses it."@en .

:SlotCondition a owl:Class ;
    rdfs:subClassOf :SlotConditionType ,
        [ a owl:Restriction ; owl:onProperty :hasPolarity ; owl:someValuesFrom :ConditionPolarity ] ;
    rdfs:label "slot condition"@en ;
    rdfs:comment "A slot condition type stated as holding or not holding, such as the source not being empty. Whether it is required or observed is said by the property relating it to what uses it."@en .

:StateCondition a owl:Class ;
    rdfs:subClassOf :SlotCondition ,
        [ a owl:Restriction ; owl:onProperty :conditionHasState ; owl:someValuesFrom owl:Thing ] ;
    rdfs:label "state condition"@en ;
    rdfs:comment "A condition that the filler of a slot, possibly in relation to the filler of another slot, is in a given discrete state, such as the agent grasping the source or the substance being contained in the goal; with the polarity that it does not hold, that it is not in that state, such as the source being empty: the substance not contained in it."@en .

:conditionOnSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dul:usesConcept ;
    rdfs:domain :SlotConditionType ;
    rdfs:range :FrameSlot ;
    rdfs:label "condition on slot"@en ;
    rdfs:comment "The slot whose filler the condition is about."@en .

:conditionInvolvesSlot a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:usesConcept ;
    rdfs:domain :SlotConditionType ;
    rdfs:range :FrameSlot ;
    rdfs:label "condition involves slot"@en ;
    rdfs:comment "Another slot whose filler the condition relates the first filler to, such as the agent in the condition that the source is held, or the opening in the condition that the lip is over it."@en .

:conditionHasState a owl:ObjectProperty ;
    rdfs:range aicor:DiscreteMode ;
    rdfs:domain :StateCondition ;
    rdfs:label "condition has state"@en ;
    rdfs:comment "The state the filler is in when the condition holds, as the IRI of a CRAM-AICOR state type, such as aicor:GraspedState or aicor:FlowingState."@en .

:hasPolarity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :ConditionPolarity ;
    rdfs:label "has polarity"@en ;
    rdfs:comment "Whether the condition holds or does not hold, or must or must not."@en .

# %% failures

:ActionFailure a owl:Class ;
    rdfs:subClassOf aicor:FailureDescription ;
    rdfs:label "action failure"@en ;
    rdfs:comment "A way an action can go wrong, which a perspective describes and an event or an observation can signal."@en .

:signalsFailure a owl:ObjectProperty ;
    rdfs:range :ActionFailure ;
    rdfs:label "signals failure"@en ;
    rdfs:comment "A way the action goes wrong that the event or the observation signals."@en .

# %% value partitions

:QuantityKind a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    :isOpenValuePartition true ;
    rdfs:label "quantity kind"@en ;
    rdfs:comment "What a quantity about the filler of a slot is: how much, how fast, where, which way it faces, how far, how long, how strongly it acts, a property of its material, a ratio, its shape, or which of several."@en .
:Amount a owl:NamedIndividual , :QuantityKind ; rdfs:label "amount"@en ;
    rdfs:comment "How much of something, such as the volume poured."@en .
:Rate a owl:NamedIndividual , :QuantityKind ; rdfs:label "rate"@en ;
    rdfs:comment "How fast something changes, such as the flow or the tilting."@en .
:Position a owl:NamedIndividual , :QuantityKind ; rdfs:label "position"@en ;
    rdfs:comment "Where something is, such as where the lip is over the goal."@en .
:Orientation a owl:NamedIndividual , :QuantityKind ; rdfs:label "orientation"@en ;
    rdfs:comment "Which way something faces, such as how far the source is tilted."@en .
:Distance a owl:NamedIndividual , :QuantityKind ; rdfs:label "distance"@en ;
    rdfs:comment "How far apart two things are, such as the height of the lip above the goal."@en .
:Duration a owl:NamedIndividual , :QuantityKind ; rdfs:label "duration"@en ;
    rdfs:comment "How long something lasts."@en .
:Selection a owl:NamedIndividual , :QuantityKind ; rdfs:label "selection"@en ;
    rdfs:comment "Which of several alternatives is taken, such as the hand that holds the source."@en .
:Magnitude a owl:NamedIndividual , :QuantityKind ; rdfs:label "magnitude"@en ;
    rdfs:comment "How strongly one filler acts on another, such as the grip force on the source or the torque about the grasp."@en .
:MaterialProperty a owl:NamedIndividual , :QuantityKind ; rdfs:label "material property"@en ;
    rdfs:comment "A property of the material of a filler or of its surface, such as the viscosity of the substance, the friction of the grasp or how the substance flows."@en .
:Ratio a owl:NamedIndividual , :QuantityKind ; rdfs:label "ratio"@en ;
    rdfs:comment "How large one quantity is against another, such as the grip force against the load force or the filled fraction of the goal."@en .
:Shape a owl:NamedIndividual , :QuantityKind ; rdfs:label "shape"@en ;
    rdfs:comment "What form a filler or its surface has, such as the geometry of the grasp surfaces."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Amount :Rate :Position :Orientation :Distance :Duration :Selection :Magnitude :MaterialProperty :Ratio :Shape ) ] .

:measuredIn a owl:ObjectProperty ;
    rdfs:domain :QuantityKind ;
    rdfs:range :PhysicalDimension ;
    rdfs:label "measured in"@en ;
    rdfs:comment "A physical dimension a kind of quantity may be measured in, such as an angle for an orientation; a kind measured in none, such as a selection or a shape, constrains none."@en .
:Amount :measuredIn :Mass , :Volume .
:Rate :measuredIn :MassFlowRate , :VolumetricFlowRate , :AngularRate , :ForceRate , :Frequency .
:Position :measuredIn :Length .
:Orientation :measuredIn :Angle .
:Distance :measuredIn :Length .
:Duration :measuredIn :Time .
:Magnitude :measuredIn :Force , :Torque .
:MaterialProperty :measuredIn :DynamicViscosity , :Dimensionless .
:Ratio :measuredIn :Dimensionless .

:PhysicalDimension a owl:Class ;
    rdfs:subClassOf aicor:dul_Region , dul:Region ;
    :isOpenValuePartition true ;
    rdfs:label "physical dimension"@en ;
    rdfs:comment "A dimensional space of physical quantities, which in DUL is a maximal region."@en .
:Mass a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "mass"@en ; rdfs:comment "Quantity of matter. Distinct from weight, which is a force."@en .
:MassFlowRate a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "mass flow rate"@en ; rdfs:comment "Mass transferred per unit time."@en .
:Force a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "force"@en ; rdfs:comment "Mechanical force, including weight force."@en .
:ForceRate a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "force rate"@en ; rdfs:comment "Rate of force change."@en .
:Torque a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "torque"@en ; rdfs:comment "Moment of force."@en .
:Length a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "length"@en ; rdfs:comment "Spatial distance or position component."@en .
:Angle a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "angle"@en ; rdfs:comment "Planar or rotational angle."@en .
:AngularRate a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "angular rate"@en ; rdfs:comment "Rate of angular change."@en .
:Volume a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "volume"@en ; rdfs:comment "Three-dimensional capacity."@en .
:VolumetricFlowRate a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "volumetric flow rate"@en ; rdfs:comment "Volume transferred per unit time."@en .
:DynamicViscosity a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "dynamic viscosity"@en ; rdfs:comment "Resistance of a fluid to shear flow."@en .
:Frequency a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "frequency"@en ; rdfs:comment "Repetitions of a periodic signal per unit time."@en .
:Time a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "time"@en ; rdfs:comment "Temporal duration or offset."@en .
:Dimensionless a owl:NamedIndividual , :PhysicalDimension ; rdfs:label "dimensionless"@en ; rdfs:comment "A ratio or fraction without a physical unit."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Mass :MassFlowRate :Force :ForceRate :Torque :Length :Angle :AngularRate :Volume :VolumetricFlowRate :DynamicViscosity :Frequency :Time :Dimensionless ) ] .

:MeasurementUnit a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :measuresDimension ; owl:someValuesFrom :PhysicalDimension ] ;
    :isOpenValuePartition true ;
    rdfs:label "measurement unit"@en ;
    rdfs:comment "A unit measuring exactly one physical dimension. Neither CRAM-AICOR nor DUL defines units."@en .
:measuresDimension a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:range :PhysicalDimension ;
    rdfs:label "measures dimension"@en ; rdfs:comment "The single physical dimension a unit measures."@en .
:Kilogram a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Mass ; rdfs:label "kilogram"@en ; rdfs:comment "Kilogram, a unit of mass."@en .
:Gram a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Mass ; rdfs:label "gram"@en ; rdfs:comment "Gram, a unit of mass."@en .
:KilogramPerSecond a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :MassFlowRate ; rdfs:label "kilogram per second"@en ; rdfs:comment "Kilogram per second, a unit of mass flow rate."@en .
:Newton a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Force ; rdfs:label "newton"@en ; rdfs:comment "Newton, a unit of force."@en .
:NewtonPerSecond a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :ForceRate ; rdfs:label "newton per second"@en ; rdfs:comment "Newton per second, a unit of force rate."@en .
:NewtonMetre a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Torque ; rdfs:label "newton metre"@en ; rdfs:comment "Newton metre, a unit of torque."@en .
:Metre a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Length ; rdfs:label "metre"@en ; rdfs:comment "Metre, a unit of length."@en .
:Centimetre a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Length ; rdfs:label "centimetre"@en ; rdfs:comment "Centimetre, a unit of length."@en .
:Millimetre a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Length ; rdfs:label "millimetre"@en ; rdfs:comment "Millimetre, a unit of length."@en .
:Degree a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Angle ; rdfs:label "degree"@en ; rdfs:comment "Degree, a unit of angle."@en .
:DegreePerSecond a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :AngularRate ; rdfs:label "degree per second"@en ; rdfs:comment "Degree per second, a unit of angular rate."@en .
:Litre a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Volume ; rdfs:label "litre"@en ; rdfs:comment "Litre, a unit of volume."@en .
:Millilitre a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Volume ; rdfs:label "millilitre"@en ; rdfs:comment "Millilitre, a unit of volume."@en .
:MillilitrePerSecond a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :VolumetricFlowRate ; rdfs:label "millilitre per second"@en ; rdfs:comment "Millilitre per second, a unit of volumetric flow rate."@en .
:Centipoise a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :DynamicViscosity ; rdfs:label "centipoise"@en ; rdfs:comment "Centipoise, a unit of dynamic viscosity."@en .
:Hertz a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Frequency ; rdfs:label "hertz"@en ; rdfs:comment "Hertz, a unit of frequency."@en .
:Second a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Time ; rdfs:label "second"@en ; rdfs:comment "Second, a unit of time."@en .
:Millisecond a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Time ; rdfs:label "millisecond"@en ; rdfs:comment "Millisecond, a unit of time."@en .
:Unitless a owl:NamedIndividual , :MeasurementUnit ; :measuresDimension :Dimensionless ; rdfs:label "unitless"@en ; rdfs:comment "The unit of a dimensionless ratio or bounded fraction."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Kilogram :Gram :KilogramPerSecond :Newton :NewtonPerSecond :NewtonMetre :Metre :Centimetre :Millimetre :Degree :DegreePerSecond :Litre :Millilitre :MillilitrePerSecond :Centipoise :Hertz :Second :Millisecond :Unitless ) ] .

:ConditionTiming a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    :isOpenValuePartition true ;
    rdfs:label "condition timing"@en ;
    rdfs:comment "When, relative to a phase or an action, a condition or a relation is demanded."@en .
:AtEntry a owl:NamedIndividual , :ConditionTiming ; rdfs:label "at entry"@en ;
    rdfs:comment "Must hold for the phase or the action to begin."@en .
:Throughout a owl:NamedIndividual , :ConditionTiming ; rdfs:label "throughout"@en ;
    rdfs:comment "Must hold at every instant of the phase or the action."@en .
:AtExit a owl:NamedIndividual , :ConditionTiming ; rdfs:label "at exit"@en ;
    rdfs:comment "Is brought about by completing the phase or the action."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :AtEntry :Throughout :AtExit ) ] .

:hasConditionTiming a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :ConditionTiming ;
    rdfs:label "has condition timing"@en ;
    rdfs:comment "When, relative to the phase or the action, the condition or the relation is demanded."@en .

:ConditionPolarity a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Holds :DoesNotHold ) ] ;
    rdfs:label "condition polarity"@en ;
    rdfs:comment "Whether a condition holds or does not hold. The property relating a condition to its polarity says whether that is demanded, such as a requirement of a phase or a frame, or observed, such as the condition a failure is noticed by."@en .
:Holds a owl:NamedIndividual , :ConditionPolarity ; rdfs:label "holds"@en ;
    rdfs:comment "The condition holds."@en .
:DoesNotHold a owl:NamedIndividual , :ConditionPolarity ; rdfs:label "does not hold"@en ;
    rdfs:comment "The condition does not hold."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Holds :DoesNotHold ) ] .

:ChangeDirection a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    :isOpenValuePartition true ;
    rdfs:label "change direction"@en ;
    rdfs:comment "The direction in which something changes: larger or smaller, such as a quantity an action changes, a choice a correction moves or an estimate evidence revises, or a direction of its own a module adds, such as moving a choice towards a target. A property taking a direction may be closed to the members it takes."@en .
:Increases a owl:NamedIndividual , :ChangeDirection ; rdfs:label "increases"@en ;
    rdfs:comment "Becomes larger."@en .
:Decreases a owl:NamedIndividual , :ChangeDirection ; rdfs:label "decreases"@en ;
    rdfs:comment "Becomes smaller, or grows more slowly."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Increases :Decreases ) ] .

