@prefix :      <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core#> .
@prefix aicor: <http://aicor.knowledge/l2-ontology.owl#> .
@prefix dul:   <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core> a owl:Ontology ;
    owl:versionIRI <http://www.ease-crc.org/ont/llm_reasoner/action-perspectives/action-core/0.6.0> ;
    owl:versionInfo "0.6.0" ;
    owl:imports <http://aicor.knowledge/l2-ontology.owl> , <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:label "Action perspectives: action core"@en ;
    rdfs:comment """The hub every perspective on an action attaches to: the frame of a kind of action, the slots its participants fill, what it is for, what it brings about and the kinds of choice it leaves open.

A perspective, such as the action frame, the image schemas or predictive control, describes the action in terms of the core's slots and parameter dimensions and never in terms of another perspective. The resolver grounds a slot in an individual of the world through a CRAM-AICOR role binding, and maps the slots and parameter dimensions to the fields of an action designator.

Each concept is linked to CRAM-AICOR and to DUL: frames are descriptions, slots are CRAM-AICOR role slots specialising its participant roles, an objective is a CRAM-AICOR telos, a consequence a CRAM-AICOR effect, and a parameter dimension a DUL parameter in CRAM-AICOR's action parameter space. Axioms are read under the open-world assumption."""@en .

# %% frames

:ActionFrame a owl:Class ;
    rdfs:subClassOf aicor:dul_Description , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom :ParticipantSlot ] ,
        [ a owl:Restriction ; owl:onProperty :statesObjective ; owl:someValuesFrom :Objective ] ;
    rdfs:label "action frame"@en ;
    rdfs:comment "The frame of a kind of action: the slots its participants fill, what it is for, what it brings about and the kinds of choice it leaves open. Every perspective on the action refers to the slots its frame defines."@en .

:ManipulationActionFrame a owl:Class ;
    rdfs:subClassOf :ActionFrame , aicor:ManipulationFrame ;
    rdfs:label "manipulation action frame"@en ;
    rdfs:comment "The frame of an action that manipulates objects, which CRAM-AICOR calls a manipulation frame; an action that manipulates nothing, such as moving the robot's base, has a frame that is not one."@en .

:PouringFrame a owl:Class ;
    rdfs:subClassOf :ManipulationActionFrame ,
        [ a owl:Restriction ; owl:onProperty :framesAction ; owl:hasValue aicor:Pouring ] ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom :AgentSlot ] ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom :SourceSlot ] ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom :SubstanceSlot ] ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom :GoalSlot ] ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :PartSlot [ a owl:Restriction ; owl:onProperty :isPartOfSlot ; owl:someValuesFrom :SourceSlot ] ) ] ] ,
        [ a owl:Restriction ; owl:onProperty :definesSlot ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :PartSlot [ a owl:Restriction ; owl:onProperty :isPartOfSlot ; owl:someValuesFrom :GoalSlot ] ) ] ] ,
        [ a owl:Restriction ; owl:onProperty :statesObjective ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :Objective [ a owl:Restriction ; owl:onProperty :aimsAtState ; owl:hasValue aicor:AccumulatedState ] ) ] ] ,
        [ a owl:Restriction ; owl:onProperty :bringsAbout ; owl:someValuesFrom :Consequence ] ,
        [ a owl:Restriction ; owl:onProperty :leavesOpen ; owl:someValuesFrom :ParameterDimension ] ,
        [ a owl:Restriction ; owl:onProperty :hasMaterialRegime ; owl:allValuesFrom :MaterialRegime ] ,
        [ a owl:Restriction ; owl:onProperty :hasTerminationReason ; owl:allValuesFrom :TransferTerminationReason ] ;
    rdfs:label "pouring frame"@en ;
    rdfs:comment "The frame of pouring, CRAM-AICOR's aicor:Pouring: an agent makes a substance leave a source over a part of it, such as its lip, and enter a goal through a part of it, such as its opening, so that the substance accumulates in the goal, as aicor:PouringIntention and its telos say. It names the agent, the source, the substance and the goal."@en .

# %% the situations a pour is performed in

:LiquidPouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasMaterialRegime ; owl:hasValue :Liquid ] ) ] ;
    rdfs:label "liquid pouring frame"@en ;
    rdfs:comment "The frame of pouring a liquid."@en .

:GranularPouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasMaterialRegime ; owl:hasValue :Granular ] ) ] ;
    rdfs:label "granular pouring frame"@en ;
    rdfs:comment "The frame of pouring a granular material."@en .

:CohesivePouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasMaterialRegime ; owl:hasValue :Cohesive ] ) ] ;
    rdfs:label "cohesive pouring frame"@en ;
    rdfs:comment "The frame of pouring a cohesive material."@en .

:TargetQuantityAttainedPouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasTerminationReason ; owl:hasValue :TargetQuantityAttained ] ) ] ;
    rdfs:label "target quantity attained pouring frame"@en ;
    rdfs:comment "The frame of a pour that ends once the wanted quantity is in the goal."@en .

:SourceExhaustedPouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasTerminationReason ; owl:hasValue :SourceExhausted ] ) ] ;
    rdfs:label "source exhausted pouring frame"@en ;
    rdfs:comment "The frame of a pour that ends once the source is empty."@en .

:InstructedStopPouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasTerminationReason ; owl:hasValue :InstructedStop ] ) ] ;
    rdfs:label "instructed stop pouring frame"@en ;
    rdfs:comment "The frame of a pour that ends on an instruction."@en .

:TransferFailurePouringFrame a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :PouringFrame [ a owl:Restriction ; owl:onProperty :hasTerminationReason ; owl:hasValue :TransferFailure ] ) ] ;
    rdfs:label "transfer failure pouring frame"@en ;
    rdfs:comment "The frame of a pour that ends because it fails."@en .

:hasMaterialRegime a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :MaterialRegime ;
    rdfs:label "has material regime"@en ;
    rdfs:comment "The flow behaviour of the transferred substance."@en .

:hasTerminationReason a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :TransferTerminationReason ;
    rdfs:label "has termination reason"@en ;
    rdfs:comment "The condition that ends the transfer."@en .

:framesAction a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :ActionFrame ;
    rdfs:label "frames action"@en ;
    rdfs:comment "The kind of action the frame describes, as the IRI of a CRAM-AICOR action category, such as aicor:Pouring."@en .

:definesSlot a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:defines ;
    rdfs:domain :ActionFrame ;
    rdfs:range :FrameSlot ;
    rdfs:label "defines slot"@en ;
    rdfs:comment "A slot of the frame, which a participant of the action, or a part of one, fills."@en .

:statesObjective a owl:ObjectProperty ;
    rdfs:domain :ActionFrame ;
    rdfs:range :Objective ;
    rdfs:label "states objective"@en ;
    rdfs:comment "What the action is for."@en .

:bringsAbout a owl:ObjectProperty ;
    rdfs:domain :ActionFrame ;
    rdfs:range :Consequence ;
    rdfs:label "brings about"@en ;
    rdfs:comment "A change the action makes to one of its participants."@en .

:leavesOpen a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:defines ;
    rdfs:domain :ActionFrame ;
    rdfs:range :ParameterDimension ;
    rdfs:label "leaves open"@en ;
    rdfs:comment "A kind of choice the frame does not settle, which whoever performs the action makes."@en .

# %% slots

:FrameSlot a owl:Class ;
    rdfs:subClassOf aicor:RoleSlot ;
    rdfs:label "frame slot"@en ;
    rdfs:comment "A place in a frame that something taking part in the action fills; a CRAM-AICOR role binding binds an individual of the world to it."@en .

:ParticipantSlot a owl:Class ;
    rdfs:subClassOf :FrameSlot ;
    rdfs:label "participant slot"@en ;
    rdfs:comment "A slot that a participant of the action fills as a whole, such as the source of a pour."@en .

:PartSlot a owl:Class ;
    rdfs:subClassOf :FrameSlot ,
        [ a owl:Restriction ; owl:onProperty :isPartOfSlot ; owl:someValuesFrom :ParticipantSlot ] ;
    rdfs:label "part slot"@en ;
    rdfs:comment "A slot that a part of a participant fills, which the action involves on its own, such as the lip of the source of a pour or the opening of its goal."@en .

[ a owl:AllDisjointClasses ; owl:members ( :ParticipantSlot :PartSlot ) ] .

:isPartOfSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :PartSlot ;
    rdfs:range :ParticipantSlot ;
    rdfs:label "is part of slot"@en ;
    rdfs:comment "The participant slot whose filler the part belongs to."@en .

:AgentSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:AgentRole ;
    rdfs:label "agent slot"@en ;
    rdfs:comment "The slot of the one who performs the action."@en .

:SourceSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:SourceRole ;
    rdfs:label "source slot"@en ;
    rdfs:comment "The slot of where something the action moves comes from, such as the container poured from."@en .

:SubstanceSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:SubstanceRole ;
    rdfs:label "substance slot"@en ;
    rdfs:comment "The slot of the material the action moves, as distinct from what holds it."@en .

:GoalSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:GoalRole ;
    rdfs:label "goal slot"@en ;
    rdfs:comment "The slot of where what the action moves ends up, such as the container poured into."@en .

:InstrumentSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:InstrumentRole ;
    rdfs:label "instrument slot"@en ;
    rdfs:comment "The slot of a tool the agent acts with on something else."@en .

:PatientSlot a owl:Class ;
    rdfs:subClassOf :ParticipantSlot , aicor:PatientRole ;
    rdfs:label "patient slot"@en ;
    rdfs:comment "The slot of what the action acts on and changes."@en .

# %% what the action is for and brings about

:Objective a owl:Class ;
    rdfs:subClassOf aicor:Telos ,
        [ a owl:Restriction ; owl:onProperty :concernsSlot ; owl:someValuesFrom :FrameSlot ] ;
    rdfs:label "objective"@en ;
    rdfs:comment "What an action is for: a state of its participants it aims at, which CRAM-AICOR calls a telos."@en .

:concernsSlot a owl:ObjectProperty ;
    rdfs:domain :Objective ;
    rdfs:range :FrameSlot ;
    rdfs:label "concerns slot"@en ;
    rdfs:comment "A slot whose filler the objective is about."@en .

:aimsAtState a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Objective ;
    rdfs:label "aims at state"@en ;
    rdfs:comment "The state the objective aims at, as the IRI of a CRAM-AICOR state type, such as aicor:AccumulatedState."@en .

:Consequence a owl:Class ;
    rdfs:subClassOf aicor:Effect , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :affectsSlot ; owl:someValuesFrom :FrameSlot ] ;
    rdfs:label "consequence"@en ;
    rdfs:comment "A change an action makes to one of its participants, intended or not, such as the source of a pour holding less, which CRAM-AICOR calls an effect."@en .

:affectsSlot a owl:ObjectProperty ;
    rdfs:domain :Consequence ;
    rdfs:range :FrameSlot ;
    rdfs:label "affects slot"@en ;
    rdfs:comment "A slot whose filler the consequence changes."@en .

:resultsInState a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Consequence ;
    rdfs:label "results in state"@en ;
    rdfs:comment "The state the filler is in afterwards, as the IRI of a CRAM-AICOR state type, such as aicor:ContainedState."@en .

# %% the choices an action leaves open

:SlotQuantity a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ,
        [ a owl:Restriction ; owl:onProperty :aboutSlot ; owl:someValuesFrom :FrameSlot ] ,
        [ a owl:Restriction ; owl:onProperty :hasQuantityKind ; owl:someValuesFrom :QuantityKind ] ;
    rdfs:label "slot quantity"@en ;
    rdfs:comment "A kind of quantity about the filler of a slot, possibly measured from the filler of another slot, such as the tilt of the source or the height of the lip above the goal; it carries no value. What it is for is said by its kind: a choice the action leaves open, a quantity deciding whether a relation holds, or one a failure is noticed by."@en .

:ParameterDimension a owl:Class ;
    rdfs:subClassOf :SlotQuantity , dul:Parameter , aicor:ActionParameterSpace ;
    rdfs:label "parameter dimension"@en ;
    rdfs:comment "A kind of choice an action leaves open, independent of any designator: how much, how fast, where relative to another participant, which way something faces, how far or how long, or which of several. A designator's field is one way of making the choice."@en .

:aboutSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :SlotQuantity ;
    rdfs:range :FrameSlot ;
    rdfs:label "about slot"@en ;
    rdfs:comment "The slot whose filler the quantity is about, such as the source whose orientation is chosen."@en .

:relativeToSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :SlotQuantity ;
    rdfs:range :FrameSlot ;
    rdfs:label "relative to slot"@en ;
    rdfs:comment "The slot whose filler the quantity is measured from, such as the goal a position above which is chosen, or the opening the lip ends beside; absent for a quantity measured from nothing in particular."@en .

:hasQuantityKind a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :QuantityKind ;
    rdfs:label "has quantity kind"@en ;
    rdfs:comment "What kind of quantity something about an action is about, such as the quantity a choice sets, a condition constrains or a change changes."@en .

# %% conditions on slots

:SlotCondition a owl:Class ;
    rdfs:subClassOf aicor:dul_Description , dul:Description ,
        [ a owl:Restriction ; owl:onProperty :conditionOnSlot ; owl:someValuesFrom :FrameSlot ] ,
        [ a owl:Restriction ; owl:onProperty :hasPolarity ; owl:someValuesFrom :ConditionPolarity ] ;
    rdfs:label "slot condition"@en ;
    rdfs:comment "A condition a world can check about the filler of a slot, possibly in relation to the filler of another slot, such as having a part, affording something or being in a state, rather than membership of a class. Whether it is required or observed is said by the property relating it to what uses it."@en .

:StateCondition a owl:Class ;
    rdfs:subClassOf :SlotCondition ,
        [ a owl:Restriction ; owl:onProperty :conditionHasState ; owl:someValuesFrom owl:Thing ] ;
    rdfs:label "state condition"@en ;
    rdfs:comment "A condition that the filler of a slot, possibly in relation to the filler of another slot, is in a given discrete state, such as the agent grasping the source or the substance being contained in the goal; with the polarity that it does not hold, that it is not in that state, such as the source being empty: the substance not contained in it."@en .

:conditionOnSlot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dul:usesConcept ;
    rdfs:domain :SlotCondition ;
    rdfs:range :FrameSlot ;
    rdfs:label "condition on slot"@en ;
    rdfs:comment "The slot whose filler the condition is about."@en .

:conditionInvolvesSlot a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:usesConcept ;
    rdfs:domain :SlotCondition ;
    rdfs:range :FrameSlot ;
    rdfs:label "condition involves slot"@en ;
    rdfs:comment "Another slot whose filler the condition relates the first filler to, such as the agent in the condition that the source is held, or the opening in the condition that the lip is over it."@en .

:conditionHasState a owl:ObjectProperty ;
    rdfs:domain :StateCondition ;
    rdfs:label "condition has state"@en ;
    rdfs:comment "The state the filler is in when the condition holds, as the IRI of a CRAM-AICOR state type, such as aicor:GraspedState or aicor:FlowingState."@en .

:hasPolarity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :SlotCondition ;
    rdfs:range :ConditionPolarity ;
    rdfs:label "has polarity"@en ;
    rdfs:comment "Whether the condition holds or does not hold."@en .

# %% value partitions

:QuantityKind a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Amount :Rate :Position :Orientation :Distance :Duration :Selection ) ] ;
    rdfs:label "quantity kind"@en ;
    rdfs:comment "The kind of quantity a choice an action leaves open sets."@en .
:Amount a owl:NamedIndividual , :QuantityKind ; rdfs:label "amount"@en ;
    rdfs:comment "How much of something, such as the volume poured."@en .
:Rate a owl:NamedIndividual , :QuantityKind ; rdfs:label "rate"@en ;
    rdfs:comment "How fast something changes, such as the flow or the tilting."@en .
:Position a owl:NamedIndividual , :QuantityKind ; rdfs:label "position"@en ;
    rdfs:comment "Where something is, such as where the lip is over the goal."@en .
:Orientation a owl:NamedIndividual , :QuantityKind ; rdfs:label "orientation"@en ;
    rdfs:comment "Which way something faces, such as how far the source is tilted."@en .
:Distance a owl:NamedIndividual , :QuantityKind ; rdfs:label "distance"@en ;
    rdfs:comment "How far apart two things are, such as the height of the lip above the goal."@en .
:Duration a owl:NamedIndividual , :QuantityKind ; rdfs:label "duration"@en ;
    rdfs:comment "How long something lasts."@en .
:Selection a owl:NamedIndividual , :QuantityKind ; rdfs:label "selection"@en ;
    rdfs:comment "Which of several alternatives is taken, such as the hand that holds the source."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Amount :Rate :Position :Orientation :Distance :Duration :Selection ) ] .

:ConditionPolarity a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Holds :DoesNotHold ) ] ;
    rdfs:label "condition polarity"@en ;
    rdfs:comment "Whether a condition holds or does not hold. The property relating a condition to its polarity says whether that is demanded, such as a requirement of a phase or a frame, or observed, such as the condition a failure is noticed by."@en .
:Holds a owl:NamedIndividual , :ConditionPolarity ; rdfs:label "holds"@en ;
    rdfs:comment "The condition holds."@en .
:DoesNotHold a owl:NamedIndividual , :ConditionPolarity ; rdfs:label "does not hold"@en ;
    rdfs:comment "The condition does not hold."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Holds :DoesNotHold ) ] .

:ChangeDirection a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Increases :Decreases ) ] ;
    rdfs:label "change direction"@en ;
    rdfs:comment "Whether something becomes larger or smaller, such as a quantity an action changes, a choice a correction moves or an estimate evidence revises. A direction that can also take values of its own lists these two among its members."@en .
:Increases a owl:NamedIndividual , :ChangeDirection ; rdfs:label "increases"@en ;
    rdfs:comment "Becomes larger."@en .
:Decreases a owl:NamedIndividual , :ChangeDirection ; rdfs:label "decreases"@en ;
    rdfs:comment "Becomes smaller, or grows more slowly."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Increases :Decreases ) ] .

:MaterialRegime a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Liquid :Granular :Cohesive ) ] ;
    rdfs:label "material regime"@en ;
    rdfs:comment "The physical flow behaviour of a transferred substance."@en .
:Liquid a owl:NamedIndividual , :MaterialRegime ; rdfs:label "liquid"@en ;
    rdfs:comment "A low-shear material that flows freely and may slosh."@en .
:Granular a owl:NamedIndividual , :MaterialRegime ; rdfs:label "granular"@en ;
    rdfs:comment "Discrete particles whose bulk flow is not characterised by viscosity."@en .
:Cohesive a owl:NamedIndividual , :MaterialRegime ; rdfs:label "cohesive"@en ;
    rdfs:comment "A highly viscous or cohesive material with delayed flow."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :Liquid :Granular :Cohesive ) ] .

:TransferTerminationReason a owl:Class ;
    rdfs:subClassOf aicor:dul_Concept , dul:Concept ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :TargetQuantityAttained :SourceExhausted :InstructedStop :TransferFailure ) ] ;
    rdfs:label "transfer termination reason"@en ;
    rdfs:comment "The condition that intentionally or exceptionally ends a transfer."@en .
:TargetQuantityAttained a owl:NamedIndividual , :TransferTerminationReason ; rdfs:label "target quantity attained"@en ;
    rdfs:comment "The requested transferred quantity has been reached."@en .
:SourceExhausted a owl:NamedIndividual , :TransferTerminationReason ; rdfs:label "source exhausted"@en ;
    rdfs:comment "No transferable material remains in the source."@en .
:InstructedStop a owl:NamedIndividual , :TransferTerminationReason ; rdfs:label "instructed stop"@en ;
    rdfs:comment "An external instruction requests that the transfer stop."@en .
:TransferFailure a owl:NamedIndividual , :TransferTerminationReason ; rdfs:label "transfer failure"@en ;
    rdfs:comment "A spill or another failure forces the transfer to stop."@en .
[ a owl:AllDifferent ; owl:distinctMembers ( :TargetQuantityAttained :SourceExhausted :InstructedStop :TransferFailure ) ] .
