@prefix :      <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics#> .
@prefix dyn:   <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/object-dynamics#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Structural rules of the object dynamics module that relate several fragments to one
# another, which OWL restrictions cannot state.

<http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> a owl:Ontology ;
    owl:versionInfo "0.2.0" ;
    rdfs:comment "Closed-world structural rules of the object dynamics module."@en ;
    sh:declare
        [ sh:prefix "core" ; sh:namespace "http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/core#"^^xsd:anyURI ] ,
        [ sh:prefix "dyn" ; sh:namespace "http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/object-dynamics#"^^xsd:anyURI ] ,
        [ sh:prefix "aicor" ; sh:namespace "http://aicor.knowledge/l2-ontology.owl#"^^xsd:anyURI ] ,
        [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

# %% internal models

:CompositionPredictsWithItsForwardModel a sh:NodeShape ;
    sh:targetClass dyn:InternalModelComposition ;
    rdfs:comment "Every sensory consequence a composition predicts is generated by its forward model."@en ;
    sh:sparql [
        sh:message "predicts a sensory consequence another forward model generates" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this dyn:usesForwardModel ?model ;
                    dyn:predictsSensoryConsequence ?value .
                FILTER NOT EXISTS { ?value aicor:generatedBy ?model }
            }
        """ ;
    ] .

:CompositionDynamicsUsesItsCopy a sh:NodeShape ;
    sh:targetClass dyn:InternalModelComposition ;
    rdfs:comment "The dynamics model of a composition uses every efference copy of the composition."@en ;
    sh:sparql [
        sh:message "uses_dynamics_model does not use the composition's efference copy" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this dyn:usesDynamicsModel ?model ;
                    dyn:usesEfferenceCopy ?value .
                FILTER NOT EXISTS { ?model dyn:usesEfferenceCopy ?value }
            }
        """ ;
    ] .

# %% estimates

:EstimateHeldByARepresentation a sh:NodeShape ;
    sh:targetClass dyn:ObjectDynamicsPhaseStructure ;
    rdfs:comment "Every estimate a structure declares as a parameter is held by one of the structure's estimate representations, which supplies its coordinate frame and purpose."@en ;
    sh:sparql [
        sh:message "a declared estimate is held by none of the structure's representations" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this core:definesParameter ?value .
                ?value rdf:type/rdfs:subClassOf* core:Estimate .
                FILTER NOT EXISTS {
                    $this core:definesInternalModel ?representation .
                    ?representation rdf:type/rdfs:subClassOf* core:EstimateRepresentation ;
                        core:holdsEstimate ?value .
                }
            }
        """ ;
    ] .

:EstimateServesOnePurpose a sh:NodeShape ;
    sh:targetClass dyn:ObjectDynamicsPhaseStructure ;
    rdfs:comment "No estimate is held both for sensorimotor control and for perceptual judgment. A perceptual judgment must not silently become the estimate used for motor scaling: one estimate is not held for both purposes."@en ;
    sh:sparql [
        sh:message "one estimate is held for sensorimotor control and perceptual judgment" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this core:definesInternalModel ?control , ?judgment .
                ?control rdf:type/rdfs:subClassOf* dyn:ContextualRepresentation ;
                    dyn:hasPurpose dyn:SensorimotorControl ;
                    core:holdsEstimate ?value .
                ?judgment rdf:type/rdfs:subClassOf* dyn:ContextualRepresentation ;
                    dyn:hasPurpose dyn:PerceptualJudgment ;
                    core:holdsEstimate ?value .
            }
        """ ;
    ] .

:DissociationCoherent a sh:NodeShape ;
    sh:targetClass dyn:RepresentationDissociation ;
    rdfs:comment "A dissociation's estimates are distinct and held by their own representations."@en ;
    sh:sparql [
        sh:message "the estimates are the same, or one is not held by its representation" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    $this dyn:sensorimotorEstimate ?estimate ;
                        dyn:perceptualEstimate ?estimate .
                } UNION {
                    $this dyn:hasSensorimotorRepresentation ?representation ;
                        dyn:sensorimotorEstimate ?estimate .
                    FILTER NOT EXISTS { ?representation core:holdsEstimate ?estimate }
                } UNION {
                    $this dyn:hasPerceptualRepresentation ?representation ;
                        dyn:perceptualEstimate ?estimate .
                    FILTER NOT EXISTS { ?representation core:holdsEstimate ?estimate }
                }
            }
        """ ;
    ] .

:RepresentationCoversEstimatedRoles a sh:NodeShape ;
    sh:targetClass dyn:ContextualRepresentation ;
    rdfs:comment "A representation represents every participant its estimates concern."@en ;
    sh:sparql [
        sh:message "an estimate concerns a participant represents_role omits" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this core:holdsEstimate/core:parameterOnRole ?value .
                FILTER NOT EXISTS { $this dyn:representsRole ?value }
            }
        """ ;
    ] .

# %% memory and transfer

:RetainedUpdateInItsMemory a sh:NodeShape ;
    sh:targetClass dyn:RetainedModelUpdate ;
    rdfs:comment "A retained update changes a representation its memory stores."@en ;
    sh:sparql [
        sh:message "updates_representation is not stored in persists_in" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT $this WHERE {
                $this core:updatesRepresentation ?representation ;
                    dyn:persistsIn ?memory .
                FILTER NOT EXISTS { ?memory dyn:storesRepresentation ?representation }
            }
        """ ;
    ] .

:TransferComparesMatchedPerturbations a sh:NodeShape ;
    sh:targetClass dyn:DynamicsTransfer ;
    rdfs:comment "A transfer compares two distinct perturbations of one kind matched with each other."@en ;
    sh:sparql [
        sh:message "the perturbations are the same, of different kinds, or not matched" ;
        sh:prefixes <http://www.ease-crc.org/ont/llm_reasoner/predictive-manipulation/shapes/object-dynamics> ;
        sh:select """
            SELECT $this WHERE {
                $this dyn:fromPerturbation ?source ;
                    dyn:toPerturbation ?target .
                OPTIONAL { ?source dyn:hasPerturbationKind ?sourceKind }
                OPTIONAL { ?target dyn:hasPerturbationKind ?targetKind }
                FILTER (
                    ?source = ?target
                    || BOUND(?sourceKind) != BOUND(?targetKind)
                    || (BOUND(?sourceKind) && ?sourceKind != ?targetKind)
                    || NOT EXISTS { ?source dyn:matchedWith ?target }
                )
            }
        """ ;
    ] .
