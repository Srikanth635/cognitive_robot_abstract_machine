{
  "name": "evaluate_predicate",
  "description": {
    "purpose": "Evaluate a predicate or value function as the world model computes it.",
    "returns": "What it says about the arguments.",
    "use_when": "Checking a relation or computing a value the fields do not hold; pass each argument by name, an individual as {\"handle\": ...} and a plain value as {\"value\": ...}."
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "predicate": {
        "type": "string",
        "description": "The predicate's identifier, or its plain name when nothing else shares it."
      },
      "arguments": {
        "type": "object",
        "description": "The arguments by name.",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "handle": {
                  "type": "string"
                }
              },
              "required": [
                "handle"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {}
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "predicate",
      "arguments"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$ref": "#/$defs/FieldValue"
  }
}
