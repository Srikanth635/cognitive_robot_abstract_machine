@prefix : <urn:datatype:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:Entity a owl:Class .
:foreign a rdfs:Datatype .
:value a owl:DatatypeProperty ; rdfs:domain :Entity ; rdfs:range :foreign .
:one a owl:NamedIndividual, :Entity ; :value "value"^^:foreign .
