@prefix : <urn:construction:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:Entity a owl:Class .
:Special a owl:Class ; rdfs:subClassOf :Entity .
:connected a owl:ObjectProperty, owl:SymmetricProperty, owl:ReflexiveProperty ;
 rdfs:domain :Entity ; rdfs:range :Entity .
:values a owl:DatatypeProperty ; rdfs:domain :Entity .
:amount a owl:DatatypeProperty ; rdfs:domain :Entity ; rdfs:range xsd:decimal .
:one a :Entity .
:two a :Entity .
